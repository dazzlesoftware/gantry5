{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <div class="g-teamcarousel {{ particle.class|e }}" style="--gtc-border-width:{{ particle.borderwidth|default(1)|e('html_attr') }}px;--gtc-border-color:{{ particle.bordercolor|default('#dddddd')|e('html_attr') }};--gtc-border-radius:{{ particle.borderradius|default(0)|e('html_attr') }}px;">
        {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
        <div id="g-teamcarousel-{{ id }}" class="g-teamcarousel-shell g-teamcarousel-{{ particle.layout|default('layout1')|e }} text-{{ particle.alignment|default('center')|e }}{% if particle.carouselborder|default('hide') == 'show' %} has-carousel-border{% endif %}"
            style="--gtc-gap:{{ particle.gap|default(20)|e('html_attr') }}px;--gtc-image-height:{{ particle.imageheight|default(360)|e('html_attr') }}px;--gtc-content-padding:{{ particle.contentpadding|default(24)|e('html_attr') }}px;--gtc-content-bg:{{ particle.contentbackground|default('#ffffff')|e('html_attr') }};--gtc-overlay:{{ particle.overlaycolor|default('rgba(0,0,0,0.65)')|e('html_attr') }};--gtc-name:{{ particle.namecolor|default('#222222')|e('html_attr') }};--gtc-designation:{{ particle.designationcolor|default('#777777')|e('html_attr') }};--gtc-name-size:{{ particle.namesize|default(22)|e('html_attr') }}px;--gtc-designation-size:{{ particle.designationsize|default(15)|e('html_attr') }}px;--gtc-social-size:{{ particle.socialsize|default(16)|e('html_attr') }}px;--gtc-social-color:{{ particle.socialcolor|default('#555555')|e('html_attr') }};--gtc-social-hover:{{ particle.socialhovercolor|default('#3366ff')|e('html_attr') }};--gtc-social-width:{{ particle.socialwidth|default(34)|e('html_attr') }}px;--gtc-social-height:{{ particle.socialheight|default(34)|e('html_attr') }}px;--gtc-social-border-width:{{ particle.socialborderwidth|default(0)|e('html_attr') }}px;--gtc-social-border:{{ particle.socialbordercolor|default('#dddddd')|e('html_attr') }};--gtc-social-radius:{{ particle.socialradius|default(50)|e('html_attr') }}%;--gtc-arrow-color:{{ particle.arrowcolor|default('#333333')|e('html_attr') }};--gtc-arrow-bg:{{ particle.arrowbackground|default('#ffffff')|e('html_attr') }};--gtc-arrow-size:{{ particle.arrowsize|default(22)|e('html_attr') }}px;--gtc-arrow-box:{{ particle.arrowboxsize|default(44)|e('html_attr') }}px;--gtc-arrow-radius:{{ particle.arrowradius|default(0)|e('html_attr') }}px;--gtc-bullet:{{ particle.bulletcolor|default('#cccccc')|e('html_attr') }};--gtc-bullet-active:{{ particle.bulletactivecolor|default('#3366ff')|e('html_attr') }};--gtc-bullet-size:{{ particle.bulletsize|default(10)|e('html_attr') }}px"
            data-team-carousel data-desktop-items="{{ particle.desktopitems|default(3)|e }}" data-tablet-items="{{ particle.tabletitems|default(2)|e }}" data-mobile-items="{{ particle.mobileitems|default(1)|e }}" data-autoplay="{{ particle.autoplay|default('disable')|e }}" data-pause-hover="{{ particle.pausehover|default('enable')|e }}" data-loop="{{ particle.loop|default('enable')|e }}" data-randomize="{{ particle.randomize|default('disable')|e }}" data-interval="{{ particle.interval|default(4500)|e }}" data-speed="{{ particle.speed|default(500)|e }}" data-touch="{{ particle.touch|default('enable')|e }}" data-name-font="{{ particle.namefont|default('')|e('html_attr') }}" data-designation-font="{{ particle.designationfont|default('')|e('html_attr') }}">
            <div class="g-teamcarousel-viewport"><div class="g-teamcarousel-track">
                {% for member in particle.members|default([]) %}{% if not member.disable %}
                    <div class="g-teamcarousel-item">
                        <div class="g-teamcarousel-card">
                            <div class="g-teamcarousel-image">{% if member.link %}<a href="{{ member.link|e }}" target="{{ member.target|default('_self')|e }}"{% if member.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{% endif %}{% if member.image %}<img src="{{ url(member.image)|e }}" alt="{{ member.imagealt|default(member.name)|e }}" loading="lazy">{% endif %}{% if member.link %}</a>{% endif %}</div>
                            <div class="g-teamcarousel-content"><div class="g-teamcarousel-overlay"></div><div class="g-teamcarousel-content-inner">
                                {% if member.name %}<h3 class="g-teamcarousel-name">{% if member.link %}<a href="{{ member.link|e }}" target="{{ member.target|default('_self')|e }}"{% if member.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{% endif %}{{ member.name|raw }}{% if member.link %}</a>{% endif %}</h3>{% endif %}
                                {% if member.designation %}<div class="g-teamcarousel-designation">{{ member.designation|raw }}</div>{% endif %}
                                {% if member.socials %}<ul class="g-teamcarousel-socials">{% for social in member.socials %}<li><a href="{{ social.link|default('#')|e }}" target="{{ social.target|default('_blank')|e }}"{% if social.target|default('_blank') == '_blank' %} rel="noopener noreferrer"{% endif %} aria-label="{{ social.title|default('Social profile')|e }}">{% if social.icon %}<i class="{{ social.icon|e }}" aria-hidden="true"></i>{% else %}{{ social.title|e }}{% endif %}</a></li>{% endfor %}</ul>{% endif %}
                            </div></div>
                        </div>
                    </div>
                {% endif %}{% endfor %}
            </div></div>
            {% if particle.arrows|default('enable') == 'enable' %}<div class="g-teamcarousel-controls"><button type="button" data-team-prev aria-label="Previous team members">{% if particle.arrowstyle|default('angle') == 'long' %}&larr;{% else %}&lsaquo;{% endif %}</button><button type="button" data-team-next aria-label="Next team members">{% if particle.arrowstyle|default('angle') == 'long' %}&rarr;{% else %}&rsaquo;{% endif %}</button></div>{% endif %}
            {% if particle.bullets|default('enable') == 'enable' %}<div class="g-teamcarousel-bullets" data-team-bullets></div>{% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/teamcarousel.js'), 11, 'footer') %}{% endblock %}
