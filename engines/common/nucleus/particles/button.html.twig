{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
  {% do genesis.load('bootstrap.5') %}
  {% set variant=particle.style|default('primary')=='custom'?'g-button-custom':(particle.style=='link'?'btn-link':(particle.appearance|default('flat')=='outline'?'btn-outline-'~particle.style:'btn-'~particle.style)) %}
  <div class="g-button-wrap text-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}" data-button-font="{{ particle.font|default('')|e('html_attr') }}" style="--gbtn-size:{{ particle.fontsize|default(16)|e('html_attr') }}px;--gbtn-weight:{{ particle.weight|default('400')|e('html_attr') }};--gbtn-padding:{{ particle.padding|default('8px 22px')|e('html_attr') }};--gbtn-gap:{{ particle.icongap|default(8)|e('html_attr') }}px;--gbtn-color:{{ particle.color|default('#ffffff')|e('html_attr') }};--gbtn-bg:{{ particle.background|default('#3366ff')|e('html_attr') }};--gbtn-border:{{ particle.bordercolor|default('#3366ff')|e('html_attr') }};--gbtn-hover-color:{{ particle.hovercolor|default('#ffffff')|e('html_attr') }};--gbtn-hover-bg:{{ particle.hoverbackground|default('#0037dd')|e('html_attr') }};--gbtn-hover-border:{{ particle.hoverbordercolor|default('#0037dd')|e('html_attr') }};">
    <a href="{{ particle.link|default('#')|e }}" target="{{ particle.target|default('_self')|e }}" class="g-button btn {{ variant|e }}{% if particle.size in ['sm','lg'] %} btn-{{ particle.size|e }}{% endif %}{% if particle.size=='custom' %} is-custom-size{% endif %}{% if particle.shape=='square' %} rounded-0{% elseif particle.shape=='pill' %} rounded-pill{% endif %}{% if particle.fullwidth=='enable' %} w-100{% endif %}"{% if particle.target=='_blank' or particle.nofollow %} rel="{% if particle.target=='_blank' %}noopener noreferrer{% endif %}{% if particle.nofollow %} nofollow{% endif %}"{% endif %}{% if particle.download=='enable' %} download="{{ particle.filename|e }}"{% endif %} aria-label="{{ particle.arialabel|default(particle.text)|e }}">
      {% if particle.icon and particle.iconposition|default('left')=='left' %}
        <i class="{{ particle.icon|e }}" aria-hidden="true">
        </i>
      {% endif %}
      <span>
        {{ particle.text|raw }}
      </span>
      {% if particle.icon and particle.iconposition=='right' %}
        <i class="{{ particle.icon|e }}" aria-hidden="true">
        </i>
      {% endif %}
    </a>
  </div>
{% endblock %}
{% block javascript_footer %}
  {% do genesis.document.addScript(url('genesis-assets://js/button.js'),11,'footer') %}
{% endblock %}
