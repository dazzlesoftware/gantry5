{% extends '@nucleus/partials/particle.html.twig' %}

{% set mediaLinked = particle.link and particle.linkarea|default('title') in ['media', 'both'] %}
{% set titleLinked = particle.link and particle.linkarea|default('title') in ['title', 'both'] %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <div id="g-feature-{{ id }}" class="g-feature g-feature-{{ particle.position|default('top')|e }} text-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}{% if particle.imagezoom|default('disable') == 'enable' %} has-image-zoom{% endif %}{% if particle.boxborder|default('hide') == 'show' %} has-box-border{% endif %}"
        style="--gf-icon-size:{{ particle.iconsize|default(36)|e('html_attr') }}px;--gf-icon-color:{{ particle.iconcolor|default('#3366ff')|e('html_attr') }};--gf-icon-hover-color:{{ particle.iconhovercolor|default(particle.iconcolor|default('#3366ff'))|e('html_attr') }};--gf-icon-bg:{{ particle.iconbackground|default('transparent')|e('html_attr') }};--gf-icon-hover-bg:{{ particle.iconhoverbackground|default(particle.iconbackground|default('transparent'))|e('html_attr') }};--gf-icon-padding:{{ particle.iconpadding|default(0)|e('html_attr') }}px;--gf-icon-border-width:{{ particle.iconborderwidth|default(0)|e('html_attr') }}px;--gf-icon-border:{{ particle.iconbordercolor|default('transparent')|e('html_attr') }};--gf-icon-radius:{{ particle.iconradius|default(0)|e('html_attr') }}px;--gf-media-gap:{{ particle.mediagap|default(20)|e('html_attr') }}px;--gf-image-radius:{{ particle.imageradius|default(0)|e('html_attr') }}px;--gf-zoom:{{ particle.zoomscale|default(1.2)|e('html_attr') }};--gf-bg:{{ particle.background|default('transparent')|e('html_attr') }};--gf-hover-bg:{{ particle.hoverbackground|default(particle.background|default('transparent'))|e('html_attr') }};--gf-border-width:{{ particle.borderwidth|default(1)|e('html_attr') }}px;--gf-border-color:{{ particle.bordercolor|default('#dddddd')|e('html_attr') }};--gf-box-radius:{{ particle.boxradius|default(0)|e('html_attr') }}px;--gf-box-shadow:{{ particle.boxshadow|default('none')|e('html_attr') }};--gf-title:{{ particle.titlecolor|default('inherit')|e('html_attr') }};--gf-title-hover:{{ particle.titlehovercolor|default(particle.titlecolor|default('inherit'))|e('html_attr') }};--gf-text:{{ particle.textcolor|default('inherit')|e('html_attr') }};--gf-text-hover:{{ particle.texthovercolor|default(particle.textcolor|default('inherit'))|e('html_attr') }};--gf-title-margin:{{ particle.titlemargin|default(12)|e('html_attr') }}px;--gf-button-gap:{{ particle.buttongap|default(10)|e('html_attr') }}px;--gf-button-margin:{{ particle.buttonmargin|default(25)|e('html_attr') }}px;{% if particle.padding %}--gf-padding:{{ particle.padding|e('html_attr') }};{% endif %}{% if particle.titlefontsize %}--gf-title-size:{{ particle.titlefontsize|e('html_attr') }}px;{% endif %}{% if particle.textfontsize %}--gf-text-size:{{ particle.textfontsize|e('html_attr') }}px;{% endif %}"
        data-feature data-title-font="{{ particle.titlefont|default('')|e('html_attr') }}" data-text-font="{{ particle.textfont|default('')|e('html_attr') }}" data-button1-present="{{ particle.button1 ? '1' : '0' }}" data-button1-font="{{ particle.button1font|default('')|e('html_attr') }}" data-button1-size="{{ particle.button1fontsize|default('')|e('html_attr') }}" data-button1-weight="{{ particle.button1fontweight|default('inherit')|e('html_attr') }}" data-button2-present="{{ particle.button2 ? '1' : '0' }}" data-button2-font="{{ particle.button2font|default('')|e('html_attr') }}" data-button2-size="{{ particle.button2fontsize|default('')|e('html_attr') }}" data-button2-weight="{{ particle.button2fontweight|default('inherit')|e('html_attr') }}">
        {% if particle.mediatype|default('icon') != 'none' %}
            <div class="g-feature-media g-feature-media-align-{{ particle.mediaalignment|default('inherit')|e }}">
                {% if mediaLinked %}<a href="{{ particle.link|e }}" target="{{ particle.linktarget|default('_self')|e }}"{% if particle.linktarget == '_blank' %} rel="noopener noreferrer"{% endif %}>{% endif %}
                {% if particle.mediatype in ['image', 'both'] and particle.image %}<span class="g-feature-image"><img src="{{ url(particle.image)|e }}" alt="{{ particle.imagealt|default(particle.title)|e }}"{% if particle.imagewidth %} width="{{ particle.imagewidth|e }}"{% endif %} loading="lazy"></span>{% endif %}
                {% if particle.mediatype|default('icon') in ['icon', 'both'] and particle.icon %}<span class="g-feature-icon" role="img" aria-label="{{ particle.title|striptags|e }}"><i class="{{ particle.icon|e }}" aria-hidden="true"></i></span>{% endif %}
                {% if mediaLinked %}</a>{% endif %}
            </div>
        {% endif %}
        <div class="g-feature-content">
            {% if particle.title %}<{{ particle.heading|default('h3') }} class="g-feature-title g-feature-align-{{ particle.titlealignment|default('inherit')|e }}">{% if titleLinked %}<a href="{{ particle.link|e }}" target="{{ particle.linktarget|default('_self')|e }}"{% if particle.linktarget == '_blank' %} rel="noopener noreferrer"{% endif %}>{% endif %}{{ particle.title|raw }}{% if titleLinked %}</a>{% endif %}</{{ particle.heading|default('h3') }}>{% endif %}
            {% if particle.text %}<div class="g-feature-text g-feature-align-{{ particle.textalignment|default('inherit')|e }}">{{ particle.text|raw }}</div>{% endif %}
            {% if particle.button1 or particle.button2 %}<div class="g-feature-buttons g-feature-buttons-align-{{ particle.buttonalignment|default('inherit')|e }}">
                {% if particle.button1 %}<a class="btn btn-{{ particle.button1style|default('primary')|e }} g-feature-button-{{ particle.button1shape|default('rounded')|e }}{% if particle.button1appearance|default('flat') == 'outline' %} g-feature-button-outline{% endif %}{% if particle.button1fullwidth|default('disable') == 'enable' %} g-feature-button-full{% endif %}{% if particle.button1size != 'normal' %} btn-{{ particle.button1size|e }}{% endif %}"{% if particle.button1style == 'custom' %} style="--gf-btn-color:{{ particle.button1color|default('#ffffff')|e('html_attr') }};--gf-btn-bg:{{ particle.button1background|default('#e91e63')|e('html_attr') }};--gf-btn-border:{{ particle.button1border|default('#e91e63')|e('html_attr') }};--gf-btn-hover-color:{{ particle.button1hovercolor|default('#ffffff')|e('html_attr') }};--gf-btn-hover-bg:{{ particle.button1hoverbackground|default('#c2185b')|e('html_attr') }};--gf-btn-hover-border:{{ particle.button1hoverborder|default('#c2185b')|e('html_attr') }}"{% endif %} href="{{ particle.button1link|default('#')|e }}" target="{{ particle.button1target|default('_self')|e }}"{% if particle.button1target == '_blank' %} rel="noopener noreferrer"{% endif %}>{% if particle.button1icon and particle.button1iconposition|default('left') == 'left' %}<i class="{{ particle.button1icon|e }}" aria-hidden="true"></i>{% endif %}<span>{{ particle.button1|e }}</span>{% if particle.button1icon and particle.button1iconposition == 'right' %}<i class="{{ particle.button1icon|e }}" aria-hidden="true"></i>{% endif %}</a>{% endif %}
                {% if particle.button2 %}<a class="btn btn-{{ particle.button2style|default('outline-primary')|e }} g-feature-button-{{ particle.button2shape|default('rounded')|e }}{% if particle.button2appearance|default('outline') == 'outline' %} g-feature-button-outline{% endif %}{% if particle.button2fullwidth|default('disable') == 'enable' %} g-feature-button-full{% endif %}{% if particle.button2size != 'normal' %} btn-{{ particle.button2size|e }}{% endif %}"{% if particle.button2style == 'custom' %} style="--gf-btn-color:{{ particle.button2color|default('#e91e63')|e('html_attr') }};--gf-btn-bg:{{ particle.button2background|default('#ffffff')|e('html_attr') }};--gf-btn-border:{{ particle.button2border|default('#e91e63')|e('html_attr') }};--gf-btn-hover-color:{{ particle.button2hovercolor|default('#ffffff')|e('html_attr') }};--gf-btn-hover-bg:{{ particle.button2hoverbackground|default('#e91e63')|e('html_attr') }};--gf-btn-hover-border:{{ particle.button2hoverborder|default('#e91e63')|e('html_attr') }}"{% endif %} href="{{ particle.button2link|default('#')|e }}" target="{{ particle.button2target|default('_self')|e }}"{% if particle.button2target == '_blank' %} rel="noopener noreferrer"{% endif %}>{% if particle.button2icon and particle.button2iconposition|default('left') == 'left' %}<i class="{{ particle.button2icon|e }}" aria-hidden="true"></i>{% endif %}<span>{{ particle.button2|e }}</span>{% if particle.button2icon and particle.button2iconposition == 'right' %}<i class="{{ particle.button2icon|e }}" aria-hidden="true"></i>{% endif %}</a>{% endif %}
            </div>{% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/feature.js'), 11, 'footer') %}{% endblock %}
