{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
{% do genesis.load('bootstrap.5') %}
<div class="g-divider-wrap g-divider-align-{{ particle.alignment|default('center')|e }} {{ particle.class|e }}" style="--gdivider-width:{{ particle.width|default(100)|e('html_attr') }}{% if particle.widthunit|default('percent') == 'pixel' %}px{% else %}%{% endif %};--gdivider-tablet-width:{{ particle.tabletwidth|default(100)|e('html_attr') }}{% if particle.widthunit|default('percent') == 'pixel' %}px{% else %}%{% endif %};--gdivider-mobile-width:{{ particle.mobilewidth|default(100)|e('html_attr') }}{% if particle.widthunit|default('percent') == 'pixel' %}px{% else %}%{% endif %};--gdivider-height:{{ particle.height|default(10)|e('html_attr') }}px;--gdivider-tablet-height:{{ particle.tabletheight|default(10)|e('html_attr') }}px;--gdivider-mobile-height:{{ particle.mobileheight|default(10)|e('html_attr') }}px;--gdivider-vertical-height:{{ particle.verticalheight|default(100)|e('html_attr') }}px;--gdivider-border-width:{{ particle.borderwidth|default(1)|e('html_attr') }}px;--gdivider-border-style:{{ particle.borderstyle|default('solid')|e('html_attr') }};--gdivider-border-color:{{ particle.bordercolor|default('#cccccc')|e('html_attr') }};--gdivider-radius:{{ particle.borderradius|default(0)|e('html_attr') }}px;--gdivider-margin-top:{{ particle.margintop|default(30)|e('html_attr') }}px;--gdivider-margin-bottom:{{ particle.marginbottom|default(30)|e('html_attr') }}px;{% if particle.image %}--gdivider-image:url('{{ url(particle.image)|e('html_attr') }}');{% endif %}--gdivider-repeat:{{ particle.repeat|default('no-repeat')|e('html_attr') }};--gdivider-image-size:{{ particle.imagesize|default('auto')|e('html_attr') }};">
    <div class="g-divider g-divider-{{ particle.type|default('border')|e }} g-divider-{{ particle.orientation|default('horizontal')|e }}" role="separator"{% if particle.orientation|default('horizontal') == 'vertical' %} aria-orientation="vertical"{% endif %}></div>
</div>
{% endblock %}
