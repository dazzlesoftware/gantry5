{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
  {% do genesis.load('bootstrap.5') %}
  <div class="g-pie-progress text-{{ particle.alignment|default('center')|e }} {{ particle.class|e }}" data-pie-progress data-value="{{ particle.percentage|default(75)|e }}" data-duration="{{ particle.duration|default(1800)|e }}" style="--gpie-size:{{ particle.size|default(180)|e('html_attr') }}px;--gpie-stroke:{{ particle.borderwidth|default(10)|e('html_attr') }};--gpie-track:{{ particle.trackcolor|default('#e5e5e5')|e('html_attr') }};--gpie-active:{{ particle.activecolor|default('#3366ff')|e('html_attr') }};--gpie-value-color:{{ particle.percentagecolor|default('#222222')|e('html_attr') }};--gpie-value-size:{{ particle.percentagesize|default(32)|e('html_attr') }}px;--gpie-icon-size:{{ particle.iconsize|default(28)|e('html_attr') }}px;">
    {% if particle.title %}
      <h3 class="g-title">
        {{ particle.title|raw }}
      </h3>
    {% endif %}
    <div class="g-pie-circle">
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle class="g-pie-track" cx="60" cy="60" r="52">
        </circle>
        <circle class="g-pie-active" cx="60" cy="60" r="52">
        </circle>
      </svg>
      <div class="g-pie-center">
        {% if particle.icon %}
          <i class="{{ particle.icon|e }}">
          </i>
        {% endif %}
        <span data-pie-value>
          0%
        </span>
      </div>
    </div>
    {% if particle.text %}
      <div class="g-pie-text">
        {{ particle.text|raw }}
      </div>
    {% endif %}
  </div>
{% endblock %}
{% block javascript_footer %}
  {% do genesis.document.addScript(url('genesis-assets://js/genesis-pieprogress.js'),11,'footer') %}
{% endblock %}
