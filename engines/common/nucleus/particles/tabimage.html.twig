{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
	{% do genesis.load('bootstrap.5') %}

	{% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

	<div id="g-tabimage-{{ id }}" class="g-tabimage {{ particle.class|e }}">
		<ul class="nav nav-tabs g-tabimage-nav" id="g-tabimage-nav-{{ id }}" role="tablist">
			{% for tabimage in particle.tabimages|default([]) %}
				<li class="nav-item" role="presentation">
					<button
						id="g-tabimage-tab-{{ id }}-{{ loop.index }}"
						class="nav-link{% if loop.first %} active{% endif %}"
						type="button"
						role="tab"
						data-bs-toggle="tab"
						data-bs-target="#g-tabimage-panel-{{ id }}-{{ loop.index }}"
						aria-controls="g-tabimage-panel-{{ id }}-{{ loop.index }}"
						aria-selected="{{ loop.first ? 'true' : 'false' }}"
					>{{ tabimage.title|default('Tab ' ~ loop.index)|e }}</button>
				</li>
			{% endfor %}
		</ul>

		<div class="tab-content g-tabimage-panels">
			{% for tabimage in particle.tabimages|default([]) %}
				<div
					id="g-tabimage-panel-{{ id }}-{{ loop.index }}"
					class="tab-pane fade{% if loop.first %} show active{% endif %} g-content"
					role="tabpanel"
					aria-labelledby="g-tabimage-tab-{{ id }}-{{ loop.index }}"
					tabindex="0"
				>

					{% if tabimage.image %}
					<div class="g-tab-image">
						<img src="{{ url(tabimage.image)|e }}" alt="{{ tabimage.title|e }}" />
						{% if tabimage.link %}
						<div class="g-tab-image-overlay">
							<a class="readon" href="{{ tabimage.link|e }}">{{ tabimage.label|e }}</a>
						</div>
						{% endif %}
					</div>
					{% endif %}

					{% if tabimage.text %}
					<div class="g-title-regular">{{ tabimage.text|raw }}</div>
					{% endif %}

					{% if tabimage.tag %}
						{% if tabimage.link %}
						<a href="{{ tabimage.link|e }}">
						{% endif %}
							<span class="g-tag">{{ tabimage.tag|e }}</span>
						{% if tabimage.link %}
						</a>
						{% endif %}
					{% endif %}

					{% if tabimage.subtag %}
					<span class="g-small">{{ tabimage.subtag|e }}</span>
					{% endif %}

				</div>
			{% endfor %}
		</div>
	</div>

{% endblock %}
