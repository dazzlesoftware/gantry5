{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
{% do genesis.load('bootstrap.5') %}
<div class="g-heading-wrap text-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}" data-heading data-font="{{ particle.font|default('')|e('html_attr') }}" style="--gheading-size:{{ particle.size|default(32)|e('html_attr') }}px;--gheading-tablet-size:{{ particle.tabletsize|default(30)|e('html_attr') }}px;--gheading-mobile-size:{{ particle.mobilesize|default(26)|e('html_attr') }}px;--gheading-line-height:{{ particle.lineheight|default(1.2)|e('html_attr') }};--gheading-letter-spacing:{{ particle.letterspacing|default(0)|e('html_attr') }}px;--gheading-weight:{{ particle.weight|default('700')|e('html_attr') }};--gheading-transform:{{ particle.transform|default('none')|e('html_attr') }};--gheading-style:{{ particle.italic|default('normal')|e('html_attr') }};--gheading-decoration:{{ particle.decoration|default('none')|e('html_attr') }};--gheading-color:{{ particle.color|default('#222222')|e('html_attr') }};--gheading-gradient-color:{{ particle.gradientcolor|default('#3366ff')|e('html_attr') }};--gheading-gradient-angle:{{ particle.gradientangle|default(90)|e('html_attr') }}deg;--gheading-shadow:{{ particle.textshadow|default('none')|e('html_attr') }};--gheading-icon-color:{{ particle.iconcolor|default('#222222')|e('html_attr') }};--gheading-icon-size:{{ particle.iconsize|default(28)|e('html_attr') }}px;--gheading-icon-gap:{{ particle.icongap|default(10)|e('html_attr') }}px;--gheading-margin:{{ particle.margin|default('0')|e('html_attr') }};--gheading-padding:{{ particle.padding|default('0')|e('html_attr') }};">
{% if particle.link %}<a class="g-heading-link" href="{{ particle.link|e }}" target="{{ particle.target|default('_self')|e }}"{% if particle.target == '_blank' or particle.nofollow %} rel="{% if particle.target == '_blank' %}noopener noreferrer{% endif %}{% if particle.nofollow %} nofollow{% endif %}"{% endif %}>{% endif %}
<{{ particle.element|default('h3')|e }} class="g-heading{% if particle.colortype|default('solid') == 'gradient' %} g-heading-gradient{% endif %}">{% if particle.icon and particle.iconposition|default('before') == 'before' %}<i class="g-heading-icon {{ particle.icon|e }}" aria-hidden="true"></i>{% endif %}<span>{{ particle.text|default('This is a heading')|nl2br }}</span>{% if particle.icon and particle.iconposition == 'after' %}<i class="g-heading-icon {{ particle.icon|e }}" aria-hidden="true"></i>{% endif %}</{{ particle.element|default('h3')|e }}>
{% if particle.link %}</a>{% endif %}
</div>
{% endblock %}
{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/heading.js'), 11, 'footer') %}{% endblock %}
