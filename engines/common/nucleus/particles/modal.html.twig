{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
{% do genesis.load('bootstrap.5') %}
<div class="g-modal-wrap g-modal-align-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}" data-modal-root data-button-font="{{ particle.buttonfont|default('')|e('html_attr') }}" style="--gmodal-button-size:{{ particle.buttonfontsize|default(16)|e('html_attr') }}px;--gmodal-button-weight:{{ particle.buttonweight|default('400')|e('html_attr') }};--gmodal-button-padding:{{ particle.buttonpadding|default('8px 22px')|e('html_attr') }};--gmodal-button-radius:{{ particle.buttonradius|default(4)|e('html_attr') }}px;--gmodal-button-color:{{ particle.buttoncolor|default('#ffffff')|e('html_attr') }};--gmodal-button-bg:{{ particle.buttonbackground|default('#3366ff')|e('html_attr') }};--gmodal-button-border:{{ particle.buttonbordercolor|default('#3366ff')|e('html_attr') }};--gmodal-button-hover-color:{{ particle.buttonhovercolor|default('#ffffff')|e('html_attr') }};--gmodal-button-hover-bg:{{ particle.buttonhoverbackground|default('#0037dd')|e('html_attr') }};--gmodal-button-hover-border:{{ particle.buttonhoverbordercolor|default('#0037dd')|e('html_attr') }};--gmodal-button-icon-gap:{{ particle.buttonicongap|default(8)|e('html_attr') }}px;--gmodal-trigger-image-width:{{ particle.triggerimagewidth|default(320)|e('html_attr') }}px;--gmodal-trigger-image-height:{{ particle.triggerimageheight|default(180)|e('html_attr') }}px;--gmodal-trigger-icon-size:{{ particle.triggericonsize|default(32)|e('html_attr') }}px;--gmodal-trigger-icon-color:{{ particle.triggericoncolor|default('#ffffff')|e('html_attr') }};--gmodal-trigger-icon-bg:{{ particle.triggericonbackground|default('#3366ff')|e('html_attr') }};--gmodal-trigger-icon-padding:{{ particle.triggericonpadding|default(20)|e('html_attr') }}px;--gmodal-trigger-icon-radius:{{ particle.triggericonradius|default(50)|e('html_attr') }}%;--gmodal-trigger-icon-border-width:{{ particle.triggericonborderwidth|default(0)|e('html_attr') }}px;--gmodal-trigger-icon-border:{{ particle.triggericonbordercolor|default('#3366ff')|e('html_attr') }};--gmodal-trigger-text-size:{{ particle.triggertextsize|default(16)|e('html_attr') }}px;--gmodal-trigger-text-color:{{ particle.triggertextcolor|default('#222222')|e('html_attr') }};--gmodal-trigger-text-gap:{{ particle.triggertextgap|default(10)|e('html_attr') }}px;--gmodal-width:{{ particle.width|default(900)|e('html_attr') }}px;--gmodal-height:{% if particle.height|default(0) > 0 %}{{ particle.height|e('html_attr') }}px{% else %}auto{% endif %};--gmodal-overflow:{{ particle.overflow|default('auto')|e('html_attr') }};--gmodal-padding:{{ particle.padding|default(30)|e('html_attr') }}px;--gmodal-bg:{{ particle.background|default('#ffffff')|e('html_attr') }};--gmodal-color:{{ particle.color|default('#222222')|e('html_attr') }};--gmodal-radius:{{ particle.radius|default(4)|e('html_attr') }}px;--gmodal-overlay:{{ particle.overlay|default('rgba(0,0,0,0.8)')|e('html_attr') }};--gmodal-close-color:{{ particle.closecolor|default('#333333')|e('html_attr') }};--gmodal-close-size:{{ particle.closesize|default(30)|e('html_attr') }}px;">
    {% if particle.trigger|default('button') == 'image' %}
        <button type="button" class="g-modal-trigger g-modal-image-trigger{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-modal-open>{% if particle.triggerimage %}<img src="{{ url(particle.triggerimage)|e }}" alt="{{ particle.triggerimagealt|default(particle.label)|e }}" loading="lazy">{% endif %}{% if particle.label %}<span>{{ particle.label|e }}</span>{% endif %}</button>
    {% elseif particle.trigger == 'icon' %}
        <button type="button" class="g-modal-trigger g-modal-icon-trigger{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-modal-open><span class="g-modal-icon"><i class="{{ particle.triggericon|default('fa fa-play')|e }}" aria-hidden="true"></i></span>{% if particle.label %}<span class="g-modal-trigger-text">{{ particle.label|e }}</span>{% endif %}</button>
    {% else %}
        {% set bootstrap_class = particle.buttonstyle|default('custom') == 'custom' ? 'g-modal-custom' : (particle.buttonstyle == 'link' ? 'btn-link' : (particle.buttonappearance|default('flat') == 'outline' ? 'btn-outline-' ~ particle.buttonstyle : 'btn-' ~ particle.buttonstyle)) %}
        <button type="button" class="g-modal-trigger g-modal-button btn {{ bootstrap_class|e }}{% if particle.buttonsize in ['sm','lg'] %} btn-{{ particle.buttonsize|e }}{% endif %}{% if particle.buttonsize == 'custom' %} is-custom-size{% endif %}{% if particle.buttonfullwidth == 'enable' %} w-100{% endif %}{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-modal-open>{% if particle.buttonicon and particle.buttoniconposition|default('left') == 'left' %}<i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i>{% endif %}<span>{{ particle.label|default('Launch Modal')|e }}</span>{% if particle.buttonicon and particle.buttoniconposition == 'right' %}<i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i>{% endif %}</button>
    {% endif %}
    <dialog class="g-modal-dialog" aria-label="{{ particle.label|default('Modal dialog')|e }}">
        <div class="g-modal-panel g-modal-content-{{ particle.contenttype|default('text')|e }}{% if particle.verticalvideo == 'enable' %} is-vertical-video{% endif %}">
            <button type="button" class="g-modal-close" data-modal-close aria-label="Close modal">&times;</button>
            {% if particle.contenttype|default('text') == 'image' %}{% if particle.image %}<img class="g-modal-popup-image" src="{{ url(particle.image)|e }}" alt="{{ particle.imagealt|e }}" loading="lazy">{% endif %}
            {% elseif particle.contenttype == 'video' %}<div class="g-modal-video"><iframe data-modal-video data-src="{{ particle.videourl|e('html_attr') }}" title="{{ particle.videotitle|default('Video')|e }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
            {% else %}<div class="g-modal-text">{{ particle.content|raw }}</div>{% endif %}
        </div>
    </dialog>
</div>
{% endblock %}
{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/modal.js'), 11, 'footer') %}{% endblock %}
