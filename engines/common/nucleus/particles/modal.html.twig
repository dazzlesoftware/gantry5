{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
{% do genesis.load('bootstrap.5') %}
{% set modalid = 'g-modal-' ~ id %}
{% set titleid = modalid ~ '-title' %}
{% set descid = modalid ~ '-desc' %}

{% set dialogClasses %}
    modal-dialog
    {%- if particle.size|default('default') != 'default' %} modal-{{ particle.size|e }}{% endif -%}
    {%- if particle.scrollable|default('disable') == 'enable' %} modal-dialog-scrollable{% endif -%}
    {%- if particle.centered|default('disable') == 'enable' %} modal-dialog-centered{% endif -%}
    {%- if particle.fullscreen|default('disable') == 'always' %} modal-fullscreen{% elseif particle.fullscreen|default('disable') != 'disable' %} modal-fullscreen-{{ particle.fullscreen|e }}{% endif -%}
{% endset %}

{% set contentVars %}
    {%- if particle.background %}--gmodal-content-bg:{{ particle.background|e('html_attr') }};{% endif -%}
    {%- if particle.color %}--gmodal-content-color:{{ particle.color|e('html_attr') }};{% endif -%}
    {%- if particle.radius %}--gmodal-content-radius:{{ particle.radius|e('html_attr') }}px;{% endif -%}
{% endset %}

<div class="g-modal-wrap g-modal-align-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}" data-modal-root data-button-font="{{ particle.buttonfont|default('')|e('html_attr') }}" style="--gmodal-button-size:{{ particle.buttonfontsize|default(16)|e('html_attr') }}px;--gmodal-button-weight:{{ particle.buttonweight|default('400')|e('html_attr') }};--gmodal-button-padding:{{ particle.buttonpadding|default('8px 22px')|e('html_attr') }};--gmodal-button-radius:{{ particle.buttonradius|default(4)|e('html_attr') }}px;--gmodal-button-color:{{ particle.buttoncolor|default('#ffffff')|e('html_attr') }};--gmodal-button-bg:{{ particle.buttonbackground|default('#3366ff')|e('html_attr') }};--gmodal-button-border:{{ particle.buttonbordercolor|default('#3366ff')|e('html_attr') }};--gmodal-button-hover-color:{{ particle.buttonhovercolor|default('#ffffff')|e('html_attr') }};--gmodal-button-hover-bg:{{ particle.buttonhoverbackground|default('#0037dd')|e('html_attr') }};--gmodal-button-hover-border:{{ particle.buttonhoverbordercolor|default('#0037dd')|e('html_attr') }};--gmodal-button-icon-gap:{{ particle.buttonicongap|default(8)|e('html_attr') }}px;--gmodal-trigger-image-width:{{ particle.triggerimagewidth|default(320)|e('html_attr') }}px;--gmodal-trigger-image-height:{{ particle.triggerimageheight|default(180)|e('html_attr') }}px;--gmodal-trigger-icon-size:{{ particle.triggericonsize|default(32)|e('html_attr') }}px;--gmodal-trigger-icon-color:{{ particle.triggericoncolor|default('#ffffff')|e('html_attr') }};--gmodal-trigger-icon-bg:{{ particle.triggericonbackground|default('#3366ff')|e('html_attr') }};--gmodal-trigger-icon-padding:{{ particle.triggericonpadding|default(20)|e('html_attr') }}px;--gmodal-trigger-icon-radius:{{ particle.triggericonradius|default(50)|e('html_attr') }}%;--gmodal-trigger-icon-border-width:{{ particle.triggericonborderwidth|default(0)|e('html_attr') }}px;--gmodal-trigger-icon-border:{{ particle.triggericonbordercolor|default('#3366ff')|e('html_attr') }};--gmodal-trigger-text-size:{{ particle.triggertextsize|default(16)|e('html_attr') }}px;--gmodal-trigger-text-color:{{ particle.triggertextcolor|default('#222222')|e('html_attr') }};--gmodal-trigger-text-gap:{{ particle.triggertextgap|default(10)|e('html_attr') }}px;">
    {% if particle.trigger|default('button') == 'image' %}
        <button type="button" class="g-modal-trigger g-modal-image-trigger{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-bs-toggle="modal" data-bs-target="#{{ modalid }}">{% if particle.triggerimage %}<img src="{{ url(particle.triggerimage)|e }}" alt="{{ particle.triggerimagealt|default(particle.label)|e }}" loading="lazy">{% endif %}{% if particle.label %}<span>{{ particle.label|e }}</span>{% endif %}</button>
    {% elseif particle.trigger == 'icon' %}
        <button type="button" class="g-modal-trigger g-modal-icon-trigger{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-bs-toggle="modal" data-bs-target="#{{ modalid }}"><span class="g-modal-icon"><i class="{{ particle.triggericon|default('fa fa-play')|e }}" aria-hidden="true"></i></span>{% if particle.label %}<span>{{ particle.label|e }}</span>{% endif %}</button>
    {% else %}
        {% set bootstrap_class = particle.buttonstyle|default('custom') == 'custom' ? 'g-modal-custom' : (particle.buttonstyle == 'link' ? 'btn-link' : (particle.buttonappearance|default('flat') == 'outline' ? 'btn-outline-' ~ particle.buttonstyle : 'btn-' ~ particle.buttonstyle)) %}
        <button type="button" class="g-modal-trigger g-modal-button btn {{ bootstrap_class|e }}{% if particle.buttonsize in ['sm','lg'] %} btn-{{ particle.buttonsize|e }}{% endif %}{% if particle.buttonsize == 'custom' %} is-custom-size{% endif %}{% if particle.buttonfullwidth == 'enable' %} w-100{% endif %}{% if particle.ripple == 'enable' %} has-ripple{% endif %}" data-bs-toggle="modal" data-bs-target="#{{ modalid }}">{% if particle.buttonicon and particle.buttoniconposition|default('left') == 'left' %}<i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i>{% endif %}<span>{{ particle.label|default('Launch Modal')|e }}</span>{% if particle.buttonicon and particle.buttoniconposition == 'right' %}<i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i>{% endif %}</button>
    {% endif %}

    {# Real Bootstrap 5 modal markup — Bootstrap's own JS (loaded via genesis.load('bootstrap.5'))
       drives open/close/backdrop/focus-trap/Escape entirely via data-bs-* attributes below.
       role="dialog"/aria-modal are added automatically by that JS, so they're deliberately omitted here. #}
    <div class="modal fade" id="{{ modalid }}" tabindex="-1" aria-labelledby="{{ titleid }}"{% if particle.modaldescription %} aria-describedby="{{ descid }}"{% endif %} aria-hidden="true">
        <div class="{{ dialogClasses|trim }}">
            <div class="modal-content{% if particle.contenttype|default('text') == 'image' %} g-modal-content-image{% endif %}{% if particle.background %} g-modal-bg-custom{% endif %}{% if particle.color %} g-modal-color-custom{% endif %}{% if particle.radius %} g-modal-radius-custom{% endif %}" style="{{ contentVars|trim }}">
                {% if particle.showheader|default('enable') == 'enable' %}
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="{{ titleid }}">{{ particle.modaltitle|default('Modal title')|raw }}</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                {% endif %}
                <div class="modal-body{% if particle.verticalvideo == 'enable' %} is-vertical-video{% endif %}">
                    {% if particle.modaldescription %}<span id="{{ descid }}" class="visually-hidden">{{ particle.modaldescription|e }}</span>{% endif %}
                    {% if particle.contenttype|default('text') == 'image' %}{% if particle.image %}<img class="g-modal-popup-image" src="{{ url(particle.image)|e }}" alt="{{ particle.imagealt|e }}" loading="lazy">{% endif %}
                    {% elseif particle.contenttype == 'video' %}<div class="g-modal-video"><iframe data-modal-video data-src="{{ particle.videourl|e('html_attr') }}" title="{{ particle.videotitle|default('Video')|e }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
                    {% else %}<div class="g-modal-text">{{ particle.content|raw }}</div>{% endif %}
                </div>
                {% if particle.showfooter == 'enable' %}
                    <div class="modal-footer">{{ particle.footercontent|raw }}</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/modal.js'), 11, 'footer') %}{% endblock %}
