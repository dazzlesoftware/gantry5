{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
  {% do genesis.load('bootstrap.5') %}
  <div class="g-button-group g-button-group-{{ particle.alignment|default('left')|e }}{% if particle.wrap|default('enable')=='disable' %} flex-nowrap{% endif %} {{ particle.class|e }}" style="--gbtn-group-gap:{{ particle.gap|default(10)|e('html_attr') }}px;">
    {% for button in particle.buttons|default([]) %}
      {% if not button.disable %}
        {% set variant=button.style|default('primary')=='custom'?'g-button-custom':(button.style=='link'?'btn-link':(button.appearance|default('flat')=='outline'?'btn-outline-'~button.style:'btn-'~button.style)) %}
        <a href="{{ button.link|default('#')|e }}" target="{{ button.target|default('_self')|e }}" data-button-font="{{ button.font|default('')|e('html_attr') }}" class="g-button btn {{ variant|e }}{% if button.size in ['sm','lg'] %} btn-{{ button.size|e }}{% endif %}{% if button.size=='custom' %} is-custom-size{% endif %}{% if button.shape=='square' %} rounded-0{% elseif button.shape=='pill' %} rounded-pill{% endif %}{% if button.fullwidth %} w-100{% endif %}" style="--gbtn-size:{{ button.fontsize|default(16)|e('html_attr') }}px;--gbtn-weight:{{ button.weight|default(400)|e('html_attr') }};--gbtn-padding:{{ button.padding|default('8px 22px')|e('html_attr') }};--gbtn-color:{{ button.color|default('#ffffff')|e('html_attr') }};--gbtn-bg:{{ button.background|default('#3366ff')|e('html_attr') }};--gbtn-border:{{ button.bordercolor|default('#3366ff')|e('html_attr') }};--gbtn-hover-color:{{ button.hovercolor|default('#ffffff')|e('html_attr') }};--gbtn-hover-bg:{{ button.hoverbackground|default('#0037dd')|e('html_attr') }};--gbtn-hover-border:{{ button.hoverbordercolor|default('#0037dd')|e('html_attr') }};"{% if button.target=='_blank' or button.nofollow %} rel="{% if button.target=='_blank' %}noopener noreferrer{% endif %}{% if button.nofollow %} nofollow{% endif %}"{% endif %}>
          {% if button.icon and button.iconposition|default('left')=='left' %}
            <i class="{{ button.icon|e }}" aria-hidden="true">
            </i>
          {% endif %}
          <span>
            {{ button.text|raw }}
          </span>
          {% if button.icon and button.iconposition=='right' %}
            <i class="{{ button.icon|e }}" aria-hidden="true">
            </i>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
{% block javascript_footer %}
  {% do genesis.document.addScript(url('genesis-assets://js/button.js'),11,'footer') %}
{% endblock %}
