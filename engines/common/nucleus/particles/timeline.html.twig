{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <section class="g-timeline g-timeline-{{ particle.alignment|default('alternate')|e }} {{ particle.class|e }}" style="--gtl-line:{{ particle.linecolor|default('#dddddd')|e('html_attr') }};--gtl-marker:{{ particle.markercolor|default('#3366ff')|e('html_attr') }};--gtl-date:{{ particle.datecolor|default('#3366ff')|e('html_attr') }};--gtl-card-bg:{{ particle.cardbackground|default('#ffffff')|e('html_attr') }};--gtl-card-color:{{ particle.cardcolor|default('#444444')|e('html_attr') }};--gtl-gap:{{ particle.gap|default(32)|e('html_attr') }}px;">
        {% if particle.title %}<h3 class="g-title">{{ particle.title|raw }}</h3>{% endif %}
        <div class="g-timeline-list">
            {#- Falls back to the older "timeline" collection (with startyear/endyear
               field names) if "items" is empty, so existing saved content using that
               older schema isn't silently lost. #}
            {% for item in particle.items|default([]) is not empty ? particle.items : particle.timeline|default([]) %}
                {% if item.enabled|default(true) %}
                    {% set startdate = item.date|default(item.startyear) %}
                    {% set enddate = item.enddate|default(item.endyear) %}
                    <article class="g-timeline-item">
                        <div class="g-timeline-marker">{% if item.icon %}<i class="{{ item.icon|e }}" aria-hidden="true"></i>{% endif %}</div>
                        <div class="g-timeline-card">
                            {% if item.image %}<img class="g-timeline-image g-image-{{ item.imageshape|default('rounded')|e }}" src="{{ url(item.image)|e }}" alt="{{ item.title|e }}" loading="lazy">{% endif %}
                            {% if startdate or enddate %}<div class="g-timeline-date">{{ startdate|e }}{% if enddate %} – {{ enddate|e }}{% endif %}</div>{% endif %}
                            <h4>{% if item.link %}<a href="{{ item.link|e }}" target="{{ item.target|default('_self')|e }}">{{ item.title|raw }}</a>{% else %}{{ item.title|raw }}{% endif %}</h4>
                            {% if item.subtitle %}<div class="g-timeline-subtitle">{{ item.subtitle|e }}</div>{% endif %}
                            <div>{{ item.content|raw }}</div>
                        </div>
                    </article>
                {% endif %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
