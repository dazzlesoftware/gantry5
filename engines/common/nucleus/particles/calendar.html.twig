{% extends '@nucleus/partials/particle.html.twig' %}

{% set language = genesis.page.language %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <div class="g-calendar-particle {{ particle.class|e }}">

        {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

        {% set calendarVars %}
            {%- if particle.titlefontsize %}--g-calendar-title-size:{{ particle.titlefontsize|e('html_attr') }}px;{% endif -%}
            {%- if particle.numbersfontsize %}--g-calendar-number-size:{{ particle.numbersfontsize|e('html_attr') }}px;{% endif -%}
            {%- if particle.iconsize %}--g-calendar-icon-size:{{ particle.iconsize|e('html_attr') }}px;{% endif -%}
            {%- if particle.iconcolor %}--g-calendar-icon-color:{{ particle.iconcolor|e('html_attr') }};{% endif -%}
            {%- if particle.closeiconsize %}--g-calendar-close-icon-size:{{ particle.closeiconsize|e('html_attr') }}px;{% endif -%}
            {%- if particle.closeiconcolor %}--g-calendar-close-icon-color:{{ particle.closeiconcolor|e('html_attr') }};{% endif -%}
            {%- if particle.closebuttoncolor %}--g-calendar-close-button-color:{{ particle.closebuttoncolor|e('html_attr') }};{% endif -%}
            {%- if particle.closebuttonhovercolor %}--g-calendar-close-button-hover-color:{{ particle.closebuttonhovercolor|e('html_attr') }};{% endif -%}
            {%- if particle.eventtitlefontsize %}--g-calendar-event-title-size:{{ particle.eventtitlefontsize|e('html_attr') }}px;{% endif -%}
            {%- if particle.eventdescfontsize %}--g-calendar-event-desc-size:{{ particle.eventdescfontsize|e('html_attr') }}px;{% endif -%}
        {% endset %}

        <div
            id="g-{{ id }}"
            class="g-calendar"
            {% if calendarVars|trim %}style="{{ calendarVars|trim }}"{% endif %}
        >
</div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/calendar.js'), 11, 'footer') %}
    <script>
        GenesisCalendar.create(document.getElementById('g-{{ id }}'), {
            locale: '{{ language|e("js") }}',
            eventsHeader: '{{ particle.eventsheader|default("Events")|e("js") }}',
            previousIcon: '{{ particle.iconprev|default("fa fa-arrow-circle-left")|e("js") }}',
            nextIcon: '{{ particle.iconnext|default("fa fa-arrow-circle-right")|e("js") }}',
            closeIcon: '{{ particle.closeicon|default("fa fa-close")|e("js") }}',
            events: [
                {% for event in particle.events %}
                {
                    id: 'g-{{ id }}-event-{{ loop.index }}',
                    startDate: '{{ event.begin|e("js") }}',
                    endDate: '{{ event.end|e("js") }}',
                    title: '{{ event.title|e("js") }}',
                    url: '{{ event.link|e("js") }}',
                    target: '{{ event.target|default("_blank")|e("js") }}',
                    desc: '{{ event.description|e("js") }}'
                }{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ]
        });
    </script>
{% endblock %}
