{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}<div class="g-icons-group {{ particle.class|e }}" style="--gig-gap:{{ particle.gap|default(12)|e('html_attr') }}px;">{% if particle.title %}<{{ particle.heading|default('h3')|e }} class="g-title text-{{ particle.titlealignment|default('center')|e }}">{{ particle.title|raw }}</{{ particle.heading|default('h3')|e }}>{% endif %}<div class="g-icons-group-list g-display-{{ particle.display|default('inline')|e }} text-{{ particle.alignment|default('center')|e }}">{% for item in particle.items|default([]) %}{% if item.enabled|default(true) %}<div class="g-icons-group-item g-label-{{ item.labelposition|default('bottom')|e }}" style="--gig-size:{{ item.size|default(28)|e('html_attr') }}px;--gig-width:{{ item.width|default(56)|e('html_attr') }}px;--gig-height:{{ item.height|default(56)|e('html_attr') }}px;--gig-color:{{ item.color|default('#3366ff')|e('html_attr') }};--gig-bg:{{ item.background|default('transparent')|e('html_attr') }};--gig-hover-color:{{ item.hovercolor|default('#ffffff')|e('html_attr') }};--gig-hover-bg:{{ item.hoverbackground|default('#3366ff')|e('html_attr') }};--gig-border-width:{{ item.borderwidth|default(0)|e('html_attr') }}px;--gig-border-color:{{ item.bordercolor|default('#3366ff')|e('html_attr') }};--gig-radius:{{ item.radius|default(0)|e('html_attr') }}px;">{% if item.link %}<a href="{{ item.link|e }}" target="{{ item.target|default('_self')|e }}"{% if item.target|default('_self') == '_blank' %} rel="noopener noreferrer"{% endif %}>{% else %}<span>{% endif %}<span class="g-icons-group-icon"><i class="{{ item.icon|default('fa fa-star')|e }}" aria-hidden="true"></i></span>{% if item.label %}<span class="g-icons-group-label">{{ item.label|e }}</span>{% endif %}{% if item.link %}</a>{% else %}</span>{% endif %}</div>{% endif %}{% endfor %}</div></div>{% endblock %}
