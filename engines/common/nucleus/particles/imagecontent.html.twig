{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}{% set imagecols = particle.imagecolumns|default(6) %}{% set contentcols = 12 - imagecols %}{% set imageorder = particle.imageposition|default('left') == 'right' ? 'order-lg-2' : 'order-lg-1' %}{% set contentorder = particle.imageposition|default('left') == 'right' ? 'order-lg-1' : 'order-lg-2' %}{% set btnclass = 'btn-' ~ (particle.buttonoutline|default('solid') == 'outline' ? 'outline-' : '') ~ particle.buttonstyle|default('primary') %}<div class="g-image-content {{ particle.class|e }}" style="--gic-bg:{{ particle.background|default('transparent')|e('html_attr') }};--gic-padding:{{ particle.padding|default('2rem')|e('html_attr') }};--gic-height:{{ particle.imageheight|default(360)|e('html_attr') }}px;--gic-fit:{{ particle.imagefit|default('cover')|e('html_attr') }};--gic-radius:{{ particle.radius|default(0)|e('html_attr') }}px;--gic-title-color:{{ particle.titlecolor|default('inherit')|e('html_attr') }};--gic-text-color:{{ particle.textcolor|default('inherit')|e('html_attr') }};"><div class="row g-0 align-items-stretch">{% if particle.image %}<div class="col-12 col-lg-{{ imagecols|e }} {{ imageorder }} g-image-content-media"><img src="{{ url(particle.image)|e }}" alt="{{ particle.imagealt|default(particle.title)|e }}" loading="lazy"></div>{% endif %}<div class="col-12 col-lg-{{ particle.image ? contentcols : 12 }} {{ contentorder }} g-image-content-body text-{{ particle.alignment|default('left')|e }}">{% if particle.title %}<{{ particle.heading|default('h2')|e }}>{{ particle.title|raw }}</{{ particle.heading|default('h2')|e }}>{% endif %}<div class="g-image-content-text">{{ particle.text|raw }}</div>{% if particle.buttontext %}<a class="btn {{ btnclass|e }}{% if particle.buttonsize == 'small' %} btn-sm{% elseif particle.buttonsize == 'large' %} btn-lg{% endif %}" href="{{ particle.buttonlink|default('#')|e }}" target="{{ particle.buttontarget|default('_self')|e }}"{% if particle.buttontarget|default('_self') == '_blank' %} rel="noopener noreferrer"{% endif %}>{% if particle.buttonicon and particle.buttoniconposition|default('left') == 'left' %}<i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i> {% endif %}{{ particle.buttontext|e }}{% if particle.buttonicon and particle.buttoniconposition|default('left') == 'right' %} <i class="{{ particle.buttonicon|e }}" aria-hidden="true"></i>{% endif %}</a>{% endif %}</div></div></div>{% endblock %}
