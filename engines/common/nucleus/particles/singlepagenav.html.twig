{% extends '@nucleus/partials/particle.html.twig' %}

{% block javascript %}
<script>
(() => {
    'use strict';

    const navigation = document.querySelector('{{ particle.section|default("#g-navigation") }}');
    if (!navigation || navigation.dataset.singlePageNavReady || typeof bootstrap === 'undefined' || !bootstrap.ScrollSpy) return;
    navigation.dataset.singlePageNavReady = 'true';

    if (!navigation.id) navigation.id = 'g-singlepagenav-' + Math.random().toString(36).slice(2, 8);

    const excluded = '{{ particle.class|e("js") }}';
    const currentClass = '{{ particle.currentClass|default("current")|e("js") }}';
    const duration = {{ particle.speed|default(400) }};
    const updateHash = {{ particle.updateHash == "enabled" ? 'true' : 'false' }};
    const offset = {% if particle.offset == "enabled" %}document.getElementById('g-navigation')?.offsetHeight || 0{% else %}0{% endif %};

    const links = [...navigation.querySelectorAll('a[href^="#"]')]
        .filter((link) => !excluded || !link.matches(excluded));

    // Smooth-scroll on click with configurable speed/easing: Bootstrap's Scrollspy only
    // tracks and highlights the active link, it does not animate the scroll itself.
    navigation.addEventListener('click', (event) => {
        const link = event.target.closest('a[href^="#"]');
        if (!link || !links.includes(link)) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        event.preventDefault();

        const start = window.scrollY;
        const destination = Math.max(0, target.getBoundingClientRect().top + start - offset);
        const started = performance.now();
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scroll = (now) => {
            const progress = reducedMotion ? 1 : Math.min(1, (now - started) / Math.max(1, duration));
            const eased = 1 - Math.pow(1 - progress, 3);
            window.scrollTo(0, start + (destination - start) * eased);
            if (progress < 1) requestAnimationFrame(scroll);
        };
        requestAnimationFrame(scroll);
        if (updateHash) history.pushState(null, '', link.hash);
    });

    // Bootstrap's own Scrollspy drives the active-section tracking (data-bs-spy/data-bs-target,
    // .active class management) — no hand-rolled IntersectionObserver needed any more.
    document.body.setAttribute('data-bs-spy', 'scroll');
    document.body.setAttribute('data-bs-target', '#' + navigation.id);
    document.body.setAttribute('data-bs-offset', offset);
    new bootstrap.ScrollSpy(document.body, {
        target: '#' + navigation.id,
        offset,
    });

    // Bootstrap always toggles its own hardcoded "active" class; mirror that onto the
    // particle's configurable currentClass for themes/links that key off it instead.
    if (currentClass && currentClass !== 'active') {
        document.body.addEventListener('activate.bs.scrollspy', (event) => {
            links.forEach((link) => {
                link.classList.toggle(currentClass, link.hash === event.relatedTarget);
            });
        });
    }
})();
</script>
{% endblock %}
