{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
    <div class="g-social {{ particle.css.class }}">
        {% for item in particle.items %}
            {% set itemTarget = (item.target is not empty) ? item.target : particle.target %}
            {% if itemTarget %}
                {% set targetAttrib = ' target="' ~ itemTarget|e ~ '"' %}
                {% set targetAttrib = (itemTarget == '_blank') ? targetAttrib ~ ' rel="noopener noreferrer"' : targetAttrib %}
            {% else %}
                {% set targetAttrib = '' %}
            {% endif %}
            {% set title = (item.title is not empty) ? item.title|e : item.text|e %}
            {% set titleAttrib = (title is not empty) ? ' title="' ~ title ~ '" aria-label="' ~ title ~ '"' : '' %}
            {% set classAttrib = (item.class is not empty) ? ' class="' ~ item.class|e ~ '"' : '' %}
            <a href="{{ item.link|e }}"{{ classAttrib|raw }}{{ targetAttrib|raw }}{{ titleAttrib|raw }}>
                {% if particle.display in ['both', 'icons_only'] %}<span class="{{ item.icon|e }}"></span>{% endif %}
                {% if particle.display in ['both', 'text_only'] %}<span class="g-social-text">{{ item.text|e }}</span>{% endif %}
            </a>
        {% endfor %}
    </div>
{% endblock %}
