{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
  {% do genesis.load('bootstrap.5') %}
  {% set lightbox_enabled = particle.lightbox|default('disable') == 'enable' and particle.image %}
  <article class="g-image-overlay g-overlay-position-{{ particle.contentposition|default('center')|e }} g-overlay-hover-{{ particle.showonhover|default('disable')|e }} g-overlay-animation-{{ particle.animation|default('zoom')|e }} {{ particle.class|e }}" style="--gio-image:url('{{ particle.image ? url(particle.image)|e('html_attr') : '' }}');--gio-height:{{ particle.height|default(420)|e('html_attr') }}px;--gio-padding:{{ particle.padding|default('2rem')|e('html_attr') }};--gio-overlay:{{ particle.overlay|default('rgba(0,0,0,.35)')|e('html_attr') }};--gio-hover-overlay:{{ particle.hoveroverlay|default('rgba(0,0,0,.6)')|e('html_attr') }};--gio-title-color:{{ particle.titlecolor|default('#fff')|e('html_attr') }};--gio-subtitle-color:{{ particle.subtitlecolor|default('#fff')|e('html_attr') }};--gio-radius:{{ particle.radius|default(0)|e('html_attr') }}px;--gio-tag-color:{{ particle.tagcolor|default('#ffffff')|e('html_attr') }};--gio-tag-bg:{{ particle.tagbackground|default('#3366ff')|e('html_attr') }};">
    {% if particle.tag %}
      <span class="g-image-overlay-tag">{{ particle.tag|e }}</span>
    {% endif %}
    {% if lightbox_enabled %}
      <a class="g-image-overlay-link" href="{{ url(particle.image)|e }}" data-genesis-lightbox="image" data-lightbox-title="{{ particle.title|e('html_attr') }}" aria-label="Open {{ particle.title|default('image')|e }} in lightbox">
      </a>
    {% elseif particle.link %}
      <a class="g-image-overlay-link" href="{{ particle.link|e }}" aria-label="{{ particle.title|default('Image link')|e }}">
      </a>
    {% endif %}
    <div class="g-image-overlay-shade">
    </div>
    <div class="g-image-overlay-content">
      {% if particle.title %}
        <{{ particle.heading|default('h2')|e }}>
          {% if particle.titleicon %}
            <i class="{{ particle.titleicon|e }}" aria-hidden="true">
            </i>
          {% endif %}
          {{ particle.title|raw }}
        </{{ particle.heading|default('h2')|e }}>
      {% endif %}
      {% if particle.subtitle %}
        <div class="g-image-overlay-subtitle">
          {% if particle.subtitleicon %}
            <i class="{{ particle.subtitleicon|e }}" aria-hidden="true">
            </i>
          {% endif %}
          {{ particle.subtitle|raw }}
        </div>
      {% endif %}
      {% if particle.buttontext %}
        <a class="btn btn-{{ particle.buttonstyle|default('light')|e }}" href="{{ particle.buttonlink|default('#')|e }}">
          {{ particle.buttontext|e }}
        </a>
      {% endif %}
    </div>
  </article>
  {% if particle.desc %}
    <div class="g-image-overlay-desc">{{ particle.desc|raw }}</div>
  {% endif %}
{% endblock %}
{% block javascript_footer %}
  {% do genesis.document.addScript(url('genesis-assets://js/genesis-media-lightbox.js'),11,'footer') %}
{% endblock %}
