{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <section id="g-tabbedcards-{{ id }}" class="g-tabbedcards g-tabbedcards-tabs-{{ particle.tab_position|default('top')|e }} {{ particle.class|e }}">
        {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
        {% if particle.description %}<div>{{ particle.description|raw }}</div>{% endif %}

        <div class="g-tabbedcards-layout">
            <ul class="nav nav-tabs g-tabbedcards-tabs" id="g-tabbedcards-nav-{{ id }}" role="tablist" aria-label="{{ particle.title|default('Tabbed cards')|e('html_attr') }}">
                {% for tab in particle.tabs|default([]) %}
                    <li class="nav-item" role="presentation">
                        <button
                            id="g-tabbedcards-tab-{{ id }}-{{ loop.index }}"
                            class="nav-link{% if loop.first %} active{% endif %}"
                            type="button"
                            role="tab"
                            data-bs-toggle="tab"
                            data-bs-target="#g-tabbedcards-panel-{{ id }}-{{ loop.index }}"
                            aria-controls="g-tabbedcards-panel-{{ id }}-{{ loop.index }}"
                            aria-selected="{{ loop.first ? 'true' : 'false' }}"
                        >{{ tab.title|e }}</button>
                    </li>
                {% endfor %}
            </ul>

            <div class="tab-content g-tabbedcards-panels">
                {% for tab in particle.tabs|default([]) %}
                    <div
                        id="g-tabbedcards-panel-{{ id }}-{{ loop.index }}"
                        class="tab-pane fade{% if loop.first %} show active{% endif %} g-tabbedcards-panel {{ tab.class|e }}"
                        role="tabpanel"
                        aria-labelledby="g-tabbedcards-tab-{{ id }}-{{ loop.index }}"
                        tabindex="0"
                    >
                        <div class="g-tabbedcards-grid g-tabbedcards-columns-{{ particle.columns|default(3)|e }}">
                            {% for card in tab.cards|default([]) %}
                                <article class="g-tabbedcards-card {{ card.class|e }}">
                                    {% if card.image %}
                                        <div class="g-tabbedcards-card-image">
                                            <img src="{{ url(card.image)|e }}" alt="{{ card.title|e }}" loading="lazy">
                                            {% if card.link and card.linklabel %}
                                                <a class="g-tabbedcards-card-overlay" href="{{ card.link|e }}" target="{{ card.target|default('_self')|e }}"{% if card.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ card.linklabel|e }}</a>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {% if card.title %}
                                        <h3 class="g-tabbedcards-card-title">
                                            {% if card.link %}<a href="{{ card.link|e }}" target="{{ card.target|default('_self')|e }}"{% if card.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ card.title|e }}</a>{% else %}{{ card.title|e }}{% endif %}
                                        </h3>
                                    {% endif %}
                                    {% if card.description %}<div class="g-tabbedcards-card-description">{{ card.description|raw }}</div>{% endif %}
                                    {% if card.tag or card.subtag %}
                                        <div class="g-tabbedcards-card-meta">
                                            {% if card.tag %}<span class="g-tabbedcards-card-tag">{{ card.tag|e }}</span>{% endif %}
                                            {% if card.subtag %}<span class="g-tabbedcards-card-subtag">{{ card.subtag|e }}</span>{% endif %}
                                        </div>
                                    {% endif %}
                                </article>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
