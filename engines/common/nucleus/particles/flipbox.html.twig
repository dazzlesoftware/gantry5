{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
  {% do genesis.load('bootstrap.5') %}
  <div class="g-flipbox g-flipbox-{{ particle.direction|default('horizontal')|e }} text-{{ particle.alignment|default('center')|e }} {{ particle.class|e }}" tabindex="0" data-flipbox data-behavior="{{ particle.behavior|default('hover')|e }}" style="--gflip-height:{{ particle.height|default(320)|e('html_attr') }}px;--gflip-padding:{{ particle.padding|default(30)|e('html_attr') }}px;--gflip-radius:{{ particle.radius|default(4)|e('html_attr') }}px;--gflip-front-bg:{{ particle.frontbackground|default('#3366ff')|e('html_attr') }};--gflip-front-color:{{ particle.frontcolor|default('#ffffff')|e('html_attr') }};--gflip-back-bg:{{ particle.backbackground|default('#222222')|e('html_attr') }};--gflip-back-color:{{ particle.backcolor|default('#ffffff')|e('html_attr') }};">
    <div class="g-flipbox-inner">
      <div class="g-flipbox-face g-flipbox-front"{% if particle.frontimage %} style="background-image:url('{{ url(particle.frontimage)|e('html_attr') }}')"{% endif %}>
        {{ particle.fronttext|raw }}
      </div>
      <div class="g-flipbox-face g-flipbox-back"{% if particle.backimage %} style="background-image:url('{{ url(particle.backimage)|e('html_attr') }}')"{% endif %}>
        {{ particle.backtext|raw }}
      </div>
    </div>
  </div>
{% endblock %}
{% block javascript_footer %}
  {% do genesis.document.addScript(url('genesis-assets://js/genesis-flipbox.js'),11,'footer') %}
{% endblock %}
