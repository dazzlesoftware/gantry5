{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}<section class="g-instagram-gallery g-instagram-{{ particle.layout|default('grid')|e }} g-instagram-ratio-{{ particle.ratio|default('square')|e }} {{ particle.class|e }}" style="--gigallery-cols:{{ particle.columns|default(4)|e('html_attr') }};--gigallery-tablet:{{ particle.tabletcolumns|default(3)|e('html_attr') }};--gigallery-mobile:{{ particle.mobilecolumns|default(2)|e('html_attr') }};--gigallery-gap:{{ particle.gap|default(10)|e('html_attr') }}px;--gigallery-overlay:{{ particle.overlay|default('rgba(0,0,0,.55)')|e('html_attr') }};">{% if particle.title %}<{{ particle.heading|default('h3')|e }} class="g-title text-{{ particle.titlealignment|default('center')|e }}">{{ particle.title|raw }}</{{ particle.heading|default('h3')|e }}>{% endif %}{% if particle.profile %}<div class="g-instagram-profile text-{{ particle.titlealignment|default('center')|e }}">{% if particle.profilelink %}<a href="{{ particle.profilelink|e }}" target="_blank" rel="noopener noreferrer">{% endif %}<i class="fa fa-instagram" aria-hidden="true"></i> {{ particle.profile|e }}{% if particle.profilelink %}</a>{% endif %}</div>{% endif %}<div class="g-instagram-items">{% for item in particle.items|default([]) %}{% if item.enabled|default(true) and item.image %}{% set media = item.mediaurl ?: url(item.image) %}{% set lbtype = item.mediatype|default('image') == 'video' ? 'video' : 'image' %}<figure class="g-instagram-item">{% if particle.lightbox|default('enable') == 'enable' %}<a href="{{ media|e }}" data-genesis-lightbox="{{ lbtype }}" data-lightbox-title="{{ item.caption|default(item.title)|striptags|e('html_attr') }}">{% elseif item.postlink %}<a href="{{ item.postlink|e }}" target="_blank" rel="noopener noreferrer">{% endif %}<img src="{{ url(item.image)|e }}" alt="{{ item.alt|default(item.title)|e }}" loading="lazy"><span class="g-instagram-overlay">{% if item.mediatype|default('image') == 'video' %}<i class="fa fa-play" aria-hidden="true"></i>{% endif %}{% if particle.showstats|default('enable') == 'enable' %}<span class="g-instagram-stats"><span><i class="fa fa-heart" aria-hidden="true"></i> {{ item.likes|default(0)|e }}</span><span><i class="fa fa-comment" aria-hidden="true"></i> {{ item.comments|default(0)|e }}</span></span>{% endif %}</span>{% if particle.lightbox|default('enable') == 'enable' or item.postlink %}</a>{% endif %}{% if item.caption %}<figcaption class="visually-hidden">{{ item.caption|striptags|e }}</figcaption>{% endif %}</figure>{% endif %}{% endfor %}</div></section>{% endblock %}{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/genesis-media-lightbox.js'),11,'footer') %}{% endblock %}
