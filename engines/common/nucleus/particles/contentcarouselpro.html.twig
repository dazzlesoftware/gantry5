{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}<div class="g-content-carousel g-content-carousel-pro {{ particle.class|e }}" data-genesis-carousel data-autoplay="{{ particle.autoplay|default('enable')|e }}" data-pause-hover="{{ particle.pausehover|default('enable')|e }}" data-loop="{{ particle.loop|default('enable')|e }}" data-randomize="{{ particle.randomize|default('disable')|e }}" data-interval="{{ particle.interval|default(5000)|e }}" data-speed="{{ particle.speed|default(600)|e }}" style="--gcc-height:{{ particle.height|default(520)|e('html_attr') }}px;--gcc-pro-width:{{ particle.contentwidth|default(50)|e('html_attr') }}%;--gcc-arrow-color:{{ particle.arrowcolor|default('#ffffff')|e('html_attr') }};--gcc-arrow-bg:{{ particle.arrowbackground|default('rgba(0,0,0,0.45)')|e('html_attr') }};"><div class="g-genesis-carousel-track">{% for slide in particle.slides|default([]) %}{% if not slide.disable %}<div class="g-genesis-carousel-slide g-pro-{{ slide.layout|default('overlay')|e }}"{% if slide.background %} style="background-image:url('{{ url(slide.background)|e('html_attr') }}')"{% endif %}><div class="g-pro-media">{% if slide.video %}<iframe src="about:blank" data-carousel-video="{{ slide.video|e('html_attr') }}" title="{{ slide.title|e }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>{% elseif slide.image %}<img src="{{ url(slide.image)|e }}" alt="{{ slide.title|e }}" loading="lazy">{% endif %}</div><div class="g-pro-content" style="--gcc-pro-content-bg:{{ slide.contentbackground|default('rgba(0,0,0,0.55)')|e('html_attr') }};--gcc-pro-content-color:{{ slide.contentcolor|default('#ffffff')|e('html_attr') }};">{% if slide.title %}<h2>{{ slide.title|raw }}</h2>{% endif %}{{ slide.content|raw }}{% if slide.buttontext %}<a class="btn btn-primary" href="{{ slide.buttonlink|default('#')|e }}">{{ slide.buttontext|e }}</a>{% endif %}</div></div>{% endif %}{% endfor %}</div>{% if particle.arrows|default('enable')=='enable' %}<button class="g-carousel-prev" type="button" data-carousel-prev aria-label="Previous slide">&lsaquo;</button><button class="g-carousel-next" type="button" data-carousel-next aria-label="Next slide">&rsaquo;</button>{% endif %}{% if particle.bullets|default('enable')=='enable' %}<div class="g-carousel-dots" data-carousel-dots></div>{% endif %}</div>{% endblock %}{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/genesis-contentcarousel.js'),11,'footer') %}{% endblock %}
