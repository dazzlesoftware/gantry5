{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}<div class="g-animated-number g-animated-number-{{ particle.layout|default('stacked')|e }} text-{{ particle.alignment|default('center')|e }} {{ particle.class|e }}" data-animated-number data-number="{{ particle.number|default(1000)|e('html_attr') }}" data-fraction="{{ particle.fraction|default('')|e('html_attr') }}" data-duration="{{ particle.duration|default(2000)|e('html_attr') }}" data-format="{{ particle.format|default('enable')|e }}" data-separator="{{ particle.separator|default(',')|e('html_attr') }}" data-fraction-separator="{{ particle.fractionseparator|default('.')|e('html_attr') }}" data-number-font="{{ particle.numberfont|default('')|e('html_attr') }}" data-title-font="{{ particle.titlefont|default('')|e('html_attr') }}" style="--gan-number-size:{{ particle.numbersize|default(48)|e('html_attr') }}px;--gan-number-color:{{ particle.numbercolor|default('#3366ff')|e('html_attr') }};--gan-title-size:{{ particle.titlesize|default(18)|e('html_attr') }}px;--gan-title-color:{{ particle.titlecolor|default('#555555')|e('html_attr') }};--gan-gap:{{ particle.gap|default(10)|e('html_attr') }}px;"><div class="g-animated-number-value"><span>{{ particle.prefix|e }}</span><span data-number-value>0</span><span>{{ particle.suffix|e }}</span></div>{% if particle.title %}<div class="g-animated-number-title">{{ particle.title|raw }}</div>{% endif %}</div>{% endblock %}{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/animatednumber.js'),11,'footer') %}{% endblock %}
