{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% do genesis.load('bootstrap.5') %}
    <section class="g-advanced-progress {{ particle.class|e }}" data-advanced-progress data-progress="{{ particle.progress|default(75)|e }}" data-animate="{{ particle.animate|default('enable')|e }}" data-duration="{{ particle.duration|default(1000)|e }}" style="--gap-height:{{ particle.height|default(24)|e('html_attr') }}px;--gap-track:{{ particle.trackcolor|default('#e9ecef')|e('html_attr') }};--gap-color:{{ particle.textcolor|default('#ffffff')|e('html_attr') }};--gap-custom:{{ particle.customcolor|default('#3366ff')|e('html_attr') }};">
        {% if particle.title %}<h3 class="g-title">{{ particle.title|raw }}</h3>{% endif %}
        <div class="g-advanced-progress-heading"><span>{{ particle.text|default('Progress')|e }}</span>{% if particle.showpercentage|default('enable') == 'enable' %}<span>{{ particle.progress|default(75)|e }}%</span>{% endif %}</div>
        <div class="progress g-progress-shape-{{ particle.shape|default('rounded')|e }}" role="progressbar" aria-valuenow="{{ particle.progress|default(75)|e }}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar{% if particle.type|default('primary') != 'custom' %} bg-{{ particle.type|default('primary')|e }}{% else %} g-progress-custom{% endif %}{% if particle.striped|default('disable') == 'enable' %} progress-bar-striped{% endif %}{% if particle.animatedstripes|default('disable') == 'enable' %} progress-bar-animated{% endif %}"></div>
        </div>
    </section>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/genesis-advancedprogressbar.js'), 11, 'footer') %}
{% endblock %}
