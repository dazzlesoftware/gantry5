{% extends '@nucleus/partials/particle.html.twig' %}{% block particle %}{% do genesis.load('bootstrap.5') %}{% set selected_networks = particle.networks|default(['facebook','x','linkedin','pinterest','reddit','email','whatsapp']) %}{% set network_value = selected_networks is iterable ? selected_networks|join(',') : selected_networks %}<div class="g-social-share text-{{ particle.alignment|default('left')|e }} {{ particle.class|e }}" data-social-share data-networks="{{ network_value|e('html_attr') }}" data-show-names="{{ particle.shownames|default('disable')|e }}" data-style="{{ particle.style|default('custom')|e }}" data-custom-colors="{{ particle.customcolormode|default('shared')|e }}" style="--gshare-color:{{ particle.iconcolor|default('#ffffff')|e('html_attr') }};--gshare-bg:{{ particle.background|default('#3366ff')|e('html_attr') }};--gshare-hover-color:{{ particle.hovercolor|default('#ffffff')|e('html_attr') }};--gshare-hover-bg:{{ particle.hoverbackground|default('#0037dd')|e('html_attr') }};--gshare-facebook-bg:{{ particle.facebookbackground|default('#1877f2')|e('html_attr') }};--gshare-facebook-hover:{{ particle.facebookhoverbackground|default('#0d65d9')|e('html_attr') }};--gshare-x-bg:{{ particle.xbackground|default('#111111')|e('html_attr') }};--gshare-x-hover:{{ particle.xhoverbackground|default('#333333')|e('html_attr') }};--gshare-linkedin-bg:{{ particle.linkedinbackground|default('#0a66c2')|e('html_attr') }};--gshare-linkedin-hover:{{ particle.linkedinhoverbackground|default('#084f96')|e('html_attr') }};--gshare-pinterest-bg:{{ particle.pinterestbackground|default('#bd081c')|e('html_attr') }};--gshare-pinterest-hover:{{ particle.pinteresthoverbackground|default('#930616')|e('html_attr') }};--gshare-reddit-bg:{{ particle.redditbackground|default('#ff4500')|e('html_attr') }};--gshare-reddit-hover:{{ particle.reddithoverbackground|default('#d93b00')|e('html_attr') }};--gshare-email-bg:{{ particle.emailbackground|default('#5f6368')|e('html_attr') }};--gshare-email-hover:{{ particle.emailhoverbackground|default('#44474b')|e('html_attr') }};--gshare-whatsapp-bg:{{ particle.whatsappbackground|default('#25d366')|e('html_attr') }};--gshare-whatsapp-hover:{{ particle.whatsapphoverbackground|default('#1da851')|e('html_attr') }};--gshare-size:{{ particle.size|default(18)|e('html_attr') }}px;--gshare-box:{{ particle.boxsize|default(42)|e('html_attr') }}px;--gshare-radius:{{ particle.radius|default(4)|e('html_attr') }}px;--gshare-gap:{{ particle.gap|default(8)|e('html_attr') }}px;">{% if particle.title %}<h3 class="g-title">{{ particle.title|raw }}</h3>{% endif %}<div class="g-social-share-list"></div></div>{% endblock %}{% block javascript_footer %}{% do genesis.document.addScript(url('genesis-assets://js/genesis-socialshare.js'),11,'footer') %}{% endblock %}
