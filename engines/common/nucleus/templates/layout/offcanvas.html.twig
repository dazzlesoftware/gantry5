{% do genesis.load('bootstrap.5') %}
{% set attr_extra = segment.attributes.extra|attribute_array %}
{% set position = segment.attributes.position|default('offcanvas-start') %}
{# Accept saved pre-Bootstrap values while emitting only Bootstrap classes. #}
{% set bs_side = position in ['offcanvas-end', 'g-offcanvas-right'] ? 'offcanvas-end' : 'offcanvas-start' %}

{% set offcanvas %}
    {% for child in segment.children %}
        {% include '@nucleus/layout/' ~ child.type ~ '.html.twig' with { 'segments': child.children } %}
    {% endfor %}
{% endset %}

{#- Real Bootstrap 5 Offcanvas: Bootstrap's own JS (loaded above) drives
   show/hide/backdrop/focus-trap/Escape via the header toggle button's
   data-bs-toggle="offcanvas" / data-bs-target="#g-offcanvas" (see
   page.html.twig). No custom drag/slide JS. Note this is a narrower
   drawer-over-content panel (Bootstrap's default), not the previous
   full-viewport push-the-page panel — see BOOTSTRAP_MIGRATION_ROADMAP.md
   Stage 3 for context. Touch-swipe-to-open/close is not reimplemented;
   Bootstrap has no built-in equivalent. #}
<div id="g-offcanvas" class="offcanvas {{ bs_side }}{{ segment.attributes.class ? ' ' ~ segment.attributes.class|e }}" tabindex="-1" aria-label="Offcanvas" data-g-menu-breakpoint="{{ genesis.config.get('styles.breakpoints.mobile-menu-breakpoint')|default('48rem') }}"{{- attr_extra|raw }}>
    <div class="offcanvas-header">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
    </div>
    <div class="offcanvas-body">
        {{ offcanvas|raw -}}
        {# Bootstrap owns the host. Avoid duplicating the compatibility mount
           point rendered by older saved outlines. #}
        {% if 'id="g-mobilemenu-container"' not in offcanvas and "id='g-mobilemenu-container'" not in offcanvas %}
        <div id="g-mobilemenu-container" class="g-mobilemenu" data-g-menu-breakpoint="{{ genesis.config.get('styles.breakpoints.mobile-menu-breakpoint')|default('48rem') }}"></div>
        {% endif %}
    </div>
</div>
