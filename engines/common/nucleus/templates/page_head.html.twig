{%- do genesis.debugger.assets() -%}
{%- do genesis.theme.loadAtoms() -%}

{% set faEnabled = genesis.config.page.fontawesome.enable|default(1) %}
{% set lucideEnabled = genesis.config.page.lucide.enable|default(1) %}
{% set tablerEnabled = genesis.config.page.tabler.enable|default(1) %}
{% set faVersion = genesis.config.page.fontawesome.version ?? genesis.config.page.fontawesome.default_version ?? 'fa7css' %}
{% set faVersion = faVersion == 'fa4' ? 'fa7css' : faVersion %}

{% assets with { priority: 10 } %}
    {% block head_stylesheets -%}
        <link rel="stylesheet" href="genesis-engine://css-compiled/nucleus.css" type="text/css"/>
        {% for scss in genesis.theme.configuration.css.persistent|default(genesis.theme.configuration.css.files|default([])) %}
        <link rel="stylesheet" href="{{ scss }}.scss" type="text/css"/>
        {%- endfor %}
    {% endblock -%}

    {% block head_scripts -%}
    {% if faEnabled %}
        {% if faVersion == 'manual' or genesis.config.page.fontawesome.html_js_import|trim %}
            {{ genesis.config.page.fontawesome.html_js_import|html|raw -}}
        {% elseif faVersion == 'fa5js' %}
            <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome5-all.min.js') }}"></script>
            {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome5-shim.min.js') }}"></script>
            {% endif %}
        {% elseif faVersion == 'fa6js' %}
            <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome6-all.min.js') }}"></script>
            {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome6-shim.min.js') }}"></script>
            {% endif %}
        {% elseif faVersion == 'fa7js' %}
            <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome7-all.min.js') }}"></script>
            {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                <script type="text/javascript" src="{{ url('genesis-assets://js/font-awesome7-shim.min.js') }}"></script>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock -%}

    {% block head_platform %}{% endblock %}

   {% block head_overrides -%}
        {% if lucideEnabled %}
            <link rel="stylesheet" href="genesis-assets://css/lucide-icons.css" type="text/css">
        {% endif %}
        {% if tablerEnabled %}
            <link rel="stylesheet" href="genesis-assets://css/tabler-icons.css" type="text/css">
            <link rel="stylesheet" href="genesis-assets://css/tabler-icons-filled.css" type="text/css">
        {% endif %}
        {% if faEnabled %}
            {% if faVersion == 'manual' or genesis.config.page.fontawesome.html_css_import|trim %}
                {{ genesis.config.page.fontawesome.html_css_import|html|raw -}}
            {% elseif faVersion == 'fa5css' %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome5-all.min.css" type="text/css">
                {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                    <link rel="stylesheet" href="genesis-assets://css/font-awesome5-shim.min.css" type="text/css">
                {% endif %}
            {% elseif faVersion == 'fa6css' %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome6-all.min.css" type="text/css">
                {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                    <link rel="stylesheet" href="genesis-assets://css/font-awesome6-shim.min.css" type="text/css">
                {% endif %}
            {% elseif faVersion == 'fa7css' %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome7-all.min.css" type="text/css">
                {% if genesis.config.page.fontawesome.fa4_compatibility|default(1) %}
                    <link rel="stylesheet" href="genesis-assets://css/font-awesome7-shim.min.css" type="text/css">
                {% endif %}
            {% elseif faVersion == 'fa5js' and (genesis.config.page.fontawesome.content_compatibility|default(1)) %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome5-pseudo.min.css" type="text/css">
            {% elseif faVersion == 'fa6js' and (genesis.config.page.fontawesome.content_compatibility|default(1)) %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome6-pseudo.min.css" type="text/css">
            {% elseif faVersion == 'fa7js' and (genesis.config.page.fontawesome.content_compatibility|default(1)) %}
                <link rel="stylesheet" href="genesis-assets://css/font-awesome7-pseudo.min.css" type="text/css">
            {% endif %}
        {% endif %}
        {% for scss in genesis.theme.configuration.css.overrides|default([]) %}
            <link rel="stylesheet" href="{{ scss }}.scss" type="text/css"/>
        {%- endfor %}
    {% endblock -%}
{% endassets -%}

<head>
    {{ genesis.document.getHtml('head_top')|join("\n    ")|raw }}
    {% block head_meta %}
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        {% if genesis.config.page.head.meta -%}
            {% for attributes in genesis.config.page.head.meta -%}
                {%- for key, value in attributes %}
                    {% if key starts with 'og:' %}
                    <meta property="{{ key|e }}" content="{{ value|e }}" />
                    {% else %}
                    <meta name="{{ key|e }}" content="{{ value|e }}" />
                    {% endif %}
                {% endfor -%}
            {%- endfor -%}
        {%- endif -%}
        {{ genesis.document.getHtml('head_meta')|join("\n    ")|raw }}

        {% if genesis.config.page.assets.favicon %}
        <link rel="icon" type="image/x-icon" href="{{ url(genesis.config.page.assets.favicon) }}" />
        {% endif %}

        {% if genesis.config.page.assets.touchicon %}
        <link rel="apple-touch-icon" sizes="180x180" href="{{ url(genesis.config.page.assets.touchicon) }}">
        <link rel="icon" sizes="192x192" href="{{ url(genesis.config.page.assets.touchicon) }}">
        {% endif %}
    {% endblock %}

    {%- block head_title -%}
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>Title</title>
    {%- endblock %}

    {% block head_application -%}
        {{ genesis.styles('head')|join("\n")|raw }}
        {{ genesis.scripts('head')|join("\n")|raw }}
    {%- endblock %}

    {% block head_ie_stylesheets -%}
    {% endblock -%}

    {% block head %}{% endblock -%}
    {% block head_custom %}
        {% if genesis.config.page.head.head_bottom %}
        {{ genesis.config.page.head.head_bottom|raw }}
        {% endif %}
    {% endblock -%}
    {{ genesis.document.getHtml('head_bottom')|join("\n    ")|raw }}
</head>
