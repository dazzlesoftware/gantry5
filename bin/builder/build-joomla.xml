<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE project>
<project name="genesis-joomla" basedir="." description="Phing Build Script" default="prod">
    <xmlproperty file="${path.platforms}/joomla/${cfg.prefix}${cfg.name}.xml" collapseAttributes="true" prefix="xml" keepRoot="false" />

    <!-- Genesis compatibility packages -->
    <target name="build-joomla-installer">
        <echo message="Building Installer.." />

        <!-- Copy files needed by the installer -->
        <copy file="${path.platforms}/joomla/pkg_genesis.xml" todir="${build_dir}/distribution" overwrite="true">
            <filterchain refid="filter"/>
        </copy>

        <copy file="${path.platforms}/joomla/install.php" todir="${build_dir}/distribution" overwrite="true">
            <filterchain refid="filter"/>
        </copy>

        <copy todir="${build_dir}/distribution/language" overwrite="true">
            <fileset dir="${path.platforms}/joomla/language"/>
        </copy>

        <copy file="${project_dir}/README.md" tofile="${build_dir}/distribution/README.md" overwrite="true">
            <filterchain refid="filter"/>
        </copy>
    </target>

    <target name="build-joomla-component" depends="build-joomla-installer">
        <echo message="Building Component..." />

        <!-- Phing's copy task does not reliably create a missing multi-level
             destination path on Windows. Create the parents explicitly. -->
        <mkdir dir="${tmp_dir}/packages/com_genesis/site" />
        <mkdir dir="${tmp_dir}/packages/com_genesis/admin" />

        <copy todir="${tmp_dir}/packages/com_genesis/site" overwrite="true">
            <fileset dir="${path.platforms}/joomla/com_genesis/site"/>
        </copy>

        <copy todir="${tmp_dir}/packages/com_genesis/admin" overwrite="true">
            <fileset dir="${path.platforms}/common">
                <exclude name=".sass-cache/"/>
                <exclude name="application/"/>
                <exclude name="node_modules/"/>
                <exclude name="gulpfile.js"/>
                <exclude name="package.json"/>
                <exclude name="scss.sh"/>
                <exclude name="**/*.js.map"/>
                <exclude name="**/*.css.map"/>
            </fileset>
            <fileset dir="${path.platforms}/joomla/com_genesis/admin">
                <exclude name=".sass-cache/"/>
                <exclude name="common/"/>
                <exclude name="gulpfile.js"/>
                <exclude name="package.json"/>
                <exclude name="scss.sh"/>
                <exclude name="**/*.js.map"/>
                <exclude name="**/*.css.map"/>
            </fileset>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/com_genesis/admin" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/com_genesis/admin">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <move todir="${tmp_dir}/packages/com_genesis" overwrite="true">
            <fileset dir="${tmp_dir}/packages/com_genesis/admin">
                <include name="genesis.xml"/>
            </fileset>
        </move>

        <!-- Generate Manifest files -->
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/com_genesis/site" />
        </phingcall>
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/com_genesis/admin" />
        </phingcall>
    </target>

    <target name="build-joomla-library" depends="build-joomla-installer">
        <echo message="Building Library.." />

        <copy todir="${tmp_dir}/packages/lib_genesis" overwrite="true">
            <fileset dir="${path.platforms}/joomla/lib_genesis">
                <exclude name="src/"/>
                <exclude name="vendor/"/>
                <exclude name="compat/"/>
            </fileset>
        </copy>

        <copy todir="${tmp_dir}/packages/lib_genesis/src" overwrite="true">
            <filterchain refid="filter" />
            <fileset dir="${path.src}">
                <include name="*.php"/>
            </fileset>
        </copy>

        <copy todir="${tmp_dir}/packages/lib_genesis/src/classes" overwrite="true">
            <fileset dir="${path.src}/classes">
                <exclude name="Leafo/"/>
            </fileset>
        </copy>

        <copy todir="${tmp_dir}/packages/lib_genesis/src" overwrite="true">
            <fileset dir="${path.src}/platforms/joomla"/>
        </copy>

        <copy todir="${tmp_dir}/packages/lib_genesis/vendor" overwrite="true">
            <fileset dir="${path.platforms}/joomla/lib_genesis/vendor">
                <exclude name="bin/"/>
                <exclude name="**/test/"/>
                <exclude name="**/tests/"/>
                <exclude name="**/Tests/"/>
                <exclude name="**/doc/"/>
                <exclude name="**/docs/"/>
                <exclude name="**/phpdoc.xml"/>
                <exclude name="**/phpdocs-md"/>
                <exclude name="**/examples/"/>
                <exclude name="**/ext/"/>
                <exclude name="**/bin/"/>
                <exclude name="**/site/"/>
                <exclude name="**/.github/"/>
                <exclude name="**/.mailmap"/>
                <exclude name="**/.*.yml"/>
                <exclude name="**/.editor*"/>
                <exclude name="**/phpcs.xml*"/>
                <exclude name="**/.php_cs*"/>
                <exclude name="**/phpunit.xml*"/>
                <exclude name="**/phpunit-nocover.xml"/>
                <exclude name="**/*.md"/>
                <exclude name="**/*.rst"/>
                <exclude name="**/*.sh"/>
                <exclude name="**/readme.txt"/>
                <exclude name="**/CHANGELOG*"/>
                <exclude name="**/LICENSE*"/>
                <exclude name="**/Makefile"/>
                <exclude name="**/todo"/>
                <exclude name="**/composer.lock"/>
                <exclude name="filp/whoops/src/deprecated"/>
            </fileset>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/lib_genesis" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/lib_genesis">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <!-- Common assets -->
        <copy todir="${tmp_dir}/packages/lib_genesis/assets" overwrite="true">
            <fileset dir="${path.assets}/common">
                <exclude name="application/**"/>
                <exclude name="**/*.js.map"/>
                <exclude name="**/*.css.map"/>
                <exclude name="**/*.sh"/>
                <exclude name="node_modules/"/>
                <exclude name="gulpfile.js"/>
                <exclude name="package.json"/>
            </fileset>
            <fileset dir="${path.assets}/joomla">
                <exclude name="**/*.js.map"/>
                <exclude name="**/*.css.map"/>
                <exclude name="**/*.sh"/>
                <exclude name="node_modules/"/>
                <exclude name="gulpfile.js"/>
                <exclude name="package.json"/>
            </fileset>
        </copy>

        <!-- Generate Manifest files -->
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/lib_genesis" />
        </phingcall>
    </target>

    <target name="build-joomla-nucleus" depends="build-joomla-installer">
        <echo message="Building Nucleus.." />

        <copy todir="${tmp_dir}/packages/genesis_nucleus" overwrite="true">
            <fileset dir="${path.engines}/common">
                <exclude name="**/*.sh"/>
                <exclude name="**/.sass-cache/"/>
                <exclude name="**/node_modules/"/>
                <exclude name="**/gulpfile.js"/>
                <exclude name="**/package.json"/>
                <exclude name="**/scss.sh"/>
                <exclude name="**/*.js.map"/>
                <exclude name="**/*.css.map"/>
            </fileset>
            <fileset dir="${path.engines}/joomla">
                <exclude name="**/*.sh"/>
            </fileset>
            <fileset dir="${path.platforms}/joomla/genesis_nucleus"/>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/genesis_nucleus" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/genesis_nucleus">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <!-- Generate Manifest files -->
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/genesis_nucleus/nucleus" />
        </phingcall>
    </target>

    <target name="build-joomla-plugins" depends="build-joomla-installer">
        <echo message="Building Plugins.." />

        <copy todir="${tmp_dir}/packages/plg_system_genesis" overwrite="true">
            <fileset dir="${path.platforms}/joomla/plg_system_genesis"/>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/plg_system_genesis" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/plg_system_genesis">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <copy todir="${tmp_dir}/packages/plg_quickicon_genesis" overwrite="true">
            <fileset dir="${path.platforms}/joomla/plg_quickicon_genesis"/>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/plg_quickicon_genesis" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/plg_quickicon_genesis">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <copy todir="${tmp_dir}/packages/plg_genesis_preset" overwrite="true">
            <fileset dir="${path.platforms}/joomla/plg_genesis_preset"/>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/plg_genesis_preset" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/plg_genesis_preset">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <echo message="Building Modules.." />

        <copy todir="${tmp_dir}/packages/mod_genesis_particle" overwrite="true">
            <fileset dir="${path.platforms}/joomla/mod_genesis_particle"/>
        </copy>

        <!-- Add version information to all xml files -->
        <copy todir="${tmp_dir}/packages/mod_genesis_particle" overwrite="true">
            <filterchain refid="filter"/>
            <fileset dir="${path.platforms}/joomla/mod_genesis_particle">
                <include name="*.xml"/>
            </fileset>
        </copy>

        <!-- Generate Manifest files -->
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/plg_system_genesis" />
        </phingcall>
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/plg_quickicon_genesis" />
        </phingcall>
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/plg_genesis_preset" />
        </phingcall>
        <phingcall target="checksum">
            <property name="source" value="${tmp_dir}/packages/mod_genesis_particle" />
        </phingcall>
    </target>

    <!-- Build Themes -->
    <target name="build-joomla-themes" depends="build-joomla-installer">
        <echo message="Building Themes.." />

        <!-- Process all themes -->
        <foreach param="directory" target="build-joomla-theme">
            <fileset dir="${path.themes}">
                <type type="dir" />
                <depth max="0" min="0" />
            </fileset>
        </foreach>
    </target>

    <target name="build-joomla-theme">
        <echo message="Building Theme ${directory}.." />

        <if>
            <available file='${path.themes}/${directory}/joomla/genesis/theme.yaml' type='file' />
            <then>
                <copy todir="${tmp_dir}/templates/tpl_${directory}" overwrite="true">
                    <fileset dir="${path.themes}/${directory}/common">
                        <exclude name="custom/**"/>
                    </fileset>
                </copy>

                <copy todir="${tmp_dir}/templates/tpl_${directory}" overwrite="true">
                    <fileset dir="${path.themes}/${directory}/joomla">
                        <exclude name="common/**"/>
                        <exclude name="custom/**"/>
                    </fileset>
                </copy>

                <!-- Add version information to all xml files -->
                <copy todir="${tmp_dir}/templates/tpl_${directory}" overwrite="true">
                    <filterchain refid="filter"/>
                    <fileset dir="${path.themes}/${directory}/joomla">
                        <include name="**/*.xml"/>
                        <include name="genesis/theme.yaml"/>
                        <include name="install.php"/>
                    </fileset>
                </copy>

                <!-- Generate Manifest files -->
                <phingcall target="checksum">
                    <property name="source" value="${tmp_dir}/templates/tpl_${directory}" />
                </phingcall>

                <!-- Zip the created Zips for packages -->
                <phingcall target="archive">
                    <property name="destination.file" value="${package_dir}/joomla-tpl_${directory}${str.fileversion}" />
                    <property name="base.directory" value="${tmp_dir}/templates/tpl_${directory}" />
                </phingcall>
            </then>
        </if>
    </target>

    <!-- Package -->
    <target name="joomla-package">
        <!-- Process all prepared packages -->
        <foreach param="directory" target="joomla-package-process">
            <fileset dir="${tmp_dir}/packages/">
                <type type="dir" />
                <depth max="0" min="0" />
            </fileset>
        </foreach>

        <!-- Zip the created Zips for packages -->
        <phingcall target="archive">
            <property name="destination.file" value="${package_dir}/joomla-${cfg.prefix}${cfg.name}${str.fileversion}" />
            <property name="base.directory" value="${build_dir}/distribution" />
        </phingcall>
    </target>

    <target name="joomla-package-process">
        <phingcall target="archive">
            <property name="destination.file" value="${build_dir}/distribution/packages/${directory}${str.version}" />
            <property name="base.directory" value="${tmp_dir}/packages/${directory}" />
        </phingcall>
    </target>
</project>
