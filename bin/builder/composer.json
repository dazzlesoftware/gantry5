{
    "require": {
        "php": ">=8.3.0",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-mbstring": "*",
        "phing/phing": "3.1.2",
        "guzzlehttp/guzzle": "^7.7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "classmap": ["classes/"]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phing/phing-composer-configurator": true
        }
    }
}
