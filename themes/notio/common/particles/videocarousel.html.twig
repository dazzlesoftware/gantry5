{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}

    {% set navigationEnabled = particle.nav|default('enabled') == 'enabled' %}
    {% set paginationId = 'g-video-carousel-pagination-' ~ id %}

    <div class="{{ particle.class|e }} g-swipercarousel-video-carousel">
        <div class="g-swipercarousel-video-carousel-header">
            {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
            <div id="{{ paginationId|e }}" class="g-video-carousel-pagination swiper-pagination"></div>
        </div>

        {% if particle.description %}<div class="g-video-carousel-description">{{ particle.description|raw }}</div>{% endif %}

        <div
            id="g-video-carousel-{{ id }}"
            class="g-video-carousel swiper"
            data-g-swiper
            data-slides-per-view="2"
            data-navigation="{{ particle.nav|default('enabled')|e }}"
            data-pagination="enabled"
            data-pagination-selector="#{{ paginationId|e }}"
            data-loop="{{ particle.loop|default('enabled')|e }}"
            data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
            data-autoplay-delay="{{ particle.autoplaySpeed|default('5000')|e }}"
            data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
            data-speed="{{ particle.transitionSpeed|default('500')|e }}"
            data-effect="slide"
            data-previous-label="Previous video"
            data-next-label="Next video"
        >
            {% for item in particle.items|default([]) %}
                {% set videoTitle = item.caption|default(particle.title|default('Video')) %}
                <div class="g-video-carousel-inner">
                    <div
                        id="g-{{ id }}-{{ loop.index }}"
                        class="g-video-carousel-video"
                        data-video-controller
                        data-video-autoplay="{{ item.autoplay == 'enabled' ? 'true' : 'false' }}"
                    >
                        {% if item.source == 'vimeo' %}
                            {% set vimeoId = item.video|replace({'https://vimeo.com/ondemand/': '', 'https://vimeo.com/': ''}) %}
                            <iframe
                                width="100%"
                                src="https://player.vimeo.com/video/{{ vimeoId|e('html_attr') }}?api=1&amp;autoplay={{ item.autoplay == 'enabled' ? 1 : 0 }}&amp;loop={{ item.loop == 'enabled' ? 1 : 0 }}&amp;muted={{ item.muted == 'enabled' ? 1 : 0 }}"
                                data-video-provider="vimeo"
                                title="{{ videoTitle|e('html_attr') }}"
                                allow="autoplay; fullscreen; picture-in-picture"
                                loading="lazy"
                                allowfullscreen
                            ></iframe>
                        {% endif %}

                        {% if item.source == 'youtube' %}
                            {% set youtubeId = item.video|replace({'https://www.youtube.com/watch?v=': '', 'http://www.youtube.com/watch?v=': '', 'https://youtu.be/': '', 'http://youtu.be/': ''}) %}
                            <iframe
                                width="100%"
                                src="https://www.youtube.com/embed/{{ youtubeId|e('html_attr') }}?enablejsapi=1&amp;showinfo={{ item.info == 'enabled' ? 1 : 0 }}&amp;autoplay={{ item.autoplay == 'enabled' ? 1 : 0 }}&amp;controls={{ item.controls == 'enabled' ? 1 : 0 }}{% if item.loop == 'enabled' %}&amp;loop=1&amp;playlist={{ youtubeId|e('html_attr') }}{% endif %}&amp;rel={{ item.related == 'enabled' ? 1 : 0 }}&amp;mute={{ item.muted == 'enabled' ? 1 : 0 }}"
                                data-video-provider="youtube"
                                title="{{ videoTitle|e('html_attr') }}"
                                allow="autoplay; encrypted-media; picture-in-picture"
                                loading="lazy"
                                allowfullscreen
                            ></iframe>
                        {% endif %}

                        {% if item.source in ['local', 'external'] %}
                            <video
                                width="100%"
                                {% if item.autoplay == 'enabled' %}autoplay{% endif %}
                                {% if item.posterimage %}poster="{{ url(item.posterimage)|e }}"{% endif %}
                                {% if item.loop == 'enabled' %}loop{% endif %}
                                {% if item.controls == 'enabled' %}controls{% else %}class="g-video-nocontrols"{% endif %}
                                {% if item.muted == 'enabled' %}muted{% endif %}
                                data-video-autoplay="{{ item.autoplay == 'enabled' ? 'true' : 'false' }}"
                                preload="metadata"
                                playsinline
                            >
                                {% if item.source == 'local' %}
                                    {% for source in item.local|default([]) %}
                                        <source src="{{ url(source.file)|e }}" type="video/{{ source.file|slice(-4)|replace({'.': ''})|e('html_attr') }}">
                                    {% endfor %}
                                {% else %}
                                    <source src="{{ item.video|e }}" type="video/{{ item.video|slice(-4)|replace({'.': ''})|e('html_attr') }}">
                                {% endif %}
                            </video>

                            {% if item.controls != 'enabled' %}
                                <div
                                    class="g-video-carousel-local-play g-videolocal-play{% if item.autoplay == 'enabled' %} pause{% endif %}"
                                    role="button"
                                    tabindex="0"
                                    aria-label="{{ item.autoplay == 'enabled' ? 'Pause video' : 'Play video' }}"
                                ></div>
                            {% endif %}
                        {% endif %}
                    </div>

                    {% if item.caption %}
                        <div class="g-video-carousel-caption">{{ item.caption|raw }}</div>
                    {% endif %}
                </div>
            {% endfor %}

            {% if navigationEnabled %}
                <div class="swiper-navigation">
                    <button class="swiper-button-prev" type="button" aria-label="Previous video">
                        {{ particle.prevText|default('<i class="fa fa-chevron-circle-left" aria-hidden="true"></i>')|raw }}
                    </button>
                    <button class="swiper-button-next" type="button" aria-label="Next video">
                        {{ particle.nextText|default('<i class="fa fa-chevron-circle-right" aria-hidden="true"></i>')|raw }}
                    </button>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
    {% do gantry.document.addScript(url('gantry-assets://js/video.js'), 12, 'footer') %}
{% endblock %}
