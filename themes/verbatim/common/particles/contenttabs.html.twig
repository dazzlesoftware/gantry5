{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}

    <div class="{{ particle.class|e }}">
        {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}

        <div class="g-contenttabs">
            <div id="g-contenttabs-{{ id }}" class="g-contenttabs-container">
                <ul class="g-contenttabs-tab-wrapper-container">

                    {% for item in particle.items %}
                        <li class="g-contenttabs-tab-wrapper">
                            <span class="g-contenttabs-tab-wrapper-head">
                                <a class="g-contenttabs-tab" href="#g-contenttabs-item-{{ loop.index }}">
                                    <span class="g-contenttabs-tab-title">{{ item.title|html|raw }}</span>
                                </a>
                            </span>
                        </li>
                    {% endfor %}

                </ul>

                <ul class="g-contenttabs-content-wrapper-container">

                    {% for item in particle.items %}
                        <li class="g-contenttabs-tab-wrapper">
                            <div class="g-contenttabs-tab-wrapper-body">
                                <div id="g-contenttabs-item-{{ loop.index }}" class="g-contenttabs-content">

                                    <div class="genesis-row">
                                        {% if item.image %}
                                        <div class="genesis-width-25">
                                            <div class="genesis-width-spacer"><img alt="image" src="{{ url(item.image)|e }}"></div>
                                        </div>
                                        {% endif %}
                                        <div class="genesis-width-{% if item.image and item.rheading %}50{% elseif item.image or item.rheading %}75{% else %}100{% endif %}">
                                            <div class="genesis-width-spacer">
                                                <h4>{{ item.heading|html|raw }}</h4>
                                                {{ item.content|html|raw }}
                                            </div>
                                        </div>
                                        {% if item.rheading %}
                                        <div class="genesis-width-25">
                                            <div class="genesis-width-spacer genesis-right genesis-text-right">
                                                <h4 class="nomarginbottom">{{ item.rheading|html|raw }}</h4>
                                                {% if item.smalltext %}<p class="rt-text-small"><em>{{ item.smalltext|html|raw }}</em></p>{% endif %}
                                                {% if item.link %}<p><a class="{{ item.buttonclass|e }}" href="{{ item.link|e }}" target="{{ item.buttontarget|default('_self')|e }}">{{ item.linklabel|html|raw }}</a></p>{% endif %}
                                            </div>
                                        </div>
                                        {% endif %}
                                    </div>
                                    <div class="clear"></div>

                                    {% if item.content2 or item.heading2 %}
                                    <hr>
                                    <div class="genesis-row">
                                        {% if item.image2 %}
                                        <div class="genesis-width-25">
                                            <div class="genesis-width-spacer"><img alt="image" src="{{ url(item.image2)|e }}"></div>
                                        </div>
                                        {% endif %}
                                        <div class="genesis-width-{% if item.image2 and item.rheading2 %}50{% elseif item.image2 or item.rheading2 %}75{% else %}100{% endif %}">
                                            <div class="genesis-width-spacer">
                                                <h4>{{ item.heading2|html|raw }}</h4>
                                                {{ item.content2|html|raw }}
                                            </div>
                                        </div>
                                        {% if item.rheading2 %}
                                        <div class="genesis-width-25">
                                            <div class="genesis-width-spacer genesis-right genesis-text-right">
                                                <h4 class="nomarginbottom">{{ item.rheading2|html|raw }}</h4>
                                                {% if item.smalltext2 %}<p class="rt-text-small"><em>{{ item.smalltext2|html|raw }}</em></p>{% endif %}
                                                {% if item.link2 %}<p><a class="{{ item.buttonclass2|e }}" href="{{ item.link2|e }}" target="{{ item.buttontarget2|default('_self')|e }}">{{ item.linklabel2|html|raw }}</a></p>{% endif %}
                                            </div>
                                        </div>
                                        {% endif %}
                                    </div>
                                    <div class="clear"></div>
                                    {% endif %}

                                </div>
                            </div>
                        </li>
                    {% endfor %}

                </ul>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascript_footer %}
<script>
(() => {
    const tabs = document.getElementById('{{ id }}');
    if (!tabs || tabs.dataset.tabsReady) return;
    tabs.dataset.tabsReady = 'true';
    const links = [...tabs.querySelectorAll('.g-contenttabs-tab')];
    const panels = links.map((link) => tabs.querySelector(link.hash));

    const select = (selected, focus = false) => {
        links.forEach((link, index) => {
            const active = index === selected;
            link.setAttribute('role', 'tab');
            link.setAttribute('aria-selected', String(active));
            link.tabIndex = active ? 0 : -1;
            link.closest('li')?.classList.toggle('ui-tabs-active', active);
            if (panels[index]) {
                panels[index].hidden = !active;
                panels[index].setAttribute('role', 'tabpanel');
            }
        });
        if (focus) links[selected]?.focus();
    };

    links.forEach((link, index) => {
        link.addEventListener('click', (event) => {
            event.preventDefault();
            select(index);
        });
        link.addEventListener('keydown', (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            let target = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1
                : (index + (event.key === 'ArrowRight' ? 1 : -1) + links.length) % links.length;
            select(target, true);
        });
    });
    tabs.querySelector('.g-contenttabs-tab-wrapper-container')?.setAttribute('role', 'tablist');
    select(0);
})();
</script>
{% endblock %}
