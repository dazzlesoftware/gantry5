{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
<div class="{{ particle.class|e }}">

  <div class="g-offsidebar-toggle">
    <i class="g-offsidebar-toggle-icon {{ particle.icon|e }}"></i>
  </div>

</div>
{% endblock %}

{% block javascript_footer %}
<script type="text/javascript">
{% if particle.type == "slidedown" %}
document.addEventListener('DOMContentLoaded', function () {
  document.body.classList.add('g-offsidebar-open-slidedown');
});
{% elseif particle.type == "pushpage" %}
document.addEventListener('DOMContentLoaded', function () {
  var offSidebar = document.querySelector('#g-offsidebar');
  if (offSidebar && offSidebar.parentElement) offSidebar.parentElement.after(offSidebar);
  document.body.classList.add('g-offsidebar-open-pushpage');
  document.querySelectorAll('.g-offsidebar-toggle-icon').forEach(function (toggle) { toggle.addEventListener('click', function () {
    document.body.classList.toggle('g-body-pushed');
  }); });
  document.querySelector('#g-offsidebar-overlay')?.addEventListener('click', function() {
    Object.assign(this.style, { opacity: '0', zIndex: '-1' });
    document.body.classList.toggle('g-body-pushed');
  });
});
{% endif %}
</script>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
  var sidebar = document.querySelector('#g-offsidebar');
  var overlay = document.querySelector('#g-offsidebar-overlay');
  document.querySelectorAll('.g-offsidebar-toggle-icon').forEach(function (toggle) { toggle.addEventListener('click', function () {
    sidebar?.classList.toggle('g-offsidebar-open');
    if (overlay) Object.assign(overlay.style, { opacity: '1', zIndex: '10002' });
  }); });
  overlay?.addEventListener('click', function () {
    Object.assign(overlay.style, { opacity: '0', zIndex: '-1' });
    sidebar?.classList.remove('g-offsidebar-open');
  });
});
</script>

{% endblock %}
