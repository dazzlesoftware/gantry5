{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    <div class="g-slideshow-wrapper">
        <style scoped>
            #{{ id }} .g-slideshow-slider {
                height: {{ particle.height|default('85vh') }};
            }

            @media only all and (max-width: {{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}) {
                #{{ id }} .g-slideshow-slider {
                    height: {{ particle.heightMobile|default('500px') }} !important;
                }
            }
        </style>

        <div id="{{ id }}" class="g-slideshow swiper-container {{ particle.class|e }}" data-slideshow-id="{{ id }}" data-slideshow-effect="{{ particle.effect }}" data-slideshow-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slideshow-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-direction="{{ particle.direction }}" data-slideshow-timeout="{{ particle.autoplayTimeout }}" data-slideshow-speed="{{ particle.speed }}" data-slideshow-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %}>
            <div class="g-slideshow-slider swiper-wrapper">
                {% if not particle.source or particle.source == 'particle' %}
                    {% for item in particle.items %}
                        <div class="swiper-slide {{ item.class|e }}">
                            <div class="slide">
                                <div class="slide-content">
                                    <div class="content-background" style="background-image: url({{ url(item.image)|e }});"></div>

                                    <div class="content-left">
                                        {% if item.main_title %}
                                            <h1 class="g-slideshow-main-title">
                                                {% if item.link %}
                                                    <a href="{{ item.link }}" target="{{ item.linktarget|default('_self') }}">{{ item.main_title|raw }}</a>
                                                {% else %}
                                                    {{ item.main_title|raw }}
                                                {% endif %}
                                            </h1>
                                        {% endif %}

                                        {% if item.description1 %}
                                            <div class="g-slideshow-description1">
                                                {{ item.description1|raw }}
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="content-right">
                                        {% if item.description2 %}
                                            <div class="g-slideshow-description2">
                                                {{ item.description2|raw }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    {% include '@particles/slideshow-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
                {% endif %}
            </div>

            {% if particle.arrows == 'enabled' %}
                {% if genesis.page.direction == 'rtl' %}
                    <div class="navigation rtl">
                        <div class="swiper-button-next">
                            <i class="fa fa-angle-left"></i>
                        </div>
                        <div class="swiper-button-prev">
                            <i class="fa fa-angle-right"></i>
                        </div>
                    </div>
                {% else %}
                    <div class="navigation">
                        <div class="swiper-button-next">
                            <i class="fa fa-angle-right"></i>
                        </div>
                        <div class="swiper-button-prev">
                            <i class="fa fa-angle-left"></i>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {# pagination #}
            {% if particle.bullets|default('enabled') == 'enabled' %}
                <div class="swiper-pagination"></div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="gantry-theme://css/swiper.css" />
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-theme://js/swiper.min.js'), 10, 'footer') %}
    {% do genesis.document.addScript(url('gantry-theme://js/slideshow.init.js'), 10, 'footer') %}
{% endblock %}
