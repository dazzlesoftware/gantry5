{% extends '@nucleus/partials/particle.html.twig' %}

{% block stylesheets %}
<style>
    .active .bg-image-container .g-swipercarousel-content {
        animation-name: {{ particle.contentanimation|default('fadeIn') }};
    }
</style>
{% endblock %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div class="{{ particle.class|e }}">

            <div class="g-swipercarousel-slideshow">

                <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                    {% for item in particle.items %}
                    <div class="g-swipercarousel-item-{{ loop.index }} {{ item.class|e }}">

                        <div class="bg-image-container" style="background-image: url({{ url(item.bgimage) }});">

                            <div class="g-container">

                                <div class="g-swipercarousel-content">
                                    {% if item.position == "top" or item.position == "left" %}
                                        <div class="g-swipercarousel-image-container {{ item.position }} {{ item.imageclass }}">
                                            <img src="{{ url(item.image)|e }}" />
                                        </div>
                                    {% endif %}

                                    {% if item.title or item.desc or item.link %}
                                        <div class="g-swipercarousel-text {{ item.position }}" style="text-align: {{ item.textalign|default('left') }}">

                                                {% if item.title %}{% if item.linktitle =="enabled" %}<h2 class="g-swipercarousel-item-title"><a target="{{ item.buttontarget|default('_self')|e }}" href="{{ item.link|e }}">{{ item.title|html|raw }}</a></h2>{% else %}<h2 class="g-swipercarousel-item-title">{{ item.title|html|raw }}</h2>{% endif %}{% endif %}

                                                {% if item.desc or item.link %}
                                                    <div class="g-swipercarousel-item-desc">
                                                        {% if item.desc %}<div>{{ item.desc|html|raw }}</div>{% endif %}

                                                        {% if item.link %}
                                                            <div class="g-swipercarousel-item-link">
                                                                <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button {{ item.buttonclass|default('readon')|e }}" href="{{ item.link|e }}">
                                                                    {{ item.linktext|html|raw|default('Read More') }}
                                                                </a>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                        </div>
                                    {% endif %}

                                    {% if item.position == "bottom" or item.position == "right" %}
                                        <div class="g-swipercarousel-image-container {{ item.position }} {{ item.imageclass }}">
                                            <img src="{{ url(item.image)|e }}" />
                                        </div>
                                    {% endif %}
                                </div>

                            </div>

                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
