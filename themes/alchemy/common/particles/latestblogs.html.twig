{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    <div class="{{ particle.class|e }} g-latestblogs" data-latestblogs-id="{{ id }}">
        {% if particle.title %}
            <div class="g-latestblogs-grid-item g-latestblogs-title g-title">
                {% if particle.uppertitle %}
                    <span class="g-latestblogs-uppertitle">{{ particle.uppertitle|raw }}</span>
                {% endif %}

                {{ particle.title }}
            </div>
        {% endif %}
        {% if not particle.source or particle.source == 'particle' %}
        <div class="g-latestblogs-grid {{ particle.cols }}">
            <div class="g-latestblogs-grid-sizer"></div>

            {% for item in particle.items %}
                <div class="g-latestblogs-grid-item">
                    <div class="g-latestblogs-grid-item-wrapper g-latestblogs-layout-text ">
                        {% if item.image %}
                            <div class="g-latestblogs-grid-item-image">
                                <img src="{{ url(item.image)|e }}" alt="{{ item.title }}" />
                            </div>
                        {% endif %}

                        <div class="g-latestblogs-grid-item-content">
                                {% if item.title %}
                                    <div class="g-latestblogs-grid-item-title">
                                        {{ item.title|raw }}
                                    </div>
                                {% endif %}
                                {% if item.description %}
                                    <div class="g-latestblogs-grid-item-description">
                                        {{ item.description|raw }}
                                    </div>
                                {% endif %}
                        </div>

                        <a href="{{ item.url }}" target="{{ item.target|default('_blank') }}" class="g-latestblogs-link-overlay"></a>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% else %}
        {% include '@particles/latestblogs-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
        {% endif %}
    </div>
{% endblock %}

{% block javascript_footer %}
    <script src="{{ url('//cdn.polyfill.io/v2/polyfill.min.js?features=default,fetch,Array.prototype.includes') }}"></script>
    <script src="{{ url('genesis-assets://js/native-grid.js') }}"></script>
    <script src="{{ url('genesis-theme://js/latestblogs.init.js') }}"></script>
{% endblock %}
