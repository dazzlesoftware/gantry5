{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% block layout %}

        <div class="{{ particle.class|e }}">

            <div class="g-owlcarousel-slider">

                <div id="g-owlcarousel-{{ id }}" data-owlcarousel-id="g-owlcarousel-{{ id }}" class="g-owlcarousel owl-carousel">

                    {% for item in particle.items %}
                        <div class="g-owlcarousel-item-{{ loop.index }}">

                            <div class="g-owlcarousel-image-container">
                                <img src="{{ url(item.image)|e }}" {% if item.image_alt %}alt="{{ item.image_alt }}"{% endif %} />
                             </div>   

                            {% if item.title or item.desc or item.link %}
                                <div class="g-owlcarousel-content">

                                    <div class="g-owlcarousel-content-wrapper">

                                        {% if item.title %}
                                        <h2 class="g-owlcarousel-item-title">
                                            {% if item.linktitle == "enabled" %}
                                            <a target="{{ item.buttontarget|default('_self')|e }}" href="{{ item.link|e }}">{{ item.title|html|raw }}</a>
                                            {% else %}
                                            {{ item.title|html|raw }}
                                            {% endif %}
                                        </h2>
                                        {% endif %}

                                        {% if item.desc or item.link %}
                                            <div class="g-owlcarousel-item-desc">
                                                {% if item.desc %}<div>{{ item.desc|html|raw }}</div>{% endif %}

                                                {% if item.link %}
                                                    <a target="{{ item.buttontarget|default('_self')|e }}" class="{{ item.buttonclass|default('readon')|e }}" href="{{ item.link|e }}">
                                                        {{ item.linktext|html|raw|default('Read More') }}
                                                    </a>
                                                {% endif %}
                                            </div>  
                                        {% endif %} 
                                    </div>
                                </div>
                            {% endif %}  
                        </div>
                    {% endfor %}
                </div>  
                {% if particle.dots == "thumbs" %}
                    <div class="owl-thumbs">
                        {% for item in particle.items %}
                          <div class="owl-thumb">
                            <img src="{{ url(item.image)|e }}" {% if item.image_alt %}alt="{{ item.image_alt }}"{% endif %} />
                          </div>
                        {% endfor %}
                    </div>
                {% endif %}  
            </div>  
        </div>  

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do gantry.load('jquery') %}
    <script src="{{ url('gantry-theme://js/owl.carousel.min.js') }}"></script>
    <script type="text/javascript">
    jQuery(document).ready(function () {
        var owl = jQuery('#g-owlcarousel-{{ id }}').owlCarousel({
            items: 1,
            rtl: {% if gantry.page.direction == 'rtl' %}true{% else %}false{% endif %},
            {% if particle.animateOut and particle.animateOut != 'default' %}
            animateOut: '{{ particle.animateOut|default('fadeOut')|e }}',
            {% endif %}
            {% if particle.animateIn and particle.animateIn != 'default' %}
            animateIn: '{{ particle.animateIn|default('fadeIn')|e }}',
            {% endif %}
            {% if particle.nav == 'enabled' %}
            nav: true,
            {% else %}
            nav: false,
            {% endif %}
            {% if particle.dots == 'thumbs' %}
            dots: true,
            dotsContainer: '.owl-thumbs',
            {% elseif particle.dots == 'dots' %}
            dots: true,
            {% else %}
            dots: false,
            {% endif %}
            {% if particle.loop == 'enabled' %}
            loop: true,
            {% else %}
            loop: false,
            {% endif %}
            {% if particle.autoplay == 'enabled' %}
            autoplay: true,
            autoplayTimeout: {{ particle.autoplaySpeed|default('5000') }},
            {% if particle.pauseOnHover == 'enabled' %}
            autoplayHoverPause: true,
            {% else %}
            autoplayHoverPause: false,
            {% endif %}
            {% else %}
            autoplay: false,
            {% endif %}
        })

        jQuery('.owl-thumbs').on('click', '.owl-thumb', function(e) {
          owl.trigger('to.owl.carousel', [jQuery(this).index(), 1, true]);
        });
    });
    
    </script>
{% endblock %}
