{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div id="lists" class="{{ particle.class|e }} g-swipercarousel-lists g-swipercarousel-lists-{{ particle.displayitems }}-items"
             data-g-accordion="{{ particle.accordion == 'enabled' ? 'true' : 'false' }}">
            {% if particle.title or particle.description %}
                <div class="row g-grid">
                    <div class="col g-block">
                            {% if particle.title %}<h2 class="title">{{ particle.title|html|raw }}</h2>{% endif %}
                            {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|html|raw }}</div>{% endif %}
                    </div>
                </div>
            {% endif %}

            <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                {% for row in particle.items|batch(particle.displayitems) %}
                    <div class="item">
                        {% for item in row  %}
                            <div class="g-swipercarousel-item">
                                {% if item.title %}
                                    <h4 class="g-swipercarousel-item-title{% if particle.accordion == 'enabled' %} padding{% endif %}">

                                        {{ item.title|html|raw }}

                                        {% if particle.accordion == 'enabled' %}<span class="indicator"><span>+</span></span>{% endif %}
                                    </h4>
                                {% endif %}

                                {% if item.desc %}
                                    <div class="g-swipercarousel-content">

                                        {% if item.desc %}
                                            <div class="g-swipercarousel-item-desc">
                                                {% if item.desc %}<p>{{ item.desc|html|raw }}</p>{% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}

            </div>
        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
