{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
<div class="{{ particle.class|e }} g-swipercarousel-testimonials">

    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

    <div id="g-testimonials-{{ id }}" class="g-testimonials swiper" data-testimonials-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}" data-g-swiper data-slides-per-view="1" data-navigation="{{ particle.nav|default('disabled')|e }}" data-loop="{{ particle.loop|default('disabled')|e }}" data-autoplay="{{ particle.autoplay|default('disabled')|e }}" data-autoplay-delay="{{ particle.autoplaySpeed|default(5000)|e }}" data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}" data-effect="fade">

        {% for item in particle.items %}
        <div class="g-testimonial">

            {% if item.testimonial %}
            <div class="g-testimonial-text">{{ item.testimonial|raw }}</div>
            {% endif %}

            <div class="g-testimonial-info">
                {% if item.image %}
                <img src="{{ url(item.image)|e }}" alt="{{ item.author|e }}" />
                {% endif %}

                {% if item.author %}
                <div class="g-testimonial-author">
                    {{ item.author|raw }}

                    {% if item.position %}
                    <div class="g-testimonial-position">{{ item.position|raw }}</div>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}

    </div>
</div>

{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
