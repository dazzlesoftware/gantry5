{% extends '@nucleus/partials/particle.html.twig' %}
{% do gantry.load('lightcase.init') %}

{% block stylesheets %}
<style>
    .g-bgslideshow-slides {
        padding-top: {{ particle.paddingtop|default('10vh') }};
    }
</style>
{% endblock %}

{% block particle %}
<div id="{{ id }}" class="{{ particle.class|e }}" data-bgslideshow-id="{{ id }}" data-bgslideshow-items="{{ particle.displayitems }}" data-bgslideshow-itemstablet="{{ particle.displayitems_tablet }}" data-bgslideshow-itemsmobile="{{ particle.displayitems_mobile }}" data-bgslideshow-itemssmallmobile="{{ particle.displayitems_smallmobile }}" data-bgslideshow-delay="{{ particle.delay }}" data-vegas-element="{{ particle.element }}" data-bgslideshow-rtl="{% if gantry.page.direction == 'rtl' %}true{% else %}false{% endif %}">
    {% if particle.title %}
        <h2 class="g-title">{{ particle.title|raw }}</h2>
    {% endif %}

    <div id="slides-{{ id }}" class="g-bgslideshow-slides g-owlcarousel owl-carousel" data-bgslideshow-slides-id="{{ id }}">
        {% for item in particle.items %}
            <div>
                <div class="g-bgslideshow-slides-item-title">
                    {{ item.title }}
                </div>
                <div class="g-bgslideshow-slides-item-description">
                    {{ item.description }}
                </div>
                {% if item.link %}
                    <div class="g-bgslideshow-slides-item-link">
                        <a href="{{ item.link }}" class="button button-xlarge">{{ item.linktext }}</a>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <div id="carousel-{{ id }}" class="g-bgslideshow-carousel g-owlcarousel owl-carousel" data-bgslideshow-carousel-id="{{ id }}">
        {% for item in particle.items %}
            <div class="">
                <div class="g-bgslideshow-carousel-image-container">
                    <img src="{{ url(item.image)|e }}" alt="{{ item.alt }}">

                    <div class="g-bgslideshow-carousel-image-hover">
                        {{ item.title }}
                        <a href="{{ url(item.image)|e }}" data-rel="lightcase" title="{{ item.title }}">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}


{% block javascript_footer %}
{% do gantry.load('jquery') %}
<script src="{{ url('gantry-theme://js/vegas.js') }}"></script>
{% do gantry.document.addScript(url('gantry-theme://js/owlcarousel.js'), 10, 'footer') %}
<script src="{{ url('gantry-theme://js/bgslideshow.init.js') }}"></script>
<script type="text/javascript">
jQuery(function() {
    jQuery('{{ particle.element }}').vegas({
        preload: {% if particle.preload == 'enabled' %}true{% else %}false{% endif %},
        timer: false,
        overlay: {% if particle.overlay %}'{{ url(particle.overlay)|e }}'{% else %}false{% endif %},
        autoplay: {% if particle.autoplay == 'enabled' %}true{% else %}false{% endif %},
        loop: {% if particle.loop == 'enabled' %}true{% else %}false{% endif %},
        delay: {{ particle.delay }},
        cover: {% if particle.cover == 'enabled' %}true{% elseif particle.cover == 'disabled' %}false{% else %}'{{ particle.cover }}'{% endif %},
        align: '{{ particle.align }}',
        valign: '{{ particle.valign }}',
        transition: '{{ particle.transition }}',
        transitionDuration: {{ particle.transitionDuration }},
        animation: {% if particle.animation %}'{{ particle.animation }}'{% else %}''{% endif %},
        animationDuration:  '{{ particle.animationDuration }}',
        slides: [
            {% for item in particle.items %}
            { src: '{{ url(item.image)|e }}' },
            {% endfor %}
        ],
    });
});
</script>
{% endblock %}
