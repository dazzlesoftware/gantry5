{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
<div id="{{ id }}" class="g-panelslider {{ particle.class|e }}" data-panelslider-id="{{ id }}" data-panelslider-items="{{ particle.items_amount }}" data-panelslider-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}">
    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

    <div class="g-panelslider-carousel g-swipercarousel swiper" data-panelslider-carousel-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="navigation"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
        {% for panel in particle.items %}
        <div class="tab">
            {% if panel.icon %}
            <i class="{{ panel.icon|e }}"></i>
            {% endif %}
            {% if panel.title %}
            <div class="g-panelslider-carousel-title">
                {{ panel.title }}
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    <div class="g-panelslider-slides g-swipercarousel swiper" data-panelslider-slides-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="main"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
        {% for item in particle.items %}
        <div class="panel">
            <img src="{{ url(item.image)|e }}" alt="{{ item.alt }}">

            <div class="g-panelslider-slides-description">
                <div class="g-panelslider-slides-description-content">
                    {{ item.description }}
                </div>
                {% if item.signature1 or item.signature2 or item.avatar %}
                <div class="g-panelslider-slides-description-footer">
                    {% if item.avatar %}<img src="{{ url(item.avatar)|e }}" alt="{{ item.signature1 }}">{% endif %}
                    <div class="g-panelslider-slides-description-signature">
                        {% if item.signature1 %}
                            <div class="g-panelslider-slides-description-line1">
                                {{ item.signature1 }}
                            </div>
                        {% endif %}
                        {% if item.signature2 %}
                            <div class="g-panelslider-slides-description-line2">
                                {{ item.signature2 }}
                            </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

</div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
