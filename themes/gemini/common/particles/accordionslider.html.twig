{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div class="{{ particle.class|e }} g-swipercarousel-accordionslider g-swipercarousel-accordionslider-{{ particle.displayitems }}-items">
            {% if particle.title or particle.description %}
                <div class="g-grid">
                    <div class="g-block">
                        <div class="g-content g-swipercarousel-header">
                            {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}
                            {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|html|raw }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="g-swipercarousel-accordionslider-header">
                <div id="g-swipercarousel-accordionslider-controls"></div>
                {% if particle.accordionTitle %}<div class="g-swipercarousel-accordionslider-title">{{ particle.accordionTitle|raw }}</div>{% endif %}
                {% if particle.accordionSubtitle %}<div class="g-swipercarousel-accordionslider-subtitle">{{ particle.accordionSubtitle|raw }}</div>{% endif %}
            </div>

            <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                {% if particle.source == 'joomla' %}

                    {# Load Content From Joomla #}
                    {% set category_options = particle.joomla.categories ? {id: [particle.joomla.categories|split(','), 0]} : {} %}
                    {% set categories_finder = joomla.finder('category', category_options).published(1).language().find() %}
                    {% set article_finder = joomla.finder('content').category(categories_finder).published(1).featured(false).language() %}
                    {% set items = article_finder.order('publish_up', 'ASC').limit(particle.joomla.articles|default('1')).start(0).find() %}

                    {% for row in items|batch(particle.displayitems) %}
                        <div class="item">
                            {% for item in row  %}
                                <div class="g-swipercarousel-item">
                                    {% if item.title %}
                                        <h4 class="g-swipercarousel-item-title padding">
                                            {{ item.title|html|raw }}
                                            <span class="indicator"><span>+</span></span>
                                        </h4>
                                    {% endif %}

                                    {% if (particle.joomla.introimage == 'enabled' and item.images.image_intro) or (particle.joomla.introtext == 'enabled' and item.introtext) or (particle.joomla.link == 'enabled' and item.route) %}
                                        <div class="g-swipercarousel-content">
                                            {% if particle.joomla.introimage == 'enabled' and item.images.image_intro %}
                                                <img src="{{ url(item.images.image_intro)|e }}" class="g-swipercarousel-item-image" alt="{{ item.title|e }}" />
                                            {% endif %}

                                            {% if particle.joomla.introtext == 'enabled' and item.introtext %}
                                                <div class="g-swipercarousel-item-desc">
                                                    <p>{{ item.introtext|html|raw }}</p>
                                                </div>
                                            {% endif %}

                                            {% if particle.joomla.link == 'enabled' and item.route %}
                                                <a target="{{ particle.joomla.linktarget|default('_self')|e }}" class="g-swipercarousel-item-button readon" href="{{ item.route|e }}">
                                                    <span>{{ particle.joomla.linktext|default('Read more')|html|raw }}</span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}

                {% else %}

                    {# Particle Content #}
                    {% for row in particle.items|batch(particle.displayitems) %}
                        <div class="item">
                            {% for item in row  %}
                                <div class="g-swipercarousel-item">
                                    {% if item.title %}
                                        <h4 class="g-swipercarousel-item-title padding">
                                            {{ item.title|html|raw }}
                                            <span class="indicator"><span>+</span></span>
                                        </h4>
                                    {% endif %}

                                    {% if item.image or item.desc or item.link %}
                                        <div class="g-swipercarousel-content">
                                            {% if item.image %}
                                                <img src="{{ url(item.image)|e }}" class="g-swipercarousel-item-image" alt="{{ item.title|e }}" />
                                            {% endif %}

                                            {% if item.desc %}
                                                <div class="g-swipercarousel-item-desc">
                                                    {% if item.desc %}<p>{{ item.desc|html|raw }}</p>{% endif %}
                                                </div>
                                            {% endif %}

                                            {% if item.link %}
                                                <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button readon" href="{{ item.link|e }}">
                                                    <span>{{ item.linktext|html|raw|default('Read More') }}</span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}

                {% endif %}
            </div>
        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
