{% extends '@nucleus/partials/particle.html.twig' %}

{% do genesis.load('lightcase.init') %}
{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="gantry-theme://css/swiper.min.css" />
<style>
    @media only all and (max-width: {{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}) {
        #{{ id }} .g-slider-carousel {
            height: {{ particle.heightMobile|default('400px') }} !important;
        }
    }
</style>
{% endblock %}

{% block particle %}

{% set swiper_slides %}
data-swiper-mobileslides="{{ particle.mobileslides|default('2') }}" data-swiper-mobilegroup="{{ particle.mobilegroup|default('1') }}" data-swiper-mobilespace="{{ particle.mobilespace|default('35') }}" data-swiper-tabletslides="{{ particle.tabletslides|default('3') }}" data-swiper-tabletgroup="{{ particle.tabletgroup|default('1') }}" data-swiper-tabletspace="{{ particle.tabletspace|default('35') }}" data-swiper-desktopslides="{{ particle.desktopslides|default('4') }}" data-swiper-desktopgroup="{{ particle.desktopgroup|default('1') }}" data-swiper-desktopspace="{{ particle.desktopspace|default('35') }}" data-swiper-largedesktopslides="{{ particle.largedesktopslides|default('4') }}" data-swiper-largedesktopgroup="{{ particle.largedesktopgroup|default('1') }}" data-swiper-largedesktopspace="{{ particle.largedesktopspace|default('35') }}"
{% endset %}

{% set swiper_breakpoints %}
data-swiper-mobile-breakpoint="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-swiper-tablet-breakpoint="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-swiper-desktop-breakpoint="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-swiper-largedesktop-breakpoint="{{ genesis.config.get('styles.breakpoints.large-desktop-container')|default('88rem') }}"
{% endset %}

<div id="{{ id }}" data-slider-id="{{ id }}" class="slider-wrapper">
	<div class="g-slider swiper-container swiper-container-vertical area {{ particle.class|e }}" data-slider-thumbnails="{% if particle.thumbs == 'enabled' %}true{% else %}false{% endif %}" data-slider-effect="{{ particle.effect }}" data-slider-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slider-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-slider-timeout="{{ particle.autoplayTimeout }}" data-slider-speed="{{ particle.speed }}" data-slider-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" data-slider-centered="{% if particle.centered == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %} {{ swiper_slides }} {{ swiper_breakpoints }}>

		<div class="g-slider-carousel swiper-wrapper" style="height: {{ particle.height|default('850px') }};">
			{% for item in particle.items %}
				<div class="swiper-slide" style="background-image: url('{{ url(item.image) }}');">
					<div class="slide">
						<div class="g-slider-carousel-content-wrapper">
							<span>{{ item.headline }}</span>
							<h1>{{ item.title }}</h1>
							<div class="g-slider-carousel-content-link">
								<div class="g-slider-carousel-content-link-icon">
									<a href="{{ item.link }}" target="_blank">
										<i class="{{ item.icon }}"></i>
									</a>
								</div>
								<hr/>
								<a href="{{ item.link }}" target="_blank">{{ item.linklabel }}</a>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>


		<!-- navigation -->
		{% if particle.nav == 'enabled' %}
			{% if genesis.page.direction == 'rtl' %}
				<div class="navigation rtl">
					<div class="slider-button-next">
						<i class="fa fa-angle-up"></i>
					</div>
					<div class="slider-button-prev">
						<i class="fa fa-angle-down"></i>
					</div>
				</div>
			{% else %}
				<div class="navigation">
					<div class="slider-button-next">
						<i class="fa fa-angle-down"></i>
					</div>
					<div class="slider-button-prev">
						<i class="fa fa-angle-up"></i>
					</div>
				</div>
			{% endif %}
		{% endif %}
	</div>

    {% if particle.thumbs == 'enabled' %}
	<div id="thumbs{{ id }}" class="thumbs-slider swiper-container g-thumbs">
		<div class="g-slider-carousel swiper-wrapper">
			{% for item in particle.items %}
				<div class="swiper-slide">
					<div class="slide">
						<div class="g-slider-thumbs-wrapper">
							{% if item.icon %}
								<i class="{{ item.icon }}"></i>
							{% endif %}
						</div>

					</div>
				</div>
			{% endfor %}
		</div>
	</div>
	{% endif %}
</div>

{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-theme://js/length.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('gantry-theme://js/swiper.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('gantry-theme://js/slider.init.js'), 10, 'footer') %}
{% endblock %}
