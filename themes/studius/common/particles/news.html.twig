{% extends '@nucleus/partials/particle.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="genesis-theme://css/swiper.min.css"/>
{% endblock %}

{% do genesis.load('lightcase.init') %}

{% block particle %}
	{% set news_slides %}
	data-news-mobileslides="{{ particle.mobileslides|default('2') }}" data-news-mobilegroup="{{ particle.mobilegroup|default('1') }}" data-news-mobilespace="{{ particle.mobilespace|default('35') }}" data-news-tabletslides="{{ particle.tabletslides|default('3') }}" data-news-tabletgroup="{{ particle.tabletgroup|default('1') }}" data-news-tabletspace="{{ particle.tabletspace|default('35') }}" data-news-desktopslides="{{ particle.desktopslides|default('4') }}" data-news-desktopgroup="{{ particle.desktopgroup|default('1') }}" data-news-desktopspace="{{ particle.desktopspace|default('35') }}" data-news-largedesktopslides="{{ particle.largedesktopslides|default('4') }}" data-news-largedesktopgroup="{{ particle.largedesktopgroup|default('1') }}" data-news-largedesktopspace="{{ particle.largedesktopspace|default('35') }}"
	{% endset %}

	{% set news_breakpoints %}
	data-news-mobile-breakpoint="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-news-tablet-breakpoint="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-news-desktop-breakpoint="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-news-largedesktop-breakpoint="{{ genesis.config.get('styles.breakpoints.large-desktop-container')|default('88rem') }}"
	{% endset %}

	{% if particle.title %}
		<div class="g-news-header">
			{% if particle.title %}
				<div class="g-news-title g-title">
					{{ particle.title|raw }}
					<span class="news-button-prev"><i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i></span>
					<span class="news-button-next"><i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i></span>
			
				</div>
			{% endif %}
		</div>
	{% endif %}

	<div id="{{ id }}" data-news-id="{{ id }}" class="news-wrapper">
		<div class="g-news swiper-container area {{ particle.class|e }}" data-news-effect="{{ particle.effect }}" data-news-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-news-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-news-timeout="{{ particle.autoplayTimeout }}" data-news-speed="{{ particle.speed }}" data-news-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %} {{ news_slides }} {{ news_breakpoints }}>
			<div class="g-news-wrapper swiper-wrapper">
				{% if not particle.source or particle.source == 'particle' %}
					{% for news in particle.news %}
						<div class="g-news-element swiper-slide">
							<div class="g-news-wrapper">
								{% if news.link %}
									<a href="{{ news.link }}" target="{{ news.target|default('_self')|e }}" {% if news.target == "lightcase" %}data-rel="lightcase"{% endif %} title="{{ news.content }}"><img class="g-news-image" src="{{ url(news.image) }}" alt="{{ news.content }}"/></a>
								{% else %}
									<img class="g-news-image" src="{{ url(news.image) }}" alt="{{ news.content }}"/>
								{% endif %}
								{% if news.content %}
									<h5 class="g-news-content">
										{% if news.link %}
											<a href="{{ news.link }}" target="{{ news.target|default('_self')|e }}" {% if news.target == "lightcase" %}data-rel="lightcase"{% endif %} title="{{ news.content }}">{{ news.content|raw }}</a>
										{% else %}
											{{ news.content|raw }}
										{% endif %}
									</h5>
								{% endif %}
							</div>
						</div>
					{% endfor %}
				{% else %}
					{% include '@particles/news-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
				{% endif %}

			</div>
		</div>


<div class="news-nav">
	<span class="news-button-prev">
		<i class="fa fa-chevron-circle-left" aria-hidden="true"></i>
	</span>
	<span class="news-button-next">
		<i class="fa fa-chevron-circle-right" aria-hidden="true"></i>
	</span>
</div>
	</div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/css-length.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('genesis-theme://js/news.init.js'), 10, 'footer') %}
{% endblock %}
