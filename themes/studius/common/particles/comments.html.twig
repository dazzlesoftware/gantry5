{% extends '@nucleus/partials/particle.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="gantry-theme://css/swiper.min.css"/>
{% endblock %}

{% do genesis.load('lightcase.init') %}
{% block particle %}

{% set swiper_slides %}
data-swiper-mobileslides="{{ particle.mobileslides|default('2') }}" data-swiper-mobilegroup="{{ particle.mobilegroup|default('1') }}" data-swiper-mobilespace="{{ particle.mobilespace|default('35') }}" data-swiper-tabletslides="{{ particle.tabletslides|default('3') }}" data-swiper-tabletgroup="{{ particle.tabletgroup|default('1') }}" data-swiper-tabletspace="{{ particle.tabletspace|default('35') }}" data-swiper-desktopslides="{{ particle.desktopslides|default('4') }}" data-swiper-desktopgroup="{{ particle.desktopgroup|default('1') }}" data-swiper-desktopspace="{{ particle.desktopspace|default('35') }}" data-swiper-largedesktopslides="{{ particle.largedesktopslides|default('4') }}" data-swiper-largedesktopgroup="{{ particle.largedesktopgroup|default('1') }}" data-swiper-largedesktopspace="{{ particle.largedesktopspace|default('35') }}"
{% endset %}

{% set swiper_breakpoints %}
data-swiper-mobile-breakpoint="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-swiper-tablet-breakpoint="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-swiper-desktop-breakpoint="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-swiper-largedesktop-breakpoint="{{ genesis.config.get('styles.breakpoints.large-desktop-container')|default('88rem') }}"
{% endset %}

<div id="{{ id }}" data-comments-id="{{ id }}" class="comments-wrapper">
	<div class="g-comments swiper-container area {{ particle.class|e }}" data-comments-thumbnails="{% if particle.thumbs == 'enabled' %}true{% else %}false{% endif %}" data-comments-effect="{{ particle.effect }}" data-comments-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-comments-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-comments-timeout="{{ particle.autoplayTimeout }}" data-comments-speed="{{ particle.speed }}" data-comments-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" data-comments-centered="{% if particle.centered == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %} {{ swiper_slides }} {{ swiper_breakpoints }}>

		<div class="g-comments-carousel swiper-wrapper">
			{% for item in particle.items %}
				<div class="swiper-slide" style="background-image: url('{{ url(item.image) }}');">
					<div class="slide">
						<div class="g-comments-carousel-content-wrapper">
						<p>{{ item.content }}</p>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

    {% if particle.thumbs == 'enabled' %}
	<div id="thumbs{{ id }}" class="swiper-container g-comment-thumbs">
		<div class="g-comments-carousel swiper-wrapper">
			{% for item in particle.items %}
				<div class="swiper-slide">
					<div class="slide">
						<div class="g-comments-thumbs-wrapper">
							{% if item.avatar %}
								<img src="{{ item.avatar }}" alt="{{ item.name }}">
							{% endif %}
							<div class="g-comments-thumbs-name">
							<strong>{{ item.name }}</strong>
							<span>{{ item.position }}</span>
							</div>
						</div>

					</div>
				</div>
			{% endfor %}
		</div>
	</div>
	{% endif %}
</div>

{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-theme://js/length.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('gantry-theme://js/swiper.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('gantry-theme://js/comments.init.js'), 10, 'footer') %}
{% endblock %}
