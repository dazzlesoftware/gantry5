{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}

    <div class="{{ particle.class|e }}">
        {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}

        <div class="g-showcasetabs {{ particle.layout }}">
            <div id="g-showcasetabs-{{ id }}" class="g-showcasetabs-container">
                <ul class="g-showcasetabs-tab-wrapper-container">

                    {% for item in particle.items %}
                        <li class="g-showcasetabs-tab-wrapper">
                            <span class="g-showcasetabs-tab-wrapper-head">
                                <a class="g-showcasetabs-tab" href="#g-showcasetabs-item-{{ loop.index }}">
                                    <img src="{{ url(item.thumb)|e }}" class="g-showcasetabs-thumb" {% if item.alt %}alt="{{ item.alt }}"{% endif %} />
                                    <span class="g-showcasetabs-tab-title">{{ item.title|html|raw }}</span>
                                </a>
                            </span>
                        </li>
                    {% endfor %}

                </ul>

                <ul class="g-showcasetabs-content-wrapper-container">

                    {% for item in particle.items %}
                        <li class="g-showcasetabs-tab-wrapper">
                            <div class="g-showcasetabs-tab-wrapper-body">
                                <div id="g-showcasetabs-item-{{ loop.index }}">
                                    <span class="g-showcasetabs-content">
                                        <img src="{{ url(item.image)|e }}" class="g-showcasetabs-image" {% if item.alt %}alt="{{ item.alt }}"{% endif %} />
                                        <span class="g-showcasetabs-desc center">
                                            {{ item.content|html|raw }}
                                            {% if item.link %}
                                                <a target="{{ item.buttontarget|default('_self')|e }}" href="{{ item.link|e }}" class="{{ item.buttonclass|e }}"><span>{{ item.linklabel|default('Read More') }}</span></a>
                                            {% endif %}
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </li>
                    {% endfor %}

                </ul>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascript_footer %}
{% do genesis.document.addScript(url('gantry-assets://js/tabs.js'), 11, 'footer') %}
{% endblock %}
