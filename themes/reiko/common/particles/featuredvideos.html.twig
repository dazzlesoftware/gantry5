{% extends '@nucleus/partials/particle.html.twig' %}

{% do genesis.load('lightcase.init') %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}

    <div id="{{ id }}" class="g-featured-videos {{ particle.class|e }}" data-featuredvideos-id="{{ id }}" data-featuredvideos-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-featuredvideos-timeout="{{ particle.autoplayTimeout }}" data-featuredvideos-speed="{{ particle.speed }}" data-featuredvideos-dots="{% if particle.dots == "enabled" %}true{% else %}false{% endif %}" data-featuredvideos-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}">

        <div class="section-horizontal-paddings g-featured-videos-top">
            <div class="title-wrapper">
                <h3 class="title">{{ particle.title }}</h3>
                <div class="custom-swiper-navigation"></div>
            </div>
        </div>

        <div class="g-featuredvideos-carousel g-swipercarousel swiper" data-featuredvideos-carousel-id="{{ id }}" data-featuredvideos-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}"
        data-g-swiper
        data-slides-per-view="3"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    {% set height = particle.height|default('300')|number_format %}
                    {% set titleheight = particle.titleheight|default('140')|number_format %}
                    <div style="min-height:{{ height + titleheight }}px;">
                        <div class="g-featuredvideos-carousel-image-container" style="background-image: url({{ url(item.image)|e }}); min-height:{{ height }}px;">
                            <a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %}target="{{ item.linktarget|default('_blank') }}"{% else %}data-rel="lightcase"{% endif %}></a>
                            <i class="fa fa-youtube-play video-icon" aria-hidden="true"></i>

                            {% if particle.thumbs == 'enabled' and item.image_small %}
                                <div class="g-featuredvideos-carousel-image-small">
                                    <img src="{{ url(item.image_small)|e }}" alt="{{ item.alt }}" />

                                    {% if item.title_small %}
                                        <div class="g-featuredvideos-carousel-title-small">{{ item.title_small }}</div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if item.title %}
                                <h3 class="g-featuredvideos-carousel-title">
                                    {% if item.link %}
                                        <a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %}target="{{ item.linktarget|default('_blank') }}"{% else %}data-rel="lightcase"{% endif %}>
                                    {% endif %}

                                    <span>{{ item.title|raw }}</span>

                                    {% if item.link %}
                                        </a>
                                    {% endif %}
                                </h3>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {% include '@particles/featuredvideos-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
