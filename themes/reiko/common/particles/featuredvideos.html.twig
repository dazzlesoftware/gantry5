{% extends '@nucleus/partials/particle.html.twig' %}

{% do gantry.load('lightcase.init') %}

{% block particle %}

    <div id="{{ id }}" class="g-featured-videos {{ particle.class|e }}" data-featuredvideos-id="{{ id }}" data-featuredvideos-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-featuredvideos-timeout="{{ particle.autoplayTimeout }}" data-featuredvideos-speed="{{ particle.speed }}" data-featuredvideos-dots="{% if particle.dots == "enabled" %}true{% else %}false{% endif %}" data-featuredvideos-rtl="{% if gantry.page.direction == 'rtl' %}true{% else %}false{% endif %}">

        <div class="section-horizontal-paddings g-featured-videos-top">
            <div class="title-wrapper">
                <h3 class="title">{{ particle.title }}</h3>
                <div class="custom-owl-nav"></div>
            </div>
        </div>

        <div class="g-featuredvideos-carousel g-owlcarousel owl-carousel" data-featuredvideos-carousel-id="{{ id }}" data-featuredvideos-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}">
            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    {% set height = particle.height|default('300')|number_format %}
                    {% set titleheight = particle.titleheight|default('140')|number_format %}
                    <div style="min-height:{{ height + titleheight }}px;">
                        <div class="g-featuredvideos-carousel-image-container" style="background-image: url({{ url(item.image)|e }}); min-height:{{ height }}px;">
                            <a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %}target="{{ item.linktarget|default('_blank') }}"{% else %}data-rel="lightcase"{% endif %}></a>
                            <i class="fa fa-youtube-play video-icon" aria-hidden="true"></i>

                            {% if particle.thumbs == 'enabled' and item.image_small %}
                                <div class="g-featuredvideos-carousel-image-small">
                                    <img src="{{ url(item.image_small)|e }}" alt="{{ item.alt }}" />

                                    {% if item.title_small %}
                                        <div class="g-featuredvideos-carousel-title-small">{{ item.title_small }}</div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if item.title %}
                                <h3 class="g-featuredvideos-carousel-title">
                                    {% if item.link %}
                                        <a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %}target="{{ item.linktarget|default('_blank') }}"{% else %}data-rel="lightcase"{% endif %}>
                                    {% endif %}

                                    <span>{{ item.title|raw }}</span>

                                    {% if item.link %}
                                        </a>
                                    {% endif %}
                                </h3>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {% include '@particles/featuredvideos-' ~ gantry.platform.name ~ '.html.twig' ignore missing %}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do gantry.load('jquery') %}
    {% do gantry.document.addScript(url('gantry-theme://js/owlcarousel.js'), 10, 'footer') %}
    {% do gantry.document.addScript(url('gantry-theme://js/length.min.js'), 10, 'footer') %}
    {% do gantry.document.addScript(url('gantry-theme://js/featuredvideos.init.js'), 10, 'footer') %}
{% endblock %}
