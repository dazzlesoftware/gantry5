{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}

    <div id="{{ id }}" class="g-slideshow {{ particle.class|e }}" data-slideshow-id="{{ id }}" data-slideshow-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}" data-slideshow-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slideshow-timeout="{{ particle.autoplayTimeout }}" data-slideshow-speed="{{ particle.speed }}" data-slideshow-rtl="{% if gantry.page.direction == 'rtl' %}true{% else %}false{% endif %}">

        <div class="g-slideshow-carousel g-swipercarousel swiper" data-slideshow-carousel-id="{{ id }}"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    <div>
                        <div class="g-slideshow-carousel-image-container" style="background-image: url({{ url(item.image)|e }}); min-height:{{ particle.height|default('55vh') }};">
                            {% if item.link %}
                                <a href="{{ url(item.link)|e }}" target="{{ item.linktarget|default('_self') }}"></a>
                            {% endif %}

                            {% if item.title %}
                                <h3 class="g-slideshow-carousel-title">
                                    <span>{{ item.title|raw }}</span>
                                </h3>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {% include '@particles/slideshow-' ~ gantry.platform.name ~ '.html.twig' ignore missing %}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
