{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
{% set suiteId = 'bootstrap-suite-' ~ id %}
<div id="{{ suiteId|e }}" class="bootstrap-test-suite container py-5">
    <header class="mb-5">
        <span class="badge bg-primary mb-3">Bootstrap 5.1.3</span>
        <h1 class="display-4 fw-bold">{{ particle.title|e }}</h1>
        <p class="lead text-muted">{{ particle.intro|e }}</p>
    </header>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Grid and responsive columns</h2>
        <div class="row g-3 text-center">
            <div class="col-12 col-md-6 col-lg-3"><div class="p-3 bg-primary text-white rounded">12 / 6 / 3</div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="p-3 bg-secondary text-white rounded">12 / 6 / 3</div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="p-3 bg-success text-white rounded">12 / 6 / 3</div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="p-3 bg-danger text-white rounded">12 / 6 / 3</div></div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Typography and inline elements</h2>
        <h1>Heading one</h1><h2>Heading two</h2><h3>Heading three</h3>
        <p><strong>Bold text</strong>, <em>italic text</em>, <mark>highlighted text</mark>, <code>inline code</code>, <a href="#">a regular link</a>, and <kbd>Ctrl</kbd> + <kbd>K</kbd>.</p>
        <blockquote class="blockquote"><p>A responsive framework is strongest when every component is tested together.</p><footer class="blockquote-footer">Aphrodite test suite</footer></blockquote>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Buttons, badges, and alerts</h2>
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-primary">Primary</button><button class="btn btn-secondary">Secondary</button><button class="btn btn-success">Success</button><button class="btn btn-danger">Danger</button><button class="btn btn-warning">Warning</button><button class="btn btn-info">Info</button><button class="btn btn-outline-dark">Outline</button>
        </div>
        <div class="mb-4"><span class="badge bg-primary me-2">Primary</span><span class="badge bg-success me-2">Success</span><span class="badge rounded-pill bg-dark">Pill badge</span></div>
        <div class="alert alert-primary" role="alert">Primary alert with <a href="#" class="alert-link">an example link</a>.</div>
        <div class="alert alert-warning alert-dismissible fade show" role="alert"><strong>Dismissible alert:</strong> Bootstrap JavaScript should close this message.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Cards and list groups</h2>
        <div class="row g-4">
            <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-body"><h3 class="card-title h5">Standard card</h3><p class="card-text">Cards verify borders, spacing, typography, and button alignment.</p><a href="#" class="btn btn-primary">Card action</a></div></div></div>
            <div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header">Featured list</div><div class="list-group list-group-flush"><a href="#" class="list-group-item list-group-item-action active">Active item</a><a href="#" class="list-group-item list-group-item-action">Second item</a><a href="#" class="list-group-item list-group-item-action disabled">Disabled item</a></div></div></div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Form controls</h2>
        <form class="row g-3" action="#" onsubmit="return false">
            <div class="col-md-6"><label class="form-label" for="{{ suiteId }}-name">Name</label><input id="{{ suiteId }}-name" class="form-control" type="text" placeholder="Jane Doe"></div>
            <div class="col-md-6"><label class="form-label" for="{{ suiteId }}-email">Email</label><input id="{{ suiteId }}-email" class="form-control" type="email" placeholder="name@example.com"></div>
            <div class="col-md-6"><label class="form-label" for="{{ suiteId }}-select">Select</label><select id="{{ suiteId }}-select" class="form-select"><option selected>Choose an option</option><option>Option two</option></select></div>
            <div class="col-md-6"><label class="form-label" for="{{ suiteId }}-range">Range</label><input id="{{ suiteId }}-range" class="form-range" type="range"></div>
            <div class="col-12"><label class="form-label" for="{{ suiteId }}-message">Message</label><textarea id="{{ suiteId }}-message" class="form-control" rows="3"></textarea></div>
            <div class="col-12"><div class="form-check"><input id="{{ suiteId }}-check" class="form-check-input" type="checkbox" checked><label class="form-check-label" for="{{ suiteId }}-check">Checked option</label></div></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Test submit</button></div>
        </form>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Table and progress</h2>
        <div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>Component</th><th>Status</th><th>Coverage</th></tr></thead><tbody><tr><td>CSS utilities</td><td><span class="badge bg-success">Pass</span></td><td>100%</td></tr><tr><td>JavaScript widgets</td><td><span class="badge bg-warning text-dark">Testing</span></td><td>75%</td></tr></tbody></table></div>
        <div class="progress" style="height: 22px"><div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">75%</div></div>
    </section>

    <section class="mb-5">
        <h2 class="h3 border-bottom pb-2 mb-4">Accordion, tabs, dropdown, and modal</h2>
        <div class="accordion mb-4" id="{{ suiteId }}-accordion"><div class="accordion-item"><h3 class="accordion-header" id="{{ suiteId }}-heading"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#{{ suiteId }}-collapse" aria-expanded="true" aria-controls="{{ suiteId }}-collapse">Accordion control</button></h3><div id="{{ suiteId }}-collapse" class="accordion-collapse collapse show" aria-labelledby="{{ suiteId }}-heading"><div class="accordion-body">Collapse behavior confirms that the Bootstrap bundle is active.</div></div></div></div>
        <ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#{{ suiteId }}-tab-one" type="button">First tab</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#{{ suiteId }}-tab-two" type="button">Second tab</button></li></ul>
        <div class="tab-content mb-4"><div id="{{ suiteId }}-tab-one" class="tab-pane fade show active">First responsive tab panel.</div><div id="{{ suiteId }}-tab-two" class="tab-pane fade">Second responsive tab panel.</div></div>
        <div class="d-flex flex-wrap gap-2">
            <div class="dropdown"><button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Dropdown test</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="#">First action</a></li><li><a class="dropdown-item" href="#">Second action</a></li></ul></div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#{{ suiteId }}-modal">Open modal</button>
        </div>
    </section>

    <nav aria-label="Test pagination"><ul class="pagination"><li class="page-item disabled"><span class="page-link">Previous</span></li><li class="page-item active"><span class="page-link">1</span></li><li class="page-item"><a class="page-link" href="#">2</a></li><li class="page-item"><a class="page-link" href="#">Next</a></li></ul></nav>

    <div class="modal fade" id="{{ suiteId }}-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">Bootstrap modal</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">If this dialog opened, Bootstrap JavaScript is working.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>
</div>
{% endblock %}
