{% extends '@nucleus/partials/particle.html.twig' %}
{% block particle %}
<section class="aphrodite-features">
    <div class="container px-4">
        {% if particle.title %}<h2 class="display-6 fw-bold text-center">{{ particle.title|e }}</h2>{% endif %}
        {% if particle.intro %}<p class="lead text-muted text-center mx-auto mb-5">{{ particle.intro|e }}</p>{% endif %}
        <div class="row g-4">
            {% for item in particle.items %}
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="aphrodite-feature">
                        {% if item.icon %}<span class="aphrodite-feature__icon"><i class="{{ item.icon|e }}" aria-hidden="true"></i></span>{% endif %}
                        <h3 class="h5 fw-bold">{{ item.title|e }}</h3>
                        <p class="text-muted mb-0">{{ item.text|e }}</p>
                    </article>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
