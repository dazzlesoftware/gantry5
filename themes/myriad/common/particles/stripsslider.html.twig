{% extends '@nucleus/partials/particle.html.twig' %}  

{% block particle %}
    {% block layout %}

        <div id="{% if particle.scrolltheme == 'enabled' %}strips-scroll{% else %}strips{% endif %}" class="{{ particle.class|e }} g-owlcarousel-strips-slider g-owlcarousel-strips-{{ particle.displayitems }}-items">
            {% if particle.title or particle.description %}
                <div class="g-grid">
                    <div class="g-block">
                        <div class="g-content g-owlcarousel-header">
                            {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}
                            {% if particle.description %}<div class="g-owlcarousel-description">{{ particle.description|html|raw }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            
            {% if particle.scrolltheme == 'enabled' %}
            <div class="viewport">
                <div class="overview">
            {% endif %}       

                    <div id="g-owlcarousel-{{ id }}" data-owlcarousel-id="g-owlcarousel-{{ id }}" class="g-owlcarousel owl-carousel">

                        {% for item in particle.items %}
                            {% if particle.scrolltheme == 'enabled' %}
                                <div class="item">
                                    {% if item.image %}
                                        <div class="g-owl-image-container">
                                            <img src="{{ url(item.image)|e }}" alt="{{ item.title|e }}" />
                                            {% if item.desc %}
                                                <div class="g-owlcarousel-item-desc">
                                                    <span>{{ item.desc|html|raw }}</span>

                                                    {% if item.link %}
                                                        <a target="{{ item.buttontarget|default('_self')|e }}" class="g-owlcarousel-item-button owl-readon" href="{{ item.link|e }}">
                                                            {{ item.linktext|html|raw|default('Read More') }}
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            {% endif %}                                    
                                        </div>    
                                    {% endif %}
                                        {% if item.title %}
                                            <h4 class="g-owlcarousel-item-title">
                                                {% if item.link %}<a href="{{ item.link|e }}" target="{{ item.buttontarget|default('_self')|e }}">{% endif %}

                                                {{ item.title|html|raw }}

                                                {% if item.link %}</a>{% endif %}
                                            </h4>
                                        {% endif %}
                                </div>                        
                            {% else %} 
                                <div class="item">
                                    {% if item.image %}<img src="{{ url(item.image)|e }}" alt="{{ item.title|e }}" />{% endif %}
                                    <div class="g-owlcarousel-content">
                                        {% if item.title %}
                                            <h4 class="g-owlcarousel-item-title">
                                                {% if item.link %}<a href="{{ item.link|e }}" target="{{ item.buttontarget|default('_self')|e }}">{% endif %}

                                                {{ item.title|html|raw }}

                                                {% if item.link %}</a>{% endif %}
                                            </h4>
                                        {% endif %}

                                        {% if item.desc %}
                                            <div class="g-owlcarousel-item-desc">
                                                <span>{{ item.desc|html|raw }}</span>

                                                {% if item.link %}
                                                    <a target="{{ item.buttontarget|default('_self')|e }}" class="g-owlcarousel-item-button owl-readon" href="{{ item.link|e }}">
                                                        {{ item.linktext|html|raw|default('Read More') }}
                                                    </a>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>    
            {% if particle.scrolltheme == 'enabled' %}
                </div>      
            </div>
            {% endif %}


        {% if particle.scrolltheme == 'enabled' %}
        <div class="scrollbar"><div class="track"><div class="thumb"><div class="end"></div></div></div></div>

        {% endif %}

        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do gantry.load('jquery') %}
    <script src="{{ url('gantry-theme://js/owl.carousel.min.js') }}"></script>
    {% if particle.scrolltheme == 'enabled' %}
    <script src="{{ url('gantry-theme://js/tinyscrollbar.min.js') }}"></script>
    {% endif %}
    <script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery('#g-owlcarousel-{{ id }}').owlCarousel({
            items: {{ particle.displayitems }},
            slideBy: {{ particle.displayitems }},
            smartSpeed: 100,
            rtl: {% if gantry.page.direction == 'rtl' %}true{% else %}false{% endif %},
            {% if particle.nav == 'enabled' %}
            nav: true,
            {% else %}
            nav: false,
            {% endif %}
            {% if particle.dots == 'enabled' %}
            dots: true,
            {% else %}
            dots: false,
            {% endif %}
            {% if particle.loop == 'enabled' %}
            loop: true,
            {% else %}
            loop: false,
            {% endif %}
            {% if particle.autoplay == 'enabled' %}
            autoplay: true,
            autoplayTimeout: {{ particle.autoplaySpeed|default('5000') }},
            {% if particle.pauseOnHover == 'enabled' %}
            autoplayHoverPause: true,
            {% else %}
            autoplayHoverPause: false,
            {% endif %}
            {% else %}
            autoplay: false,
            {% endif %}
            responsive: {
                0: {
                    items: 1,
                },
                480: {
                    items: 2,
                },
                768: {
                    items: 3,
                },
                1015: {
                    items: {{ particle.displayitems }},
                },
            },
        })
    });
    </script>
{% endblock %}
