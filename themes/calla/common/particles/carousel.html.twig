{% extends '@nucleus/partials/particle.html.twig' %}

{% do genesis.load('lightcase.init') %}

{% set breakpoints %}
#g-carousel-{{ id }} .g-carousel-image-wrapper {
    min-height: {{ particle.height }};
}
@media only all and (max-width: {{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}) and (min-width: {{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}) {
    #g-carousel-{{ id }} .g-carousel-image-wrapper {
        min-height: {{ particle.tablet_height }};
    }
}
@media only all and (max-width: {{ genesis.config.get('styles.breakpoints.large-desktop-container')|default('88') }}) and (min-width: {{ genesis.config.get('styles.breakpoints.tablet-desktop')|default('76rem') }}) {
    #g-carousel-{{ id }} .g-carousel-image-wrapper {
        min-height: {{ particle.desktop_height }};
    }
}
{% endset %}

{% do genesis.document.addInlineStyle(breakpoints) %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% if particle.demo == "enabled" %}
        {% if genesis.theme.preset %}
            {% set preset = genesis.theme.preset | replace({'preset': ''}) - 1 %}
        {% else %}
            {% set preset = '0' %}
        {% endif %}
    {% else %}
        {% set preset = '0' %}
    {% endif %}
    <div class="{{ particle.class|e }} g-swipercarousel-carousel">
        <div id="g-carousel-{{ id }}" class="g-carousel swiper" data-carousel-autoplaytimeout="{{ particle.autoplaySpeed|default('5000') }}" data-carousel-pausehover="{% if particle.pauseOnHover == "enabled" %}true{% else %}false{% endif %}" data-carousel-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-carousel-id="{{ id }}" data-carousel-preset="{{ preset }}" data-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}" data-carousel-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}"
        data-g-swiper
        data-slides-per-view="{{ particle.displayitems|default(1)|e }}"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    <div class="g-carousel-image-wrapper" style="background-image: url({{ url(item.image) }});">
                        {% if item.title %}
                           {% if item.link %}
                                <a href="{{ item.link }}">
                                    <span class="g-carousel-title">{{ item.title|raw }}</span>
                                </a>
                            {% else %}
                                 <span class="g-carousel-title">{{ item.title|raw }}</span>
                            {% endif %}
                        {% endif %}

                        {% if item.caption %}
                            <p class="g-carousel-description">{{ item.caption|raw }}</p>
                        {% endif %}

                        {% if item.link_text and item.link %}
                            <a class="g-carousel-link" href="{{ item.link }}">{{ item.link_text }}</a>
                        {% else %}
                            <br />
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                {% include '@particles/carousel-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
