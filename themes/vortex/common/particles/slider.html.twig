{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    <div id="{{ id }}" class="g-slider {{ particle.class|e }}" data-slider-id="{{ id }}" data-slider-items="{{ particle.items_amount }}" data-slider-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}">
        {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

        <div class="g-slider-slides g-swipercarousel swiper" data-slider-slides-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="main"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% for item in particle.items %}
            <div>
                <div class="g-slider-slides-item-title">
                    {{ item.title }}
                </div>
                {% if item.link %}
                <div class="g-slider-slides-item-link">
                    <a href="{{ item.link }}" class="button button-xlarge">{{ item.linktext }}</a>
                </div>
                {% endif %}

                <img src="{{ url(item.image)|e }}" alt="{{ item.imagealt }}">
            </div>
            {% endfor %}
        </div>
        <div class="g-slider-carousel g-swipercarousel swiper" data-slider-carousel-id="{{ id }}" data-slider-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}"
        data-g-swiper
        data-g-swiper-role="navigation"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% for item in particle.items %}
            <div>
                <div class="g-slider-carousel-image-container">
                    <img src="{{ url(item.image)|e }}" alt="{{ item.imagealt }}">

                    <div class="g-slider-carousel-image-hover">
                        <i class="{{ item.icon }}" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
