{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% set accordionEnabled = particle.accordion|default('disabled') in ['enabled', 'enable', 'true', '1', true, 1] %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div class="{{ particle.class|e }} g-swipercarousel-lists g-swipercarousel-lists-{{ particle.displayitems }}-items"{% if accordionEnabled %} data-g-accordion="true"{% endif %}>
            {% if particle.title or particle.description %}
                <div class="g-grid">
                    <div class="g-block">
                        <div class="g-content g-swipercarousel-header">
                            {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}
                            {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|html|raw }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel">
                <div class="swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                {% for row in particle.items|batch(particle.displayitems) %}
                    <div>
                        <div class="item">
                        {% for item in row  %}
                            <div class="g-swipercarousel-item">
                                {% if item.title %}
                                    <h4 class="g-swipercarousel-item-title{% if accordionEnabled %} padding{% endif %}">
                                        {% if item.link %}<a href="{{ item.link|e }}">{% endif %}

                                        {{ item.title|html|raw }}

                                        {% if item.link %}</a>{% endif %}

                                        {% if accordionEnabled %}<span class="indicator"><span>+</span></span>{% endif %}
                                    </h4>
                                {% endif %}

                                {% if item.image or item.desc or item.link %}
                                    <div class="g-swipercarousel-content">
                                        {% if item.image %}
                                            <img src="{{ url(item.image)|e }}" class="g-swipercarousel-item-image" alt="{{ item.title|e }}" />
                                        {% endif %}

                                        {% if item.desc %}
                                            <div class="g-swipercarousel-item-desc">
                                                {% if item.desc %}<p>{{ item.desc|html|raw }}</p>{% endif %}
                                            </div>
                                        {% endif %}

                                        {% if item.link %}
                                            <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button readon" href="{{ item.link|e }}">
                                                <span>{{ item.linktext|html|raw|default('Read More') }}</span>
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                {% endfor %}

                </div>
            </div>
        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
