{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div class="{{ particle.class|e }} g-swipercarousel-preview g-swipercarousel-{{ particle.displayitems }}-items">
            {% if particle.title %}
                <h3 class="g-title">
                    {{ particle.title|raw }}
                </h3>
            {% endif %}

            {% if particle.description %}
                <div class="g-swipercarousel-description">
                    {{ particle.description|raw }}
                </div>
            {% endif %}

            <div id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper g-swipercarousel-fullwidth"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                {% if particle.source == 'joomla' %}

                    {# Load Content From Joomla #}
                    {% set category_options = particle.joomla.categories ? {id: [particle.joomla.categories|split(','), 0]} : {} %}
                    {% set categories_finder = joomla.finder('category', category_options).published(1).language().find() %}
                    {% set article_finder = joomla.finder('content').category(categories_finder).published(1).featured(false).language() %}
                    {% set items = article_finder.order('publish_up', 'ASC').limit(particle.joomla.articles|default('1')).start(0).find() %}

                    {% for item in items %}
                        <div class="item">
                            <div class="preview-image">
                                {% if particle.joomla.introimage == 'enabled' and item.images.image_intro %}
                                    <img {% if particle.lazyload == 'enabled' %}loading="lazy" src="{{ url(item.images.image_intro)|e }}"{% else %}src="{{ url(item.images.image_intro)|e }}"{% endif %} alt="{{ item.title|e }}" />
                                {% endif %}
                                <div class="preview-text">
                                    {% if particle.joomla.title == 'enabled' and item.title %}<div class="item-overlay-title">{{ item.title|e }}</div>{% endif %}
                                    {% if particle.joomla.link == 'enabled' and item.route %}
                                        <div class="g-swipercarousel-item-link">
                                            <a target="{{ particle.joomla.linktarget|default('_self')|e }}" class="g-swipercarousel-item-button button {{ particle.joomla.linkclass|e }}" href="{{ item.route|e }}">
                                                {{ particle.joomla.linktext|raw }}
                                            </a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                {% else %}

                    {# Particle Content #}
                    {% for item in particle.items %}
                        <div class="item">
                            <div class="preview-image">
                                {% if item.image %}<img {% if particle.lazyload == 'enabled' %}loading="lazy" src="{{ url(item.image)|e }}"{% else %}src="{{ url(item.image)|e }}"{% endif %} alt="{{ item.title|e }}" />{% endif %}
                                <div class="preview-text">
                                    {% if item.title %}<div class="item-overlay-title">{{ item.title|e }}</div>{% endif %}
                                    {% if item.link %}
                                        <div class="g-swipercarousel-item-link">
                                            <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button button {{ item.buttonclass|e }}" href="{{ item.link|e }}">
                                                {{ item.linktext|raw }}
                                            </a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                {% endif %}

            </div>
        </div>

    {% endblock %}
{% endblock %}


{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
