{% extends '@nucleus/partials/particle.html.twig' %}

{% do gantry.load('lightcase.init') %}

{% block particle %}
<div class="{{ particle.class|e }}">
  <div class="g-blockcontent">
    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

    {% if particle.image or particle.headline or particle.description or particle.linktext %}
    <div class="g-grid g-blockcontent-maincontent">
      <div class="g-block">
        <div class="g-content">
          {% if particle.image %}<img src="{{ url(particle.image) }}" class="logo-large" alt="{{ particle.headline|e }}" />{% endif %}
          {% if particle.headline %}<h2 class="g-blockcontent-headline">{{ particle.headline|raw }}</h2>{% endif %}
          {% if particle.description %}<div class="g-blockcontent-description">{{ particle.description|raw }}</div>{% endif %}
          {% if particle.linktext %}
            <div class="g-blockcontent-readon">
              <a href="{{ particle.link|e }}" target="{{ particle.linktarget|default('_self')|e }}" class="button {{ particle.linkclass|e }}">
                {% if particle.linkicon %} <span class="g-blockcontent-linkicon"><i class="{{ particle.linkicon }}"></i></span> {% endif %}
                {{ particle.linktext|raw }}
              </a>
              {% if particle.alttext %} <span class="g-blockcontent-alttext">{{ particle.alttext|raw }}</span> {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
    <div class="g-grid g-blockcontent-subcontent">
      {% for subcontent in particle.subcontents %}
        <div class="g-block g-blockcontent-subcontent-block {{ subcontent.class }}">
          <div class="g-content g-blockcontent-subcontent-block-content">
            <div class="g-blockcontent-subcontent-block-content-head">
              {% if subcontent.rokboximage %}<a data-rel="lightcase" title="{{ subcontent.rokboxcaption|e }}" href="{{ url(subcontent.rokboximage) }}">{% endif %}
              {% if subcontent.img %}<img src="{{ url(subcontent.img) }}" class="g-blockcontent-subcontent-img" alt="{{ subcontent.subtitle|e }}" />{% endif %}
              {% if subcontent.rokboximage %}</a>{% endif %}
              {% if subcontent.icon %}<i class="{{ subcontent.icon }} g-blockcontent-icons"></i>{% endif %}
            </div>
            <div class="g-blockcontent-subcontent-block-content-body">
              {% if subcontent.name %}<h4 class="g-blockcontent-subcontent-title"><span>{{ subcontent.name|raw }}</span></h4>{% endif %}
              {% if subcontent.subtitle %} <div class="g-blockcontent-subcontent-subtitle">{{ subcontent.subtitle|raw }}</div> {% endif %}
              {% if subcontent.description %}<div class="g-blockcontent-subcontent-desc">{{ subcontent.description|raw }}</div>{% endif %}
              {% if subcontent.button %}<div class="g-blockcontent-subcontent-readon"><a href="{{ subcontent.buttonlink|e }}" class="button {{ subcontent.buttonclass|e }}">{{ subcontent.button|e }}</a></div>{% endif %}
            </div>
            <div class="clearfix"></div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
