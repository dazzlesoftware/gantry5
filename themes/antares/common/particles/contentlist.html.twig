{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}

	{% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}

	<div class="g-contentlist {{ particle.class|e }}">

	    <div class="row g-grid">
	        <div class="col g-block col-4 g-contentlist-img" style="background-image: url({{ url(particle.image)|e }})">
	            {% if particle.imagetag %}<div class="g-contentlist-img-tag">{{ particle.imagetag|e }}</div>{% endif %}
	        </div>
	        <div class="col g-block col-8 g-contentlist-text">
	            <div class="g-content">
	                {% if particle.headline %}<h3 class="g-contentlist-headline">{{ particle.headline|raw }}</h3>{% endif %}
	                {% if particle.subtitle %}<h5 class="g-contentlist-subtitle">{{ particle.subtitle|raw }}</h5>{% endif %}
	                {% if particle.desc %}<div class="g-contentlist-desc">{{ particle.desc|raw }}</div>{% endif %}
	                {% if particle.readmore %}<a target="{{ particle.readmorelinktarget|default('_self')|e }}" href="{{ particle.link|e }}" class="button {{ particle.readmoreclass|e }}">{% if particle.icon %}<i class="{{ particle.icon|e }}"></i>{% endif %}{{ particle.readmore|raw }}</a>{% endif %}
	            </div>
	        </div>    
	    </div> 

	    {% if particle.listgriditems %}
	    <div class="row g-grid g-contentlist-list">
	        <div class="col g-block">
	            <div class="g-content">
	                <div class="g-listgrid {{ particle.cols|e }}">
						{% for listgriditem in particle.listgriditems %}
		                    <div class="g-listgrid-item">
		                        <a target="{{ listgriditem.linktarget|default('_self')|e }}" href="{{ listgriditem.link|e }}">
		                        	<span class="{{ listgriditem.icon }}"></span>
		                        	<span>{{ listgriditem.text|raw }}</span>
		                        </a>
		                    </div>
						{% endfor %} 
	                </div>
	            </div>
	        </div>
	    </div>   
		{% endif %}
		
	</div>

{% endblock %}