{% extends '@nucleus/partials/particle.html.twig' %}

{% block javascript %}
<script>
document.addEventListener('click', (event) => {
    const toggle = event.target.closest('.nav-toggle');
    const overlay = event.target.closest('#g-overlay');
    if (!toggle && !overlay) return;
    event.preventDefault();
    const trigger = toggle || document.querySelector('.nav-toggle');
    const target = document.getElementById('g-overlay');
    trigger?.classList.toggle('active');
    target?.classList.toggle('open');
    trigger?.setAttribute('aria-expanded', String(target?.classList.contains('open')));
});
</script>
{% endblock %}

{% block particle %}
<div class="{{ particle.class|e }}">
  <div class="g-overlaytoggle">
    {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
    <a id="trigger-overlay" class="nav_slide_button nav-toggle" href="#" onclick="return false">
      {% if particle.menutext %}<span class="g-overlaytoggle-text">{{ particle.menutext|raw }}</span>{% endif %}
    </a>
  </div>
</div>

{% endblock %}
