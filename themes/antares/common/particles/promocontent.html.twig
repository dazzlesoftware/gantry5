{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
<div class="{{ particle.class|e }}">
	{% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
		
	<div class="g-promocontent">
		{% set readmoreInline %}
			{% if particle.link and particle.linkstyle == 'inline' %}
			<a target="{{ particle.linktarget|default('_self')|e }}" href="{{ particle.link|e }}" class="button {{ particle.readmoreclass|e }}">{{ particle.readmore|raw }}</a>
			{% endif %}
		{% endset %}
		{% if particle.link and particle.linkstyle == 'aside' %}
		<div class="g-inline-action-content"><div class="g-inline-action-text">
		{% endif %}

		{% if particle.subpromo %}
		<h3 class="g-subpromo">{{ particle.subpromo|raw }}</h3>
		{% endif %}

		{% if particle.promostyle == 'standard' %}
		<h2 class="g-title">{{ particle.promo|raw }}</h2>
		{{ readmoreInline }}
		{% endif %}
		
		{% if particle.promostyle == 'promo' %}
		<div class="g-promo">{{ particle.promo|raw }}</div>
		{{ readmoreInline }}
		{% endif %}
	
		{% if particle.promostyle == 'superpromo' %}
		<h2 class="g-superpromo">
			{{ particle.promo|raw }}
		</h2>
		{{ readmoreInline }}
		{% endif %}
	
		{% if particle.promostyle == 'subpromo' %}
		<div class="g-subpromo">
			<span>{{ particle.promo|raw }}</span>
			{{ readmoreInline }}
		</div>
		{% endif %}
	
		{% if particle.tags %}
		<ul class="g-tags">
		{% for tag in particle.tags %}
			<li>
				{% if tag.link %}
				<a target="{{ particle.taglinktarget|default('_self')|e }}" href="{{ tag.link|e }}">
				{% endif %}
					{% if tag.icon %}
					<i class="{{ tag.icon|e }}"></i>
					{% endif %}
					{{ tag.text|raw }}
				{% if tag.link %}
				</a>
				{% endif %}
			</li>
		{% endfor %}
		</ul>
		{% endif %}
		
		{% if particle.desc %}
		<div class="g-textpromo">
			{{ particle.desc|raw }}
		</div>
		{% endif %}
		
		{% if particle.link and particle.linkstyle == 'aside' %}
		</div>
		<div class="g-inline-action-button">
		{% endif %}
		
		{% if particle.link and (particle.linkstyle == 'block' or particle.linkstyle == 'aside') %}
		<div class="col g-block-action-button"><a target="{{ particle.linktarget|default('_self')|e }}" href="{{ particle.link|e }}" class="button {{ particle.readmoreclass|e }}">{{ particle.readmore|raw }}</a></div>
		{% endif %}
		
		{% if particle.link and particle.linkstyle == 'aside' %}
		</div></div>
		{% endif %}

		{% if particle.altLink %}<div class="g-promocontent-altlink"><a target="{{ particle.altLinkTarget|default('_self')|e }}" class="g-promocontent-altlink-button button {{ particle.altLinkClass|e }}" href="{{ particle.altLink|e }}">{{ particle.altLinkText|raw }}</a></div>{% endif %}
	</div>
</div>
{% endblock %}