{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
<div id="{{ id }}" data-particlesjs-id="{{ id }}" data-particlesjs-path="{% if particle.file %}{{ url(particle.file) }}{% else %}{% if (genesis.theme.preset) and (particle.preset_sync == "enabled")  %}{{ url('genesis-theme://json/particlejs/' ~ genesis.theme.preset ~ '.json') }}{% else %}{{ url('genesis-theme://json/particlejs/' ~ particle.conf_presets ~ '.json') }}{% endif %}{% endif %}"  class="g-particlesjs {% if particle.sectiononly == 'enabled' %}sectiononly{% endif %}"></div>
{% endblock %}

{% block javascript_footer %}
    <script src="{{ url('genesis-assets://js/particles.min.js') }}"></script>
    <script src="{{ url('genesis-assets://js/particlesjs.js') }}"></script>
{% endblock %}
