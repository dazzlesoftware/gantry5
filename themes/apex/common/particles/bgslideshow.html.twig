{% extends '@nucleus/partials/particle.html.twig' %}
{% do genesis.load('lightcase.init') %}

{% block stylesheets %}
<style>
    .g-bgslideshow-slides {
        padding-top: {{ particle.paddingtop|default('10vh') }};
    }
</style>
{% endblock %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
<div id="{{ id }}" class="{{ particle.class|e }}" data-bgslideshow-id="{{ id }}" data-bgslideshow-items="{{ particle.displayitems }}" data-bgslideshow-itemstablet="{{ particle.displayitems_tablet }}" data-bgslideshow-itemsmobile="{{ particle.displayitems_mobile }}" data-bgslideshow-itemssmallmobile="{{ particle.displayitems_smallmobile }}" data-bgslideshow-delay="{{ particle.delay }}" data-bgslideshow-transition-duration="{{ particle.transitionDuration|default(500) }}" data-bgslideshow-cover="{{ particle.cover|default('cover') == 'disabled' ? 'contain' : 'cover' }}" data-bgslideshow-align="{{ particle.align|default('center') }}" data-bgslideshow-valign="{{ particle.valign|default('center') }}" data-vegas-element="{{ particle.element }}" data-bgslideshow-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}">
    {% if particle.title %}
        <h2 class="g-title">{{ particle.title|raw }}</h2>
    {% endif %}

    <div id="slides-{{ id }}" class="g-bgslideshow-slides g-swipercarousel swiper" data-bgslideshow-slides-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="main"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
        {% for item in particle.items %}
            <div>
                <div class="g-bgslideshow-slides-item-title">
                    {{ item.title }}
                </div>
                <div class="g-bgslideshow-slides-item-description">
                    {{ item.description }}
                </div>
                {% if item.link %}
                    <div class="g-bgslideshow-slides-item-link">
                        <a href="{{ item.link }}" class="button button-xlarge">{{ item.linktext }}</a>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <div id="carousel-{{ id }}" class="g-bgslideshow-carousel g-swipercarousel swiper" data-bgslideshow-carousel-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="navigation"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
        {% for item in particle.items %}
            <div class="">
                <div class="g-bgslideshow-carousel-image-container">
                    <img src="{{ url(item.image)|e }}" alt="{{ item.alt }}">

                    <div class="g-bgslideshow-carousel-image-hover">
                        {{ item.title }}
                        <a href="{{ url(item.image)|e }}" data-rel="lightcase" title="{{ item.title }}">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
