{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    <div class="{{ particle.class|e }}">
        {% if particle.demo == "enabled" %}
            {% if genesis.theme.preset %}
                {% set preset = genesis.theme.preset | replace({'preset': ''}) %}
            {% else %}
                {% set preset = 1 %}
            {% endif %}
        {% endif %}
        <div class="g-eventlist-container" data-eventlist-id="{{ id }}" data-eventlist-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}" data-eventlist-mobile="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-eventlist-tablet="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-eventlist-desktop="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-eventlist-preset="{% if particle.demo == "enabled" %}{{ preset }}{% else %}false{% endif %}">

            <div class="g-eventlist-carousel swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}">
                {% for item in particle.items %}
                    <div class="g-eventlist-item-image">
                        <img src="{{  url(item.image) }}" alt="{{ item.location1 }}">
                        <div class="g-eventlist-item-image-content">
                            <div class="g-eventlist-item-image-location">
                                {{ item.location1 }}</div>
                            <div class="g-eventlist-item-image-date">
                                {{ item.date1 }},
                                {{ item.date2 }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="g-eventlist-items">

                {% if particle.title %}
                    <h2 class="g-eventlist-title">
                        <span>{{ particle.subtitle|raw }}</span>
                        {{ particle.title|raw }}</h2>
                {% endif %}

                {% for item in particle.items %}
                    <div class="g-eventlist-item {% if particle.demo == "enabled" %}{% if loop.index == preset %}selected{% endif %}{% else %}{% if loop.first %}selected{% endif %}{% endif %}">
                        <div class="g-eventlist-date">
                            <div class="g-eventlist-date-line1">
                                {{ item.date1 }}
                            </div>
                            <div class="g-eventlist-date-line2">
                                {{ item.date2 }}
                            </div>
                        </div>
                        <div class="g-eventlist-location">
                            <div class="g-eventlist-location-icon">
                                <i class="fa fa-map-marker" aria-hidden="true"></i>
                            </div>
                            <div class="g-eventlist-location-content">
                                <div class="g-eventlist-location-line1">
                                    <a target="{{ item.buttontarget|default('_self')|e }}" href="https://www.google.com/maps/search/{{ item.location1 }}">
                                        {{ item.location1 }}
                                    </a>
                                </div>
                                <div class="g-eventlist-location-line2">
                                    <a target="{{ item.buttontarget|default('_self')|e }}" href="https://www.google.com/maps/search/{{ item.location2 }}">
                                        {{ item.location2 }}
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="g-eventlist-buttons">
                            <div class="g-eventlist-location-button">
                                <a target="{{ item.buttontarget|default('_self')|e }}" href="{{ item.buttonlink|e }}" title="{{ item.buttontext|e }}" class="button {{ item.buttonclass|e }}">{{ item.buttontext|e }}</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
