{% extends '@nucleus/partials/particle.html.twig' %}

{% set ie11 %}
@media all and (-ms-high-contrast:none) {
    body .rt-tobottom:hover:before {font-size: 70px !important;}
}
{% endset %}

{% do gantry.document.addInlineStyle(ie11) %}

{% block javascript %}
    <script src="{{ url('gantry-theme://js/smooth-scroll.min.js') }}"></script>
{% endblock %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% block layout %}

        <div class="{{ particle.class|e }} g-swipercarousel-slideshow">
            {% if particle.title or particle.description %}
                <div class="g-grid">
                    <div class="g-block">
                        <div class="g-content g-swipercarousel-header">
                            {% if particle.title %}<h2 class="g-title">{{ particle.title }}</h2>{% endif %}
                            {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|html|raw }}</div>{% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

                {% for item in particle.items %}
                <div class="g-swipercarousel-item-{{ loop.index }} {{ item.class|e }}">
                            <div class="g-swipercarousel-item-image" style="background-image: url({{ url(item.image) }}); ">
                            </div>

                        {% if item.title or item.desc or item.link %}
                            <div class="g-swipercarousel-content">
                                <div class="g-swipercarousel-padding">
                                    {% if item.title %}<h2 class="g-swipercarousel-item-title">{{ item.title|html|raw }}</h2>{% endif %}

                                    {% if item.desc or item.link %}
                                        <div class="g-swipercarousel-item-desc">
                                            {% if item.desc %}<div>{{ item.desc|html|raw }}</div>{% endif %}

                                            {% if item.link %}
                                                <div class="g-swipercarousel-item-link" {% if item.aos %}data-aos="{{ item.aos }}" data-aos-delay="{{ item.delay }}" data-aos-anchor="#g-slideshow"{% endif %}>
                                                    <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button {{ item.buttonclass|e }}" href="{{ item.link|e }}">
                                                        {{ item.linktext|html|raw|default('Read More') }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            {% if particle.tobottom == 'enabled' %}
            <div class="clear"></div>
            <a href="#rt-head-anchor" data-scroll data-options='{"updateURL": false}'><span class="rt-tobottom"></span></a>
            <div id="rt-head-anchor"></div>
            {% endif %}
        </div>

    {% endblock %}
{% endblock %}

{% block javascript_footer %}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
