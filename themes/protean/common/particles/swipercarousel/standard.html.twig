{% extends '@particles/swipercarousel.html.twig' %}

{# Standard Layout #}
{% block layout %}
<div class="{{ particle.class|e }} g-swipercarousel-layout-{{ particle.layout|e }} g-swipercarousel-{{ particle.displayitems }}-items">
    {% if particle.title or particle.description %}
    <div class="g-grid">
        <div class="g-block">
            <div class="g-content g-swipercarousel-header">
                {% if particle.title %}<h2 class="g-title">{{ particle.title|raw }}</h2>{% endif %}
                {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|raw }}</div>{% endif %}
            </div>
        </div>
    </div>
    {% endif %}
    <div id="g-swipercarousel-{{ id }}" data-swipercarousel-id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper {{ particle.width|e }}"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

        {% for item in particle.items %}
        <div class="item">
            {% if item.image %}
            <div class="image" style="background-image: url('{{ url(item.image)|e }}');">
                <img src="{{ url(item.image)|e }}" alt="{{ item.title|e }}" />
            </div>
            {% endif %}

            {% set externalVideo = item.video|default('')|lower %}
            {% if item.video and item.videosource == 'external' and ('youtube.com' in externalVideo or 'youtu.be' in externalVideo or 'vimeo.com' in externalVideo) %}
            <div class="video" id="video-item-{{ loop.index }}">
                <a class="swiper-video" href="{{ url(item.video)|e }}"></a>
            </div>
            {% endif %}

            {% if item.videolocal and item.videosource == 'local' %}
            <div class="video" id="video-item-{{ loop.index }}" data-video-controller data-video-autoplay="{{ particle.videoautoplay == 'enabled' ? 'true' : 'false' }}">
                <video class="g-video-nocontrols" data-video-autoplay="{{ particle.videoautoplay == 'enabled' ? 'true' : 'false' }}" preload="metadata" playsinline {% if item.videothumb %}poster="{{ url(item.videothumb)|e }}"{% endif %} {% if particle.videoloop == 'enabled' %}loop{% endif %}>
                    <source src="{{ url(item.videolocal)|e }}" type="video/mp4">
                    </video>
                    <button type="button" class="swiper-videolocal-play-icon g-videolocal-play" aria-label="Play video" aria-pressed="false"></button>
                </div>
                {% endif %}

                {% if item.subtitle or item.title or item.desc or item.link or item.author %}
                <div class="g-swipercarousel-content">
                    {% if item.title %}<div class="g-swipercarousel-item-title">{{ item.title|raw }}</div>{% endif %}
                    <div class="g-swipercarousel-item-subtitle">{% if item.subtitle %}{{ item.subtitle|raw }}{% endif %}
                        {% if item.link %}
                        <div class="g-swipercarousel-item-link">
                            <a target="{{ item.buttontarget|default('_self')|e }}" class="g-swipercarousel-item-button button {{ item.buttonclass|e }}" href="{{ item.link|e }}">
                                {{ item.linktext|raw }}
                            </a>
                        </div>
                        {% endif %}
                    </div>

                    {% if item.desc %}<div class="g-swipercarousel-item-desc">{{ item.desc|raw }}</div>{% endif %}

                    {% if item.author %}
                    <div class="g-swipercarousel-author">
                        {% if item.authorimage %}
                        <span class="author-image">
                            <img src="{{ url(item.authorimage)|e }}" alt="{{ item.author|e }}" />
                        </span>
                        {% endif %}
                        {% if item.author %}<span class="author-name">{{ item.author|e }}</span>{% endif %}
                    </div>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <div class="g-container-wrapper-panel">
            <div class="g-swipercarousel-panel-container" id="g-swipercarousel-panel-{{ id }}">

                {% for item in particle.items %}
                <div class="g-swipercarousel-panel {% if loop.first %}selected{% endif %}" id="g-swipercarousel-panel-{{ loop.index }}">
                    <div class="g-swipercarousel-panel-link">
                        {% if item.title %}<span class="g-swipercarousel-panel-title">{{ item.title|raw }}</span>{% endif %}
                        {% if item.icon %}<i class="{{ item.icon }}"></i>{% endif %}
                    </div>
                </div>
                {% endfor %}

            </div>
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {{ parent() }}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper-panels.js'), 10, 'footer') %}
{% endblock %}
