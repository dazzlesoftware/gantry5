{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    <div class="g-slideshow-wrapper">
        <style scoped>
            #{{ id }} .g-slideshow-slider {
                height: {{ particle.height|default('80vh') }};
            }

            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    #{{ id }} .g-slideshow-slider .swiper-slide[data-swiper-slide-index="{{ loop.index0 }}"] {
                        background-position: {{ item.bg_horizontal|default('center') }} {{ item.bg_vertical|default('center') }};
                    }
                {% endfor %}
            {% endif %}

            @media only all and (max-width: {{ gantry.config.get('styles.breakpoints.tablet-container')|default('51rem') }}) {
                #{{ id }} .g-slideshow-slider {
                    height: {{ particle.heightMobile|default('665px') }} !important;
                }

                {% if not particle.source or particle.source == 'particle' %}
                    {% for item in particle.items %}
                        #{{ id }} .g-slideshow-slider .swiper-slide[data-swiper-slide-index="{{ loop.index0 }}"] {
                            background-position: {{ item.bg_horizontal_mobile|default('center') }} {{ item.bg_vertical_mobile|default('center') }};
                        }
                    {% endfor %}
                {% endif %}
            }
        </style>

        <div id="{{ id }}" class="g-slideshow swiper-container {{ particle.class|e }}" data-slideshow-id="{{ id }}" data-slideshow-effect="{{ particle.effect }}" data-slideshow-centered="{% if particle.centered == "enabled" %}true{% else %}false{% endif %}" data-slideshow-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slideshow-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-direction="{{ particle.direction }}" data-slideshow-timeout="{{ particle.autoplayTimeout }}" data-slideshow-speed="{{ particle.speed }}" data-slideshow-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" {% if gantry.page.direction == 'rtl' %} dir="rtl" {% endif %}>
            <div class="g-slideshow-slider swiper-wrapper">
                {% if not particle.source or particle.source == 'particle' %}
                    {% for item in particle.items %}
                        <div class="swiper-slide {{ item.class|e }}" style="background-image: url({{ url(item.image)|e }});">
                            <div class="slide">
                                <div class="slide-content">
                                    {% if item.main_title %}
                                        <h1 class="g-slideshow-main-title">
                                            {% if item.link %}
                                                <a href="{{ item.link }}" target="{{ item.linktarget|default('_self') }}">{{ item.main_title|raw }}</a>
                                            {% else %}
                                                {{ item.main_title|raw }}
                                            {% endif %}
                                        </h1>
                                    {% endif %}

                                    {% if item.top_title %}
                                        <h3 class="g-slideshow-top-title ">
                                            {{ item.top_title|raw }}
                                        </h3>
                                    {% endif %}

                                    {% if item.author_image and item.author_link %}
                                        <a class="g-slideshow-avatar" href="{{ item.author_link }}" target="{{ item.author_linktarget|default('_self') }}">
                                            <img src="{{ url(item.author_image)|e }}" alt="{{ item.author_text }}" title="{{ item.author_text }}">
                                        </a>
                                    {% endif %}

                                    {% if item.author_text %}
                                        <a class="g-slideshow-author button link" href="{{ item.author_link }}" target="{{ item.author_linktarget|default('_self') }}">
                                            {{ item.author_text }}
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    {% include '@particles/slideshow-' ~ gantry.platform.name ~ '.html.twig' ignore missing %}
                {% endif %}
            </div>

            {% if particle.arrows == 'enabled' %}
                {% if gantry.page.direction == 'rtl' %}
                    <div class="navigation rtl">
                        <div class="swiper-button-next">
                            <i class="fa fa-angle-left"></i>
                        </div>
                        <div class="swiper-button-prev">
                            <i class="fa fa-angle-right"></i>
                        </div>
                    </div>
                {% else %}
                    <div class="navigation">
                        <div class="swiper-button-next">
                            <i class="fa fa-angle-right"></i>
                        </div>
                        <div class="swiper-button-prev">
                            <i class="fa fa-angle-left"></i>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {#  pagination #}
            {% if particle.bullets|default('enabled') == 'enabled' %}
                <div class="swiper-pagination"></div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="gantry-theme://css/swiper.css" />
{% endblock %}

{% block javascript_footer %}
    {% do gantry.load('jquery') %}
    {% do gantry.document.addScript(url('gantry-theme://js/swiper.js'), 10, 'footer') %}
    {% do gantry.document.addScript(url('gantry-theme://js/slideshow.init.js'), 10, 'footer') %}
{% endblock %}

