{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    <div class="g-verticalslideshow-wrapper">
        <div id="{{ id }}" class="g-verticalslideshow swiper-container {{ particle.class|e }}" data-verticalslideshow-id="{{ id }}" data-verticalslideshow-effect="{{ particle.effect }}" data-verticalslideshow-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-verticalslideshow-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-verticalslideshow-timeout="{{ particle.autoplayTimeout }}" data-verticalslideshow-speed="{{ particle.speed }}" data-verticalslideshow-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %}>
            <div class="g-verticalslideshow-slider swiper-wrapper" style="height: {{ particle.height|default('750px') }};">
                {% if not particle.source or particle.source == 'particle' %}

                    {% for item in particle.items %}
                        <div class="swiper-slide {{ item.class|e }}" style="background-image: url({{ url(item.image)|e }}); background-position: center center;">
                            <div class="slide">
                                <div class="slide-content">
                                    {% if item.title %}
                                        <h1 class="g-verticalslideshow-main-title">
                                            {{ item.title|raw }}
                                        </h1>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                {% else %}
                    {% include '@particles/verticalslideshow-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
                {% endif %}
            </div>

            {% if particle.arrows == 'enabled' %}
                <div class="swiper-nav">
                    <div class="vswiper-button-prev"><i class="fa fa-angle-up" aria-hidden="true"></i></div>
                    <div class="vswiper-button-next"><i class="fa fa-angle-down" aria-hidden="true"></i></div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="gantry-theme://css/swiper.css" />
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 10, 'footer') %}
    {% do genesis.document.addScript(url('gantry-theme://js/verticalslideshow.init.js'), 10, 'footer') %}
{% endblock %}
