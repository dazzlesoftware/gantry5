{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% block genesis %}
    <div class="row overview-header">
        <div class="col-12 col-md-6">
            <h2 class="theme-title">
                {% if genesis.theme.icon %}<i class="fa fa-{{ genesis.theme.icon }}"></i>{% endif %} {{ genesis.theme.title }}
            </h2>
            <span class="theme-version">v{{ genesis.theme.version }}</span>
            <div>By <a href="{{ genesis.theme.author.link }}">{{ genesis.theme.author.name }}</a></div>
        </div>
        <div class="col-12 col-md-6">
            <span class="float-right">
                <button class="button button-back-to-conf"><i class="fa fa-fw fa-arrow-left"></i> <span>Back to Setup</span></button>
                <a href="{{ genesis.theme.support.link }}" class="button button-primary"><i class="fa fa-support"></i> <span>Support</span></a>
                <a href="{{ genesis.theme.documentation.link }}" class="button button-primary"><i class="fa fa-book"></i> <span>Documentation</span></a>
            </span>
        </div>
    </div>

    <div class="row overview-details">
        <div class="col-12 col-md-4">
             <img src="{{ url(info.thumbnail) }}" class="preview-image" alt="">
        </div>

        <div class="col-12 col-md-8">
            <p>Lucida is a beautiful mobile-first design featuring incredible typography, color, and imagery. Dozens of particles make creating a stunning website that caters to your content easy. Your website will look perfect on mobile and desktop.</p>
            <ul class="overview-list">
                <li><i class="fa fa-asterisk"></i>Slideshow & Vertical Slideshow Particles</li>
                <li><i class="fa fa-asterisk"></i>Responsive Template</li>
                <li><i class="fa fa-asterisk"></i>Genesis Framework</li>
            </ul>
        </div>
    </div>

    {% include '@genesis-admin/partials/genesis-details.html.twig' %}
{% endblock %}
