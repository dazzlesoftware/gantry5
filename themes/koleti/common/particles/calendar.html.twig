{% extends '@nucleus/partials/particle.html.twig' %}

{% set language = gantry.page.language %}

{% block particle %}
    <div class="g-calendar-particle {{ particle.class|e }}">
        <div class="g-calendar-title-wrapper">
            {% if particle.title %}
                <h2 class="g-title nomarginall g-calendar-title">{{ particle.title|raw }}</h2>
            {% endif %}
            <div class="g-calendar-datepicker-wrapper" data-toggle="datepicker">
                <div class="g-calendar-datepicker form-control docs-date"></div>
                <span class="g-calendar-datepicker-icon">
                    <i class="fa fa-fw fa-angle-down"></i>
                </span>
            </div>
        </div>

        <div class="controls">
            <div class="prev-push">
                <i class="fa fa-fw fa-angle-left"></i>
            </div>
            <div class="next-push">
                <i class="fa fa-fw fa-angle-right"></i>
            </div>
        </div>
        <div id="g-{{ id }}" class="g-calendar">
</div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do gantry.document.addScript(url('gantry-assets://js/calendar.js'), 11, 'footer') %}
    <script>
        GantryCalendar.create(document.getElementById('g-{{ id }}'), {
            locale: '{{ language|e("js") }}',
            eventsHeader: '{{ particle.eventsheader|default("Events")|e("js") }}',
            events: [
                {% for event in particle.events %}
                {
                    id: 'g-{{ id }}-event-{{ loop.index }}',
                    startDate: '{{ event.begin|e("js") }}',
                    endDate: '{{ event.end|e("js") }}',
                    title: '{{ event.title|e("js") }}',
                    url: '{{ event.link|e("js") }}',
                    target: '{{ event.target|default("_blank")|e("js") }}',
                    desc: '{{ event.description|e("js") }}'
                }{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ]
        });
    </script>
{% endblock %}
