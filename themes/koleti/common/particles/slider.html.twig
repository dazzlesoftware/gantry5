{% extends '@nucleus/partials/particle.html.twig' %}

{% do genesis.load('lightcase.init') %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}

    <div id="{{ id }}" class="g-slider section-vertical-paddings{{ particle.class|e }}" data-slider-id="{{ id }}" data-slider-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slider-timeout="{{ particle.autoplayTimeout }}" data-slider-speed="{{ particle.speed }}" data-slider-dots="{% if particle.dots == "enabled" %}true{% else %}false{% endif %}" data-slider-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}">

        <div class="section-horizontal-paddings g-slider-top">
            <div class="title-wrapper">
                <h3 class="title">{{ particle.title }}</h3>
                <h5 class="subtitle">{{particle.description}}</h5>
            </div>
            <div class="custom-swiper-navigation"></div>
        </div>

        <div class="g-slider-carousel g-swipercarousel swiper" data-slider-carousel-id="{{ id }}" data-slider-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}"
        data-g-swiper
        data-slides-per-view="4"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
            {% if not particle.source or particle.source == 'particle' %}
                {% for item in particle.items %}
                    {% set height = particle.height|default('600')|number_format %}
                        <div class="g-slider-carousel-image-container" style="background-image: url({{ url(item.image)|e }}); min-height:{{ height }}px;">

                        {% if item.link %}
                            <a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %}target="{{ item.linktarget|default('_blank') }}"{% else %}data-rel="lightcase"{% endif %}>
                        {% endif %}
                            <div class="g-slider-carousel-content-wrapper" style="top: {{height - 150}}px;">
                            {% if item.title %}

                                <h3 class="g-slider-carousel-title">
                                  <i class="{{item.icon}} slider-icon" aria-hidden="true"></i>

                                    <span>{{ item.title|raw }}</span>


                                </h3>

                            {% endif %}
                            {% if item.description %}
                                <p class="g-slider-carousel-description">{{ item.description|raw }}</p>
                            {% endif %}

                            </div>
                            {% if item.link %}
                                </a>
                            {% endif %}
                        </div>

                {% endfor %}
            {% else %}
                {% include '@particles/slider-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
