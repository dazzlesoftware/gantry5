{% extends '@nucleus/partials/particle.html.twig' %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('genesis-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}
    {% if particle.demo == "enabled" %}
        {% if genesis.theme.preset %}
            {% set preset = genesis.theme.preset | replace({'preset': ''}) %}
        {% else %}
            {% set preset = 1 %}
        {% endif %}
    {% endif %}

    <div id="{{ id }}" class="g-slider {{ particle.class|e }}" data-slider-id="{{ id }}" data-slider-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slider-timeout="{{ particle.timeout }}" data-slider-dots="{% if particle.dots == "enabled" %}true{% else %}false{% endif %}" data-slider-items="{{ particle.amount }}" data-slider-itemstablet="{{ particle.tablet_amount }}" data-slider-itemsmobile="{{ particle.mobile_amount }}" data-slider-itemssmallmobile="{{ particle.smallmobile_amount }}" data-slider-rtl="{% if genesis.page.direction == 'rtl' %}true{% else %}false{% endif %}" data-slider-mobile="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-slider-tablet="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-slider-desktop="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-slider-preset="{% if particle.demo == "enabled" %}{{ preset }}{% else %}false{% endif %}">

        {% if not particle.source or particle.source == 'particle' %}
            <div class="g-slider-slides g-swipercarousel swiper" data-slider-slides-id="{{ id }}"
        data-g-swiper
        data-g-swiper-role="main"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
                {% for item in particle.items %}
                    <div class="g-slider-slides-slide">
                        <div class="g-slider-slides-content">
                            <h1>{{ item.title }}</h1>
                            <p>{{ item.description|raw }}</p>
                            {% if item.buttontext %}
                                <a target="{{ item.buttontarget|default('_self')|e }}" href="{{ item.buttonlink|e }}" title="{{ item.buttontext|e }}" class="button {{ item.buttonclass|e }}">{{ item.buttontext|e }}</a>
                            {% endif %}
                        </div>
                        <div class="g-slider-slides-image" style="background-image: url({{ url(item.image)|e }});"></div>
                    </div>
                {% endfor %}

            </div>
            {% if particle.thumbs == "enabled" %}
                <div class="g-slider-carousel g-swipercarousel swiper" data-slider-carousel-id="{{ id }}" data-slider-carousel-nav="{{ particle.nav == 'enabled' ? 'true' : 'false' }}"
        data-g-swiper
        data-g-swiper-role="navigation"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">
                    {% for item in particle.items %}
                        <div>
                            <div class="g-slider-carousel-image-container" style="background-image: url({{ url(item.image)|e }});"></div>
                            <div class="g-slider-carousel-title">{{ item.title }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% else %}
            {% include '@particles/slider-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
        {% endif %}
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
