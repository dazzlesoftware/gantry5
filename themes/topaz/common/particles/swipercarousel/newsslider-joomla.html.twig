{% extends '@particles/swipercarousel.html.twig' %}

{# Load Content From Joomla #}
{% set category_options = particle.jcategories ? {id: [particle.jcategories|split(','), 0]} : {} %}
{% set categories_finder = joomla.finder('category', category_options).published(1).language().find() %}
{% set article_finder = joomla.finder('content').category(categories_finder).published(1).language() %}
{% set items = article_finder.order('publish_up', 'ASC').limit(particle.jarticles|default('1')).start(0).find() %}

{# Categories Names #}
{% set categories_names %}
    {%- for category in categories_finder -%}
        {{- category.title -}}
        {% if not loop.last %}{{ ', ' }}{% endif %}
    {%- endfor -%}
{% endset %}

{# NewsSlider Layout #}
{% block layout %}
    {% if particle.title %}<h3 class="g-title">{{ particle.title|raw }}</h3>{% endif %}
    <div class="{{ particle.class|e }} g-swipercarousel-layout-{{ particle.layout|e }} g-swipercarousel-{{ particle.displayitems }}-items">
        <div class="g-swipercarousel-panel-container" id="g-swipercarousel-panel-{{ id }}">

            {% for item in items %}
                <div class="g-swipercarousel-panel {% if loop.first %}selected{% endif %}" id="g-swipercarousel-panel-{{ loop.index }}">
                    <div class="g-swipercarousel-panel-inner">
                        {% if particle.jtitle == 'enabled' and item.title %}<span class="g-swipercarousel-panel-title">{{ item.title|raw }}</span>{% endif %}
                    </div>
                </div>
            {% endfor %}

        </div>
        <div id="g-swipercarousel-{{ id }}" class="g-swipercarousel swiper {{ particle.width|e }}"
        data-g-swiper
        data-slides-per-view="1"
        data-navigation="{{ particle.nav|default('disabled')|e }}"
        data-pagination="{{ particle.dots|default('disabled')|e }}"
        data-loop="{{ particle.loop|default('disabled')|e }}"
        data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
        data-autoplay-delay="{{ particle.autoplaySpeed|default(particle.autoplayTimeout|default(5000))|e }}"
        data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
        data-speed="{{ particle.scrollspeed|default(particle.transitionSpeed|default(particle.speed|default(500)))|e }}"
        data-effect="{{ (particle.animateIn or particle.animateOut) ? 'fade' : 'slide' }}"
        data-centered="{{ particle.center|default('disabled')|e }}">

            {% for item in items %}
                <div class="item">
                    {% if particle.jcategoriesnames == 'enabled' and categories_names %}<h3 class="g-title">{{ categories_names|e }}</h3>{% endif %}
                    {% if particle.jtitle == 'enabled' and item.title %}<h3 class="g-item-title">{{ item.title|raw }}</h3>{% endif %}
                    {% if particle.jauthor == 'enabled' and item.author.name %}
                        <div class="g-swipercarousel-author">
                            <span class="author-name">{{ item.author.name|e }}</span>
                        </div>
                    {% endif %}
                    <div class="g-swipercarousel-content">
                        {% if particle.jintroimage == 'enabled' and item.images.image_intro %}<img src="{{ url(item.images.image_intro)|e }}" alt="{{ item.title|e }}" />{% endif %}
                        {% if particle.jintrotext == 'enabled' and item.introtext %}{{ item.introtext|raw }}{% endif %}
                        {% if particle.jlink == 'enabled' and item.route %}
                            <a target="_self" class="g-swipercarousel-item-button button" href="{{ item.route|e }}">
                                {{ particle.jlinktext|raw }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}

        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {{ parent() }}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
    {% do gantry.document.addScript(url('gantry-assets://js/swiper-panels.js'), 10, 'footer') %}
{% endblock %}
