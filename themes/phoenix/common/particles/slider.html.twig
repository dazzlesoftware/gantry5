{% extends '@nucleus/partials/particle.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="genesis-theme://css/swiper.min.css"/>

<style>
    @media only all and (max-width: {{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}) {
        #{{ id }} .g-slider-carousel {
            height: {{ particle.heightMobile|default('500px') }} !important;
        }
    }
</style>
{% endblock %}

{% do genesis.load('lightcase.init') %}
{% block particle %}

{% set swiper_slides %}
data-swiper-mobileslides="{{ particle.mobileslides|default('2') }}" data-swiper-mobilegroup="{{ particle.mobilegroup|default('1') }}" data-swiper-mobilespace="{{ particle.mobilespace|default('35') }}" data-swiper-tabletslides="{{ particle.tabletslides|default('3') }}" data-swiper-tabletgroup="{{ particle.tabletgroup|default('1') }}" data-swiper-tabletspace="{{ particle.tabletspace|default('35') }}" data-swiper-desktopslides="{{ particle.desktopslides|default('4') }}" data-swiper-desktopgroup="{{ particle.desktopgroup|default('1') }}" data-swiper-desktopspace="{{ particle.desktopspace|default('35') }}" data-swiper-largedesktopslides="{{ particle.largedesktopslides|default('4') }}" data-swiper-largedesktopgroup="{{ particle.largedesktopgroup|default('1') }}" data-swiper-largedesktopspace="{{ particle.largedesktopspace|default('35') }}"
{% endset %}

{% set swiper_breakpoints %}
data-swiper-mobile-breakpoint="{{ genesis.config.get('styles.breakpoints.large-mobile-container')|default('30rem') }}" data-swiper-tablet-breakpoint="{{ genesis.config.get('styles.breakpoints.tablet-container')|default('51rem') }}" data-swiper-desktop-breakpoint="{{ genesis.config.get('styles.breakpoints.desktop-container')|default('76rem') }}" data-swiper-largedesktop-breakpoint="{{ genesis.config.get('styles.breakpoints.large-desktop-container')|default('88rem') }}"
{% endset %}

	<div id="{{ id }}" class="g-slider swiper-container {{ particle.class|e }}" data-slider-id="{{ id }}" data-slider-effect="{{ particle.effect }}" data-slider-autoplay="{% if particle.autoplay == "enabled" %}true{% else %}false{% endif %}" data-slider-loop="{% if particle.loop == "enabled" %}true{% else %}false{% endif %}" data-slider-timeout="{{ particle.autoplayTimeout }}" data-slider-speed="{{ particle.speed }}" data-slider-touchmove="{% if particle.touchmove == "enabled" %}true{% else %}false{% endif %}" data-slider-centered="{% if particle.centered == "enabled" %}true{% else %}false{% endif %}" {% if genesis.page.direction == 'rtl' %} dir="rtl" {% endif %} {{ swiper_slides }} {{ swiper_breakpoints }}>

		<div class="g-slider-carousel swiper-wrapper" style="height: {{ particle.height|default('60vh') }};">
			{% if not particle.source or particle.source == 'particle' %}
				{% for item in particle.items %}
					<div class="swiper-slide" style="background-image: url({{ url(item.image)|e }});">
						<div class="g-slider-overlay"></div>
						{% if particle.pattern == 'enabled' %}
							<div class="g-slider-pattern">
								<svg width="449" height="203" viewbox="0 0 449 203" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M279 29L849 0V24L279 53V29Z" class="base-pattern-2"/>
									<path d="M0 134L270 120V136L0 150V134Z" class="base-pattern-1"/>
									<path d="M379 194.5L549 186V194L379 202.5V194.5Z" class="base-pattern-3"/>
								</svg>
							</div>
						{% endif %}
						<div class="slide">

							<div class="g-slider-carousel-content-wrapper">
								{% if item.title %}
									<h3 class="g-slider-carousel-title">
										{% if item.link %}
											<a href="{{ url(item.link)|e }}" {% if item.linktarget is not same as('modal') %} target="{{ item.linktarget|default('_blank') }}" {% else %} data-rel="lightcase" {% endif %}>
											{% endif %}
											<span>{{ item.title|raw }}</span>
											{% if item.link %}
											</a>
										{% endif %}
									</h3>
								{% endif %}
								{% if item.description %}
									<p class="g-slider-carousel-description">
										{{ item.description|raw }}
									</p>
								{% endif %}
							</div>

						</div>
					</div>
				{% endfor %}
			{% else %}
				{% include '@particles/slider-' ~ genesis.platform.name ~ '.html.twig' ignore missing %}
			{% endif %}
		</div>

		<!-- navigation -->
		{% if particle.nav == 'enabled' %}
			{% if genesis.page.direction == 'rtl' %}
				<div class="navigation rtl">
					<div class="slider-button-next">
						<i class="fa fa-angle-left"></i>
					</div>
					<div class="slider-button-prev">
						<i class="fa fa-angle-right"></i>
					</div>
				</div>
			{% else %}
				<div class="navigation">
					<div class="slider-button-next">
						<i class="fa fa-angle-right"></i>
					</div>
					<div class="slider-button-prev">
						<i class="fa fa-angle-left"></i>
					</div>
				</div>
			{% endif %}
		{% endif %}
	</div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('genesis-theme://js/length.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('genesis-theme://js/swiper.min.js'), 10, 'footer') %}
	{% do genesis.document.addScript(url('genesis-theme://js/slider.init.js'), 10, 'footer') %}
{% endblock %}
