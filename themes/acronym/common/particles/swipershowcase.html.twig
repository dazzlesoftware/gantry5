{% extends '@nucleus/partials/particle.html.twig' %}

{% do genesis.load('lightcase.init') %}

{% block particle %}
    {% styles %}
        <link rel="stylesheet" href="{{ url('gantry-assets://css/swiper.css') }}" type="text/css" />
    {% endstyles %}

    {% set navigationValue = particle.nav|default('enabled') ~ '' %}
    {% set paginationValue = particle.dots|default('enabled') ~ '' %}
    {% set navigationEnabled = navigationValue in ['enable', 'enabled', 'true', '1'] %}
    {% set paginationEnabled = paginationValue in ['enable', 'enabled', 'true', '1'] %}
    {% set fadeEnabled = particle.animateIn or particle.animateOut %}
    {% set initialSlide = 0 %}
    {% if particle.presets|default('disabled') == 'enabled' %}
        {% set preset = genesis.theme.preset|replace({'preset': ''}) %}
        {% set initialSlide = preset in ['1', '2', '3', '4', '5', '6'] ? ((preset * 1) - 1) * 3 : 0 %}
    {% endif %}

    <div class="{{ particle.class|e }} g-swipershowcase g-swipershowcase-{{ particle.displayitems|default(1)|e }}-items">
        {% if particle.title %}<h3 class="g-title">{{ particle.title|raw }}</h3>{% endif %}
        {% if particle.description %}<div class="g-swipercarousel-description">{{ particle.description|raw }}</div>{% endif %}

        <div id="g-swipercarousel-{{ id }}"
             class="g-swipercarousel swiper g-swipercarousel-fullwidth"
             data-g-swiper
             data-slides-per-view="{{ particle.displayitems|default(1)|e }}"
             data-navigation="{{ particle.nav|default('enabled')|e }}"
             data-pagination="{{ particle.dots|default('enabled')|e }}"
             data-loop="{{ particle.loop|default('enabled')|e }}"
             data-autoplay="{{ particle.autoplay|default('disabled')|e }}"
             data-autoplay-delay="{{ particle.autoplaySpeed|default('5000')|e }}"
             data-pause-on-hover="{{ particle.pauseOnHover|default('enabled')|e }}"
             data-speed="500"
             data-initial-slide="{{ initialSlide|e }}"
             data-effect="{{ fadeEnabled ? 'fade' : 'slide' }}">

            {% if particle.source == 'joomla' %}
                {% set category_options = particle.joomla.categories ? {id: [particle.joomla.categories|split(','), 0]} : {} %}
                {% set categories_finder = joomla.finder('category', category_options).published(1).language().find() %}
                {% set article_finder = joomla.finder('content').category(categories_finder).published(1).featured(false).language() %}
                {% set items = article_finder.order('publish_up', 'ASC').limit(particle.joomla.articles|default('1')).start(0).find() %}

                {% for item in items %}
                    {% set itemLink = particle.joomla.link == 'enabled' and item.route ? item.route : null %}
                    {% set lightcaseLink = not itemLink and item.images.image_intro ? url(item.images.image_intro) : null %}
                    <div class="g-swipershowcase-item">
                        {% if itemLink %}
                            <a href="{{ itemLink|e }}" class="g-showcase-image-link">
                        {% elseif lightcaseLink %}
                            <a href="{{ lightcaseLink|e }}" class="g-showcase-image-link" data-rel="lightcase" title="{{ item.title|e }}">
                        {% else %}
                            <div class="g-showcase-image-link">
                        {% endif %}

                        <div class="showcase-image">
                            {% if particle.joomla.introimage == 'enabled' and item.images.image_intro %}
                                <img src="{{ url(item.images.image_intro)|e }}"
                                     alt="{{ item.title|e }}"
                                     {% if particle.lazyload|default('enabled') == 'enabled' %}loading="lazy"{% endif %} />
                            {% endif %}
                            <div class="item-overlay">
                                {% if particle.joomla.title == 'enabled' and item.title %}<div class="item-overlay-title">{{ item.title|e }}</div>{% endif %}
                                {% if particle.joomla.introtext == 'enabled' and item.introtext %}<div class="item-overlay-desc">{{ item.introtext|raw }}</div>{% endif %}
                            </div>
                        </div>

                        {% if itemLink or lightcaseLink %}</a>{% else %}</div>{% endif %}
                    </div>
                {% endfor %}
            {% else %}
                {% for item in particle.items|default([]) %}
                    {% set itemLink = item.link ? url(item.link) : null %}
                    {% set lightcaseLink = not itemLink and item.image ? url(item.image) : null %}
                    <div class="g-swipershowcase-item">
                        {% if itemLink %}
                            <a href="{{ itemLink|e }}" class="g-showcase-image-link">
                        {% elseif lightcaseLink %}
                            <a href="{{ lightcaseLink|e }}" class="g-showcase-image-link" data-rel="lightcase" title="{{ item.title|e }} {{ item.desc|e }}">
                        {% else %}
                            <div class="g-showcase-image-link">
                        {% endif %}

                        <div class="showcase-image">
                            {% if item.image %}
                                <img src="{{ url(item.image)|e }}"
                                     alt="{{ item.title|e }}"
                                     {% if particle.lazyload|default('enabled') == 'enabled' %}loading="lazy"{% endif %} />
                            {% endif %}
                            <div class="item-overlay">
                                {% if item.icon %}<i class="{{ item.icon|e }}" aria-hidden="true"></i>{% endif %}
                                {% if item.title %}<div class="item-overlay-title">{{ item.title|e }}</div>{% endif %}
                                {% if item.desc %}<div class="item-overlay-desc">{{ item.desc|e }}</div>{% endif %}
                            </div>
                        </div>

                        {% if itemLink or lightcaseLink %}</a>{% else %}</div>{% endif %}
                    </div>
                {% endfor %}
            {% endif %}

            {% if navigationEnabled %}
                <div class="swiper-navigation">
                    <button class="swiper-button-prev" type="button" aria-label="Previous slide"><i class="fa fa-chevron-left" aria-hidden="true"></i></button>
                    <button class="swiper-button-next" type="button" aria-label="Next slide"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>
                </div>
            {% endif %}
            {% if paginationEnabled %}<div class="swiper-pagination"></div>{% endif %}
        </div>
    </div>
{% endblock %}

{% block javascript_footer %}
    {% do genesis.document.addScript(url('gantry-assets://js/swiper.js'), 11, 'footer') %}
{% endblock %}
