{
    "name": "dazzlesoftware/genesis-grav",
    "type": "grav-plugin",
    "description": "Genesis Framework for Grav",
    "keywords": ["genesis"],
    "license": "MIT",

    "require": {
        "php": ">=8.3.0",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "dazzlesoftware/toolbox": "^1.0",
        "scssphp/scssphp": "^2.1.0"
    },
    "autoload": {
        "psr-4": {
            "Genesis\\": "src/classes/Genesis"
        },
        "classmap":  [
            "genesis.php",
            "Debugger.php",
            "src/Loader.php"
        ]
    },
    "repositories": [
    ],
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
