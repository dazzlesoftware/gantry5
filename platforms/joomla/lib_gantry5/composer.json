        "ext-xml": "*",
        "ext-simplexml": "*",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/yaml": "^6.4|^7.0",
        "pimple/pimple": "^3.6",
        "filp/whoops": "^2.15.2",
        "dazzlesoftware/toolbox": "^1.0",
