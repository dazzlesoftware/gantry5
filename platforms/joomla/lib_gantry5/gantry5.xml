<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension version="3.9" type="library" method="upgrade">
    <name>Gantry 5 Framework</name>
    <libraryname>gantry5</libraryname>
    <version>@version@</version>
    <creationDate>@versiondate@</creationDate>
    <author>Dazzle Software, LLC</author>
    <authorEmail>support@dazzlesoftware.org</authorEmail>
    <authorUrl>https://dazzlesoftware.org</authorUrl>
    <copyright>Copyright (C) 2026 Dazzle Software, LLC</copyright>
    <license>https://www.gnu.org/licenses/gpl-3.0.html GNU/GPL</license>
    <description>LIB_GANTRY5_DESCRIPTION</description>

    <files>
        <filename>composer.json</filename>
        <filename>composer.lock</filename>
        <filename>MD5SUMS</filename>
        <folder>compat</folder>
        <folder>src</folder>
        <folder>language</folder>
        <folder>vendor</folder>
    </files>

    <media folder="assets" destination="gantry5/assets">
        <folder>css</folder>
        <folder>fonts</folder>
        <folder>images</folder>
        <folder>js</folder>
        <folder>webfonts</folder>
    </media>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.lib_gantry5.sys.ini</language>
    </languages>
</extension>
