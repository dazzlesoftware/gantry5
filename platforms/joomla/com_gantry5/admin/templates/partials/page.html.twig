{% assets with { priority: 10 } %}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ url('gantry-admin://assets/css-compiled/joomla-g-admin.css')|e }}" type="text/css" />
    {% endblock %}

    {% block javascript %}
        <script>
            var GENESIS_AJAX_SUFFIX = '{{ genesis.ajax_suffix|raw }}';
            var GENESIS_AJAX_URL = '{{ genesis.route('%ajax%')|e }}';
            var GENESIS_AJAX_CONF_URL = '{{ genesis.route('configurations/%ajax%')|e }}';
            var GENESIS_AJAX_NONCE = null;
            var GENESIS_PLATFORM = 'joomla';
            var GANTRY_AJAX_SUFFIX = GENESIS_AJAX_SUFFIX, GANTRY_AJAX_URL = GENESIS_AJAX_URL,
                GANTRY_AJAX_CONF_URL = GENESIS_AJAX_CONF_URL, GANTRY_AJAX_NONCE = GENESIS_AJAX_NONCE,
                GANTRY_PLATFORM = GENESIS_PLATFORM;
        </script>
        <script type="text/javascript" src="{{ url('gantry-admin://js/dark-mode.js')|e }}"></script>
    {% endblock %}
{% endassets -%}

<div id="g5-container" data-genesis-container="">
    {% block content %}
    {% endblock %}

    {% block footer_section %}
    {% endblock %}
</div>

{% do genesis.platform.finalize() %}
