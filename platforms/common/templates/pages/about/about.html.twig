{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% block genesis %}
    <div class="row overview-header">
        <div class="col-12 col-md-6">
            <h2 class="theme-title">
                {% if genesis.theme.icon %}<i class="fa fa-{{ genesis.theme.icon }}" aria-hidden="true"></i>{% endif %} {{ genesis.theme.title }}
            </h2>
            <span class="theme-version">v{{ genesis.theme.version }}</span>
            <div>{{ 'GENESIS_PLATFORM_BY'|trans }} <a href="{{ genesis.theme.author.link }}" aria-label="Template Author's Website" tabindex="1">{{ genesis.theme.author.name }}</a></div>
        </div>
        <div class="col-12 col-md-6">
            <span class="float-right">
                <button class="button button-back-to-conf"><i class="fa fa-fw fa-arrow-left" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_BACK_SETUP'|trans }}</span></button>
                <a href="{{ genesis.theme.support.link }}" class="button button-primary"><i class="fa fa-support" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_SUPPORT'|trans }}</span></a>
                <a href="{{ genesis.theme.documentation.link }}" class="button button-primary"><i class="fa fa-book" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_DOCUMENTATION'|trans }}</span></a>
            </span>
        </div>
    </div>

    <div class="row overview-details">
        <div class="col-12 col-md-4">
             <img src="{{ url(info.thumbnail) }}" class="preview-image" alt="">
        </div>

        <div class="col-12 col-md-8">
            <p>Neon is the default theme for the Genesis framework. It features a lightweight design and basic configuration settings to help get acquainted with Genesis's many features and options.</p>
            <ul class="overview-list">
                <li><i class="fa fa-asterisk" aria-hidden="true"></i>Clean, minimalistic design</li>
                <li><i class="fa fa-asterisk" aria-hidden="true"></i>Fast and lightweight</li>
                <li><i class="fa fa-asterisk" aria-hidden="true"></i>Includes preset styles and outlines</li>
            </ul>
        </div>
    </div>

    {% include '@genesis-admin/partials/genesis-details.html.twig' %}
{% endblock %}
