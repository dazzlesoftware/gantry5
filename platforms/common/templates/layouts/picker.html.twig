<h1>{{ 'GANTRY5_PLATFORM_LAYOUT_PRESETS'|trans }}</h1>
<ul>
    {% for name,layout in presets.layouts %}
        <li>
            <a data-genesis-lm-picker=""
               data-genesis-ajaxify=""
               data-genesis-ajaxify-target="[data-genesis-content]"
               data-genesis-ajaxify-href="{{ genesis.route('configurations', 'FIXME', 'layout/create', name) }}"
            >
                {{ layout.name }}
            </a>
        </li>
    {% endfor %}
</ul>
