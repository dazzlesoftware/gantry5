{% extends "@genesis-admin/partials/page.html.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ url('genesis-admin://assets/css-compiled/g-admin.css') }}" type="text/css" />
    {% if genesis.config.page.lucide.enable|default(1) %}<link rel="stylesheet" href="{{ url('genesis-admin://assets/css/lucide-icons.css') }}" type="text/css" />{% endif %}
    {% if genesis.config.page.tabler.enable|default(1) %}
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/tabler-icons.css') }}" type="text/css" />
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/tabler-icons-filled.css') }}" type="text/css" />
    {% endif %}
    {% set faVersion = genesis.config.page.fontawesome.version ?? genesis.config.page.fontawesome.default_version ?? 'fa7css' %}
    {% set faVersion = faVersion == 'fa4' ? 'fa7css' : faVersion %}
    {% if faVersion == 'fa5css' or faVersion == 'fa5js' %}
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome5-all.min.css') }}" type="text/css" />
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome5-shim.min.css') }}" type="text/css" />
    {% elseif faVersion == 'fa6css' or faVersion == 'fa6js' %}
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome6-all.min.css') }}" type="text/css" />
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome6-shim.min.css') }}" type="text/css" />
    {% elseif faVersion == 'fa7css' or faVersion == 'fa7js' %}
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome7-all.min.css') }}" type="text/css" />
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome7-shim.min.css') }}" type="text/css" />
    {% else %}
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome7-all.min.css') }}" type="text/css" />
        <link rel="stylesheet" href="{{ url('genesis-admin://assets/css/font-awesome7-shim.min.css') }}" type="text/css" />
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block javascript %}
    <script type="text/javascript" async="async" src="{{ url('genesis-admin://assets/js/main.js') }}"></script>
    {% include "@genesis-admin/partials/js-translations.html.twig" %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <div id="main-header" data-mode-indicator="production">
        {% include "@genesis-admin/partials/php_unsupported.html.twig" %}
        {% include "@genesis-admin/partials/header.html.twig" %}
    </div>
    <div class="inner-container">
        {% include "@genesis-admin/partials/updates.html.twig" %}
        {% block genesis_content_wrapper %}
            <div data-genesis-content-wrapper="">
                {% include "@genesis-admin/partials/navigation.html.twig" %}
                <div class="row">
                    <div class="col main-block">
                        <section id="g-main">
                            <div class="genesis-content" data-genesis-content="">
                                {% block genesis %}
                                {% endblock %}
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}

{% block footer_section %}
    <footer id="footer">
        <div>
            {{ 'GENESIS_PLATFORM_FOOTER'|trans|raw }}
        </div>
        {% set version = constant('GENESIS_VERSION') %}
        {% set version_date = constant('GENESIS_VERSION_DATE') %}
        <div>
            {{ 'GENESIS_PLATFORM_FOOTER_VERSION'|trans }} <span class="g-version">{{ version }}</span>
            /
            {{ 'GENESIS_PLATFORM_FOOTER_RELEASED'|trans }} <span class="g-version-date">{{ version_date}}</span>
        </div>
        <div><a href="#" data-changelog="{{ constant('GENESIS_VERSION') }}">{{ 'GENESIS_PLATFORM_CHANGELOG'|trans }}</a></div>
    </footer>
{% endblock %}
