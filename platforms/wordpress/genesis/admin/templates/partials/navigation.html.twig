<div class="g-grid">
    <div class="g-block navbar-block">
        <nav id="genesis">
            {% set style = location in ['menu', 'about', 'configurations']  ? ' style="overflow: hidden; height: 0; visibility: hidden;"' : '' %}
            <section id="navbar"{{ style|raw }}>
                <ul>
                    {% include 'partials/configuration-selector.html.twig' %}
                    <li {{ (location == 'configurations/layout') ? 'class="active"' }}>
                        <a data-genesis-ajaxify=""
                           data-genesis-nav="layout"
                           data-genesis-nav-url="{{ genesis.route('configurations', configuration, 'layout') }}"
                           data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                           data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                           href="{{ genesis.route('configurations', configuration, 'layout') }}"
                        >
                            <i class="fa fa-fw fa-columns" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_LAYOUT'|trans }}</span>
                        </a>
                    </li>
                    <li {{ (location == 'configurations/styles') ? 'class="active"' }}>
                        <a data-genesis-ajaxify=""
                           data-genesis-nav="styles"
                           data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                           data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                           href="{{ genesis.route('configurations', configuration, 'styles') }}"
                        >
                            <i class="fa fa-fw fa-adjust" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_STYLES'|trans }}</span>
                        </a>
                    </li>
                    <li {{ (location == 'configurations/content') ? 'class="active"' }}>
                        <a data-genesis-ajaxify=""
                           data-genesis-nav="content"
                           data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                           data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                           href="{{ genesis.route('configurations', configuration, 'content') }}"
                        >
                            <i class="far fa-fw fa-file-alt" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_CONTENT'|trans }}</span>
                        </a>
                    </li>
                    <li {{ (location == 'configurations/page') ? 'class="active"' }}>
                        <a data-genesis-ajaxify=""
                           data-genesis-nav="page"
                           data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                           data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                           href="{{ genesis.route('configurations', configuration, 'page') }}"
                        >
                            <i class="fa fa-fw fa-list-alt" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_PAGESETTINGS'|trans }}</span>
                        </a>
                    </li>
                    {% if configuration and configuration != 'default' and not (configuration starts with '_') %}
                    <li {{ (location == 'configurations/assignments') ? 'class="active"' }}>
                        <a data-genesis-ajaxify=""
                           data-genesis-nav="assignments"
                           data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                           data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                           href="{{ genesis.route('configurations', configuration, 'assignments') }}"
                        >
                            <i class="far fa-fw fa-check-square" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_ASSIGNMENTS'|trans }}</span>
                        </a>
                    </li>
                    {% endif %}
                    {% if (location == 'configurations/settings' or genesis.particles.overrides(configuration)) %}
                        <li {{ (location == 'configurations/settings') ? 'class="active"' }}>
                            <a data-genesis-ajaxify=""
                               data-genesis-nav="settings"
                               data-genesis-ajaxify-target="[data-genesis-content-wrapper]"
                               data-genesis-ajaxify-params="{{ {"navbar": true}|json_encode|e('html_attr') }}"
                               href="{{ genesis.route('configurations', configuration, 'settings') }}"
                            >
                                <i class="fa fa-fw fa-wrench" aria-hidden="true"></i><span>{{ 'GENESIS_PLATFORM_PARTICLE_DEFAULTS'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </section>
        </nav>
        <a href="{{ genesis.route('themes') }}" aria-label="Genesis themes">
            <svg id="genesis-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 148 32" role="img" aria-label="Genesis">
            <g stroke="#60717b" stroke-linecap="round" stroke-linejoin="round">
                <path fill="none" stroke-width="3.6" d="M16 9.5V16M9.5 20l6.5-4 6.5 4"/>
                <circle cx="16" cy="16" r="3"/>
                <circle cx="16" cy="6" r="4" fill="#f59e0b" stroke="none"/>
                <circle cx="7.5" cy="22" r="4" fill="#2583bd" stroke="none"/>
                <circle cx="24.5" cy="22" r="4" fill="#3f7f18" stroke="none"/>
            </g>
                <text x="37" y="22" fill="currentColor" font-family="Inter,Segoe UI,Arial,sans-serif" font-size="17" font-weight="700" letter-spacing="2.1">GENESIS</text>
            </svg>
        </a>
    </div>
</div>
