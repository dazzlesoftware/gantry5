{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% block genesis %}
{% set action = genesis.route(configuration ~ '/' ~ route|replace({'.': '/'}) ~ '/validate') %}
<form method="post" action="{{ action|e }}">
    {% if blueprints.type == 'collection.list' %}
        {% include 'forms/fields.html.twig' %}
    {% else %}
        <div class="card settings-block">
            <h4>
                {% if title %}
                    <span data-title-editable="{{ data.data[title]|trim|e }}" data-collection-key="{{ (prefix ~ title)|fieldName }}" class="title">
                        {{ data.data[title] }}
                    </span>
                    <i class="fa fa-pencil fa-pencil-alt font-small" aria-hidden="true" tabindex="0" aria-label="{{ 'GENESIS_PLATFORM_EDIT_TITLE'|trans(data.data[title]|trim) }}" data-title-edit=""></i>
                {% else %}
                Edit
                {% endif %}
            </h4>
            <div class="inner-params">
                {% include 'forms/fields.html.twig' with {'skip': [title]} %}
            </div>
        </div>
    {% endif %}
    <div class="g-modal-actions">
        <button class="button button-primary" type="submit">{{ 'GENESIS_PLATFORM_APPLY'|trans }}</button>
        <button class="button button-primary" data-apply-and-save="">{{ 'GENESIS_PLATFORM_APPLY_SAVE'|trans }}</button>
        <button class="button genesis-dialog-close">{{ 'GENESIS_PLATFORM_CANCEL'|trans }}</button>
    </div>
</form>
{% endblock %}
