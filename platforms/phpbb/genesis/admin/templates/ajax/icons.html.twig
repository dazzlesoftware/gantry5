<div class="g-particles-header icons-header settings-block">
    <div class="particle-search-wrapper">
        <input type="text" placeholder="{{ 'GENESIS_PLATFORM_SEARCH_ELI'|trans }}"/>
        <span class="particle-search-total">{{ total }}</span>
    </div>
    <div class="icon-filter-wrapper">
        <label>
            <span>Library</span>
            <select data-g-icon-library>
                <option value="">All libraries</option>
                {% for key,label in libraries %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
            </select>
        </label>
        <label>
            <span>Style</span>
            <select data-g-icon-style>
                <option value="">All styles</option>
                {% for key,label in styles %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
            </select>
        </label>
    </div>
    {% if libraries['font-awesome'] is defined %}<div class="icon-option-wrapper" data-g-icon-modifiers="font-awesome">
        {% for type,option in options %}
            {% if option is iterable %}
                <select name="type">
                {% for key,value in option %}
                    <option value="fa-{{ key }}">{{ value }}</option>
                {% endfor %}
                </select>
            {% else %}
                <label><input type="checkbox" name="fa-{{ type }}" value="fa-{{ type }}"/> {{ option }}</label>
            {% endif %}
        {% endfor %}
    </div>{% endif %}
</div>

<div class="g-particles-main icons-wrapper">
    <ul>
        {% for icon in icons %}
            <li data-g-icon="{{ icon.value }}" data-g-icon-library="{{ icon.library }}" data-g-icon-style="{{ icon.style }}"><i class="{{ icon.value }}" aria-hidden="true"></i> <span>{{ icon.value }}</span></li>
        {% endfor %}
    </ul>
</div>

{% set faVersion = (genesis.config.page.fontawesome.version ?? genesis.config.page.fontawesome.default_version ?? 'fa7css')|replace({'fa4': 'fa7css'})|substr(0, 3)|upper %}

<div class="alert alert-info">Displaying {{ libraries|join(', ') }} icons. Use the Library and Style filters to narrow the list.</div>

<div class="g-particles-footer settings-block clearfix">
    <div class="float-left g-icon-preview"></div>
    <div class="float-right">
        <button href="#" class="button button-primary" data-g-select="">{{ 'GENESIS_PLATFORM_SELECT'|trans }}</button>
        <button href="#" class="button genesis-dialog-close">{{ 'GENESIS_PLATFORM_CANCEL'|trans }}</button>
    </div>
</div>
