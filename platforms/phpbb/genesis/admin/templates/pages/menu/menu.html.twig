{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% set visible = not error and genesis.authorize('menu.manage', id) %}
{% set authorized = visible and genesis.authorize('menu.edit', id) %}

{% block genesis %}
<form method="post" action="{{ genesis.route('menu', id) }}" data-mm-container="">
    <div class="menu-header">
        <span class="float-right">
            <button class="button button-back-to-conf">
                <i class="fa fa-fw fa-arrow-left" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_BACK_SETUP'|trans }}</span>
            </button>
            {% if authorized %}
            <button type="submit" class="button button-primary button-save" data-save="Menu">
                <i class="fa fa-fw fa-check" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_SAVE_MENU'|trans }}</span>
            </button>
            {% endif %}
        </span>
        <h2 class="page-title">{{ 'GENESIS_PLATFORM_MENU_EDITOR'|trans }}</h2>
        {% if menus %}
        <select placeholder="{{ 'GENESIS_PLATFORM_SELECT_ELI'|trans }}"
                data-selectize-ajaxify=""
                data-selectize=""
                data-genesis-ajaxify-target="[data-genesis-content]"
                class="menu-select-wrap"
        >
            {% for menu_name,menu_title in menus %}
            <option value="{{ menu_name }}"
                    {% if id == menu_name %}selected="selected"{% endif %}
                    data-data="{{ {url: genesis.route('menu', menu_name)}|json_encode|e('html_attr') }}">
                {{ menu_title }}{{ default_menu == menu_name ? ' ★' : '' }}
            </option>
            {% endfor %}
        </select>
        {% endif %}
    </div>

    {% if error %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% elseif not authorized %}
        <div class="alert alert-danger">{{ 'GENESIS_PLATFORM_MENU_EDIT_UNAUTHORIZED'|trans }} {{ 'GENESIS_PLATFORM_MENU_EDIT_UNAUTHORIZED_PLATFORM'|trans }}</div>
    {% endif %}

    {% if authorized %}
    <div class="genesis-mm-particles-picker">
        <ul class="g-menu-addblock">
            {% if genesis.platform.has('modules') %}
            <li data-mm-blocktype="module" data-mm-id="__module">
                <span class="menu-item">
                    <i class="far fa-fw fa-hand-paper" aria-hidden="true"></i>
                    <span class="title">{{ 'GENESIS_PLATFORM_MODULE'|trans }}</span>
                </span>
                <a class="config-cog" href="{{ genesis.route('menu/select/module') }}">
                    <i aria-label="{{ 'GENESIS_PLATFORM_MENU_MODULE_SETTINGS'|trans }}" class="fa fa-cog" aria-hidden="true"></i>
                </a>
            </li>
            {% elseif genesis.platform.has('widgets') %}
            <li data-mm-blocktype="widget" data-mm-id="__widget">
                <span class="menu-item">
                    <i class="far fa-fw fa-hand-paper" aria-hidden="true"></i>
                    <span class="title">{{ 'GENESIS_PLATFORM_WIDGET'|trans }}</span>
                </span>
                <a class="config-cog" href="{{ genesis.route('menu/select/widget') }}">
                    <i aria-label="{{ 'GENESIS_PLATFORM_MENU_WIDGET_SETTINGS'|trans }}" class="fa fa-cog" aria-hidden="true"></i>
                </a>
            </li>
            {% endif %}
            <li data-mm-blocktype="particle" data-mm-id="__particle">
                <span class="menu-item">
                    <i class="far fa-fw fa-hand-paper" aria-hidden="true"></i>
                    <span class="title">{{ 'GENESIS_PLATFORM_PARTICLE'|trans }}</span>
                </span>
                <a class="config-cog" href="{{ genesis.route('menu/select/particle') }}">
                    <i aria-label="{{ 'GENESIS_PLATFORM_MENU_PARTICLE_SETTINGS'|trans }}" class="fa fa-cog" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
    </div>
    {% endif %}

    {% if visible %}
    <div id="menu-editor"
         data-menu-ordering="{{ menu.ordering|json_encode|escape('html_attr') }}"
         data-menu-items="{{ menu.items(false)|json_encode|escape('html_attr') }}"
         data-menu-settings="{{ menu.settings|json_encode|escape('html_attr') }}">
        {#- Unlike Grav/WordPress, phpBB has no page tree to seed a new menu with, so
            menu.items|length is 0 for every brand-new menu, not just a rare edge case --
            menu/empty.html.twig is a dead end (a static message, no drop target at all), so
            falling back to it here would make it permanently impossible to add the first item.
            menu/base.html.twig's <ul data-mm-base=""> is what menumanager.js actually binds
            drag/drop to -- render it unconditionally so dragging in a Particle/Module from the
            picker above always works, even while the menu is still empty. #}
        {% include 'menu/base.html.twig' with {'item': menu.root} %}
    </div>

    <div id="trash" data-mm-eraseparticle=""><div class="trash-zone">&times;</div><span>{{ 'GENESIS_PLATFORM_DROP_DELETE'|trans }}</span></div>
    {% endif %}
</form>
{% endblock %}
