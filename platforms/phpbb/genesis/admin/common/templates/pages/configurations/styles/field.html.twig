{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% block genesis %}
<form method="POST">
    <div class="pull-right">
        <button class="button">{{ 'GENESIS_PLATFORM_SAVE'|trans }}</button>
        <button class="button" name="METHOD" value="DELETE">{{ 'GENESIS_PLATFORM_RESET'|trans }}</button>
        <a class="button" data-genesis-ajaxify="" data-genesis-ajaxify-target="[data-genesis-content]" href="{{ genesis.route(parent) }}">{{ 'GENESIS_PLATFORM_BACK'|trans }}</a>
    </div>
    <div id="settings" class="cards-wrapper">
        <div class="card settings-block">
            <h4>
                {{ 'GENESIS_PLATFORM_EDIT'|trans }} {{ key }}
            </h4>
            <div class="inner-params">
                {% include 'forms/fields.html.twig' %}
            </div>
        </div>
    </div>
</form>
{% endblock %}
