{% extends ajax-suffix ? "@genesis-admin/partials/ajax.html.twig" : "@genesis-admin/partials/base.html.twig" %}

{% block genesis %}
<form method="post">
    <div class="pull-right">
        <a class="button" data-genesis-ajaxify="" data-genesis-ajaxify-target="[data-genesis-content]" href="{{ genesis.route(parent) }}"><i class="fa fa-fw fa-arrow-left" aria-hidden="true"></i> {{ 'GENESIS_PLATFORM_BACK'|trans }}</a>
        <button type="submit" class="button button-primary button-save" data-save="Styles"><i class="fa fa-fw fa-check" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_SAVE_STYLES'|trans }}</span></button>
    </div>
    <div id="settings" class="cards-wrapper">
        <div class="card settings-block">
            <h4>
                {{ block.name }}
            </h4>
            <div class="inner-params">
                {% include 'forms/fields.html.twig' with {'blueprints': block.form} %}
            </div>
        </div>
    </div>
</form>
{% endblock %}
