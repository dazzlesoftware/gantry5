{% set updates = genesis.platform.updates %}
{% if updates %}
{% set version = updates.0|split(' ')|last %}
<div class="row">
    <div class="col">
        <div class="update-header clearfix">
            <span class="update-text">{{ 'GENESIS_PLATFORM_UPDATES_AVAILABLE'|trans }}: {{ updates|join(', ') }}</span>
            <div class="update-tools">
                <a href="{{ genesis.platform.update|raw }}" class="button button-update">
                    <i class="fa fa-refresh" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_UPDATE'|trans }}</span>
                </a>
                <a href="#" data-changelog="{{ version }}" class="button button-update">
                    <i class="fa fa-book" aria-hidden="true"></i> <span>{{ 'GENESIS_PLATFORM_CHANGELOG'|trans }}</span>
                </a>
                <a href="#" class="fa fa-close" aria-hidden="true" data-g-close=".row"></a>
            </div>
        </div>
    </div>
</div>
{% endif %}
